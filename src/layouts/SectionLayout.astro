---
import BaseLayout from './BaseLayout.astro';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';

interface Props {
  title?: string;
  description?: string;
  section: Section;
  noindex?: boolean;
  ogImage?: string;
  lang?: 'ko' | 'en';
  alternateUrl?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot />
</BaseLayout>
