---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import Comments from '../components/Comments';
import SeriesTOC from '../components/SeriesTOC.astro';
import SeriesNav from '../components/SeriesNav.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import type { SeriesPost } from '../components/SeriesTOC.astro';
import type { RelatedCandidate } from '../lib/related';
import { getLocalizedPath } from '../lib/i18n';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NavPost {
  title: string;
  slug: string;
  section: Section;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  section: Section;
  category: string;
  tags?: string[];
  thumbnail?: string;
  lang?: 'ko' | 'en';
  alternateUrl?: string;
  readingTime?: number;
  headings?: Heading[];
  prevPost?: NavPost;
  nextPost?: NavPost;
  series?: string;
  seriesPosts?: SeriesPost[];
  currentSlug?: string;
  affiliate?: boolean;
  relatedPosts?: RelatedCandidate[];
}

const {
  title,
  description,
  date,
  section,
  category,
  tags = [],
  thumbnail,
  lang = 'ko',
  alternateUrl,
  readingTime,
  headings = [],
  prevPost,
  nextPost,
  series,
  seriesPosts,
  currentSlug,
  affiliate = false,
  relatedPosts = [],
} = Astro.props;

const sectionLabel: Record<Section, string> = {
  life: 'Life', money: 'Money', culture: 'Culture', tools: 'Tools', dev: 'Dev',
};

const formattedDate = date.toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const hasTOC = headings.filter(h => h.depth <= 3).length > 0;
const hasSeries = !!(series && seriesPosts && seriesPosts.length > 1 && currentSlug);

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://blog.eone.one';
const postUrl = `${siteUrl}/${section}/${Astro.url.pathname.split('/').pop() ?? ''}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString(),
  "dateModified": date.toISOString(),
  "author": { "@type": "Person", "name": "eone", "url": siteUrl },
  "publisher": { "@type": "Organization", "name": "일취월장", "url": siteUrl },
  "url": postUrl,
  ...(thumbnail && { "image": thumbnail }),
  "keywords": tags.join(', '),
  "inLanguage": lang === 'ko' ? 'ko-KR' : 'en-US',
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "일취월장", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": sectionLabel[section], "item": `${siteUrl}/${section}` },
    { "@type": "ListItem", "position": 3, "name": title, "item": postUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  section={section}
  ogImage={thumbnail}
  lang={lang}
  alternateUrl={alternateUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14">
    <div class="max-w-5xl mx-auto py-12">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-8">
        <a href="/" class="hover:text-foreground transition-colors">eone</a>
        <span>/</span>
        <a href={`/${section}`} class="hover:text-foreground transition-colors" style="color: var(--section-accent);">
          {sectionLabel[section]}
        </a>
        <span>/</span>
        <span class="text-foreground/60 truncate">{title}</span>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <span
            class="text-xs font-semibold uppercase tracking-wide"
            style="color: var(--section-accent);"
          >
            {category}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground leading-tight mb-4">
          {title}
        </h1>

        <p class="text-base text-muted-foreground leading-relaxed mb-6">
          {description}
        </p>

        <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground pb-8 border-b border-border">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {readingTime && (
            <>
              <span class="text-border">·</span>
              <span>{readingTime}분 읽기</span>
            </>
          )}
          {tags.length > 0 && (
            <>
              <span class="text-border">·</span>
              <div class="flex flex-wrap gap-1">
                {tags.map(tag => (
                  <a
                    href={`/tags/${tag}`}
                    class="text-xs px-2 py-0.5 rounded bg-muted text-muted-foreground hover:text-foreground transition-colors"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </>
          )}
        </div>
      </header>

      <!-- Series TOC -->
      {hasSeries && (
        <SeriesTOC seriesName={series!} posts={seriesPosts!} currentSlug={currentSlug!} lang={lang} />
      )}

      <!-- Thumbnail -->
      {thumbnail && (
        <div class="mb-10 rounded-lg overflow-hidden aspect-video bg-muted">
          <img src={thumbnail} alt={title} class="w-full h-full object-cover" />
        </div>
      )}

      <!-- Affiliate notice -->
      {affiliate && <AffiliateNotice />}

      <!-- Ad: above the article -->
      <AdSlot slot="display" />

      <!-- Content + TOC -->
      <div class={hasTOC ? 'lg:grid lg:grid-cols-[1fr_220px] lg:gap-12' : ''}>

        <!-- Article -->
        <article class="prose prose-neutral dark:prose-invert max-w-none
          prose-headings:font-semibold prose-headings:tracking-tight
          prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
          prose-p:leading-[1.9] prose-p:text-foreground/90
          prose-a:text-foreground prose-a:underline prose-a:underline-offset-4
          prose-code:text-sm prose-code:font-mono
          prose-pre:bg-muted prose-pre:border prose-pre:border-border prose-pre:overflow-x-auto prose-pre:max-w-full
          prose-blockquote:border-l-2 prose-blockquote:text-muted-foreground
          prose-img:rounded-lg prose-img:border prose-img:border-border
          prose-table:text-sm prose-th:text-foreground prose-td:text-foreground/80"
          style="--tw-prose-body: var(--foreground); --tw-prose-headings: var(--foreground);"
        >
          <slot />
        </article>

        <!-- TOC (lg+ only, sticky) -->
        {hasTOC && (
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <TOC headings={headings} />
            </div>
          </aside>
        )}
      </div>

      <!-- Series Nav -->
      {hasSeries && (
        <SeriesNav posts={seriesPosts!} currentSlug={currentSlug!} lang={lang} />
      )}

      <!-- Related posts -->
      <RelatedPosts posts={relatedPosts} lang={lang} />

      <!-- Prev / Next navigation -->
      {(prevPost || nextPost) && (
        <div class="mt-12 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={getLocalizedPath(lang, `${prevPost.section}/${prevPost.slug}`)}
              class="group flex flex-col gap-1 p-4 rounded-lg border border-border hover:border-foreground/30 transition-colors"
            >
              <span class="text-xs text-muted-foreground">← 이전 글</span>
              <span class="text-sm font-medium text-foreground group-hover:text-foreground/70 transition-colors line-clamp-2">
                {prevPost.title}
              </span>
            </a>
          ) : <div />}
          {nextPost && (
            <a
              href={getLocalizedPath(lang, `${nextPost.section}/${nextPost.slug}`)}
              class="group flex flex-col gap-1 p-4 rounded-lg border border-border hover:border-foreground/30 transition-colors sm:text-right"
            >
              <span class="text-xs text-muted-foreground">다음 글 →</span>
              <span class="text-sm font-medium text-foreground group-hover:text-foreground/70 transition-colors line-clamp-2">
                {nextPost.title}
              </span>
            </a>
          )}
        </div>
      )}

      <!-- Ad: after the internal links have had first claim on the click -->
      <AdSlot slot="inArticle" />

      <!-- Comments -->
      <Comments client:visible lang={lang} />

      <!-- Back link -->
      <div class="mt-6">
        <a
          href={`/${section}`}
          class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2"
        >
          ← {sectionLabel[section]} 목록으로
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  :global(article.prose pre) {
    position: relative;
  }
  :global(article.prose pre .copy-code-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: var(--muted);
    color: var(--muted-foreground);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  :global(article.prose pre:hover .copy-code-btn),
  :global(article.prose pre .copy-code-btn:focus-visible) {
    opacity: 1;
  }
  :global(article.prose pre .copy-code-btn:hover) {
    color: var(--foreground);
  }
  :global(article.prose pre .copy-code-btn svg) {
    width: 14px;
    height: 14px;
  }
</style>

<script is:inline>
  function initCopyButtons() {
    const COPY_ICON =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const CHECK_ICON =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    document.querySelectorAll('article.prose pre').forEach((pre) => {
      if (pre.querySelector('.copy-code-btn')) return;

      const code = pre.querySelector('code');
      if (!code) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code-btn';
      btn.setAttribute('aria-label', '코드 복사');
      btn.innerHTML = COPY_ICON;

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          btn.innerHTML = CHECK_ICON;
          btn.setAttribute('aria-label', '복사됨');
          setTimeout(() => {
            btn.innerHTML = COPY_ICON;
            btn.setAttribute('aria-label', '코드 복사');
          }, 1500);
        } catch {
          // 클립보드 API 미지원/거부 시 조용히 무시
        }
      });

      pre.appendChild(btn);
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initCopyButtons)
    : initCopyButtons();
</script>

<script is:inline>
  async function initMermaid() {
    // 다이어그램 없으면 mermaid 로드 자체를 스킵
    if (!document.querySelector('pre[data-language="mermaid"]')) return;

    const isDark = document.documentElement.classList.contains('dark');

    try {
      const { default: mermaid } = await import(
        'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
      );

      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        securityLevel: 'loose',
      });

      const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
      for (const pre of blocks) {
        const text = pre.querySelector('code')?.textContent?.trim() ?? '';
        if (!text) continue;

        const id = 'mermaid-' + Math.random().toString(36).slice(2, 9);
        try {
          const { svg } = await mermaid.render(id, text);
          const container = document.createElement('div');
          container.className = 'mermaid-diagram not-prose';
          container.innerHTML = svg;
          pre.replaceWith(container);
        } catch {
          // 개별 다이어그램 실패 시 코드블록 유지
        }
      }
    } catch {
      // mermaid CDN 로드 실패 시 코드블록 유지
    }
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initMermaid)
    : initMermaid();
</script>
