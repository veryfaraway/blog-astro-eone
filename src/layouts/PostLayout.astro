---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import Comments from '../components/Comments';
import SeriesTOC from '../components/SeriesTOC.astro';
import SeriesNav from '../components/SeriesNav.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import AdSlot from '../components/AdSlot.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import type { SeriesPost } from '../components/SeriesTOC.astro';
import type { RelatedCandidate } from '../lib/related';
import { getLocalizedPath } from '../lib/i18n';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NavPost {
  title: string;
  slug: string;
  section: Section;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  section: Section;
  category: string;
  tags?: string[];
  thumbnail?: string;
  lang?: 'ko' | 'en';
  alternateUrl?: string;
  readingTime?: number;
  headings?: Heading[];
  prevPost?: NavPost;
  nextPost?: NavPost;
  series?: string;
  seriesPosts?: SeriesPost[];
  currentSlug?: string;
  affiliate?: boolean;
  relatedPosts?: RelatedCandidate[];
}

const {
  title,
  description,
  date,
  section,
  category,
  tags = [],
  thumbnail,
  lang = 'ko',
  alternateUrl,
  readingTime,
  headings = [],
  prevPost,
  nextPost,
  series,
  seriesPosts,
  currentSlug,
  affiliate = false,
  relatedPosts = [],
} = Astro.props;

const sectionLabel: Record<Section, string> = {
  life: 'Life', money: 'Money', culture: 'Culture', tools: 'Tools', dev: 'Dev',
};

const formattedDate = date.toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const hasTOC = headings.filter(h => h.depth <= 3).length > 0;
const hasSeries = !!(series && seriesPosts && seriesPosts.length > 1 && currentSlug);

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://blog.eone.one';
const postUrl = `${siteUrl}/${section}/${Astro.url.pathname.split('/').pop() ?? ''}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString(),
  "dateModified": date.toISOString(),
  "author": { "@type": "Person", "name": "eone", "url": siteUrl },
  "publisher": { "@type": "Organization", "name": "일취월장", "url": siteUrl },
  "url": postUrl,
  ...(thumbnail && { "image": thumbnail }),
  "keywords": tags.join(', '),
  "inLanguage": lang === 'ko' ? 'ko-KR' : 'en-US',
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "일취월장", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": sectionLabel[section], "item": `${siteUrl}/${section}` },
    { "@type": "ListItem", "position": 3, "name": title, "item": postUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  section={section}
  ogImage={thumbnail}
  lang={lang}
  alternateUrl={alternateUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14">
    <div class="max-w-5xl mx-auto py-12">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-8">
        <a href="/" class="hover:text-foreground transition-colors">eone</a>
        <span>/</span>
        <a href={`/${section}`} class="hover:text-foreground transition-colors" style="color: var(--section-accent);">
          {sectionLabel[section]}
        </a>
        <span>/</span>
        <span class="text-foreground/60 truncate">{title}</span>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-2 mb-4">
          <span
            class="text-xs font-semibold uppercase tracking-wide"
            style="color: var(--section-accent);"
          >
            {category}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground leading-tight mb-4">
          {title}
        </h1>

        <p class="text-base text-muted-foreground leading-relaxed mb-6">
          {description}
        </p>

        <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground pb-8 border-b border-border">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {readingTime && (
            <>
              <span class="text-border">·</span>
              <span>{readingTime}분 읽기</span>
            </>
          )}
          {tags.length > 0 && (
            <>
              <span class="text-border">·</span>
              <div class="flex flex-wrap gap-1">
                {tags.map(tag => (
                  <a
                    href={`/tags/${tag}`}
                    class="text-xs px-2 py-0.5 rounded bg-muted text-muted-foreground hover:text-foreground transition-colors"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            </>
          )}
        </div>
      </header>

      <!-- Series TOC -->
      {hasSeries && (
        <SeriesTOC seriesName={series!} posts={seriesPosts!} currentSlug={currentSlug!} lang={lang} />
      )}

      <!-- Thumbnail -->
      {thumbnail && (
        <div class="mb-10 rounded-lg overflow-hidden aspect-video bg-muted">
          <img src={thumbnail} alt={title} class="w-full h-full object-cover" />
        </div>
      )}

      <!-- Affiliate notice -->
      {affiliate && <AffiliateNotice />}

      <!-- Ad: above the article -->
      <AdSlot slot="display" />

      <!-- Content + TOC -->
      <div class={hasTOC ? 'lg:grid lg:grid-cols-[1fr_220px] lg:gap-12' : ''}>

        <!-- Article -->
        <article class="prose prose-neutral dark:prose-invert max-w-none
          prose-headings:font-semibold prose-headings:tracking-tight
          prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
          prose-p:leading-[1.9] prose-p:text-foreground/90
          prose-a:text-foreground prose-a:underline prose-a:underline-offset-4
          prose-code:text-sm prose-code:font-mono
          prose-pre:bg-muted prose-pre:border prose-pre:border-border prose-pre:overflow-x-auto prose-pre:max-w-full
          prose-blockquote:border-l-2 prose-blockquote:text-muted-foreground
          prose-img:rounded-lg prose-img:border prose-img:border-border
          prose-table:text-sm prose-th:text-foreground prose-td:text-foreground/80"
          style="--tw-prose-body: var(--foreground); --tw-prose-headings: var(--foreground);"
        >
          <slot />
        </article>

        <!-- TOC (lg+ only, sticky) -->
        {hasTOC && (
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <TOC headings={headings} />
            </div>
          </aside>
        )}
      </div>

      <!-- Series Nav -->
      {hasSeries && (
        <SeriesNav posts={seriesPosts!} currentSlug={currentSlug!} lang={lang} />
      )}

      <!-- Related posts -->
      <RelatedPosts posts={relatedPosts} lang={lang} />

      <!-- Prev / Next navigation -->
      {(prevPost || nextPost) && (
        <div class="mt-12 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={getLocalizedPath(lang, `${prevPost.section}/${prevPost.slug}`)}
              class="group flex flex-col gap-1 p-4 rounded-lg border border-border hover:border-foreground/30 transition-colors"
            >
              <span class="text-xs text-muted-foreground">← 이전 글</span>
              <span class="text-sm font-medium text-foreground group-hover:text-foreground/70 transition-colors line-clamp-2">
                {prevPost.title}
              </span>
            </a>
          ) : <div />}
          {nextPost && (
            <a
              href={getLocalizedPath(lang, `${nextPost.section}/${nextPost.slug}`)}
              class="group flex flex-col gap-1 p-4 rounded-lg border border-border hover:border-foreground/30 transition-colors sm:text-right"
            >
              <span class="text-xs text-muted-foreground">다음 글 →</span>
              <span class="text-sm font-medium text-foreground group-hover:text-foreground/70 transition-colors line-clamp-2">
                {nextPost.title}
              </span>
            </a>
          )}
        </div>
      )}

      <!-- Ad: after the internal links have had first claim on the click -->
      <AdSlot slot="inArticle" />

      <!-- Comments -->
      <Comments client:visible lang={lang} />

      <!-- Back link -->
      <div class="mt-6">
        <a
          href={`/${section}`}
          class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2"
        >
          ← {sectionLabel[section]} 목록으로
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  :global(article.prose pre) {
    position: relative;
  }
  :global(article.prose pre .copy-code-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: var(--muted);
    color: var(--muted-foreground);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  :global(article.prose pre:hover .copy-code-btn),
  :global(article.prose pre .copy-code-btn:focus-visible) {
    opacity: 1;
  }
  :global(article.prose pre .copy-code-btn:hover) {
    color: var(--foreground);
  }
  :global(article.prose pre .copy-code-btn svg) {
    width: 14px;
    height: 14px;
  }
</style>

<script is:inline>
  function initCopyButtons() {
    const COPY_ICON =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const CHECK_ICON =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    document.querySelectorAll('article.prose pre').forEach((pre) => {
      if (pre.querySelector('.copy-code-btn')) return;

      const code = pre.querySelector('code');
      if (!code) return;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code-btn';
      btn.setAttribute('aria-label', '코드 복사');
      btn.innerHTML = COPY_ICON;

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          btn.innerHTML = CHECK_ICON;
          btn.setAttribute('aria-label', '복사됨');
          setTimeout(() => {
            btn.innerHTML = COPY_ICON;
            btn.setAttribute('aria-label', '코드 복사');
          }, 1500);
        } catch {
          // 클립보드 API 미지원/거부 시 조용히 무시
        }
      });

      pre.appendChild(btn);
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initCopyButtons)
    : initCopyButtons();
</script>

<script is:inline>
  let mermaidApi = null;
  // 다크모드 토글 시 다시 그리려면 원본 소스를 들고 있어야 한다
  const mermaidDiagrams = [];
  let mermaidRenderToken = 0;

  const isDarkMode = () => document.documentElement.classList.contains('dark');

  function configureMermaid() {
    mermaidApi.initialize({
      startOnLoad: false,
      theme: isDarkMode() ? 'dark' : 'neutral',
      securityLevel: 'loose',
    });
  }

  async function renderDiagram(container, source) {
    const id = 'mermaid-' + Math.random().toString(36).slice(2, 9);
    try {
      const { svg } = await mermaidApi.render(id, source);
      container.innerHTML = svg;
      makeZoomable(container);
      return true;
    } catch {
      return false; // 개별 다이어그램 실패 시 호출 측에서 코드블록 유지
    }
  }

  async function initMermaid() {
    // 다이어그램 없으면 mermaid 로드 자체를 스킵
    if (!document.querySelector('pre[data-language="mermaid"]')) return;

    try {
      const { default: mermaid } = await import(
        'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
      );
      mermaidApi = mermaid;
      configureMermaid();

      const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
      for (const pre of blocks) {
        const source = pre.querySelector('code')?.textContent?.trim() ?? '';
        if (!source) continue;

        const container = document.createElement('div');
        container.className = 'mermaid-diagram not-prose';
        if (await renderDiagram(container, source)) {
          pre.replaceWith(container);
          mermaidDiagrams.push({ container, source });
        }
      }

      watchThemeChange();
    } catch {
      // mermaid CDN 로드 실패 시 코드블록 유지
    }
  }

  /* mermaid는 렌더링 시점의 테마로 SVG를 한 번 굽기 때문에, 글을 읽던 중
     다크모드를 토글하면 다이어그램 색만 그대로 남는다. html의 class 변화를
     감시해서 테마가 실제로 바뀐 경우에만 전부 다시 그린다. */
  function watchThemeChange() {
    let wasDark = isDarkMode();

    new MutationObserver(async () => {
      if (isDarkMode() === wasDark) return; // 테마와 무관한 class 변경은 무시
      wasDark = isDarkMode();

      // 빠르게 연타했을 때 이전 렌더가 뒤늦게 덮어쓰지 않도록
      const token = ++mermaidRenderToken;
      configureMermaid();
      for (const { container, source } of mermaidDiagrams) {
        if (token !== mermaidRenderToken) return;
        await renderDiagram(container, source);
      }
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  /* ── 다이어그램 클릭 시 라이트박스로 확대 ──
     mermaid 결과물이 SVG(벡터)라 확대해도 깨지지 않는다. 원본 SVG를 복제해
     쓰되, mermaid가 만든 스타일이 #id 선택자로 스코프돼 있어 id 중복을 피하려면
     복제본의 id를 새로 바꿔줘야 한다. */
  function makeZoomable(container) {
    if (!container.querySelector('svg')) return;

    // 힌트 배지는 innerHTML 교체 때 함께 날아가므로 렌더링할 때마다 다시 붙인다
    const hint = document.createElement('span');
    hint.className = 'mermaid-zoom-hint';
    hint.setAttribute('aria-hidden', 'true');
    hint.textContent = '🔍 클릭해서 확대';
    container.appendChild(hint);

    // 반면 리스너는 컨테이너에 남아 있다. 테마 토글로 다시 그릴 때 중복으로
    // 달리면 클릭 한 번에 라이트박스가 여러 개 열린다.
    if (container.dataset.zoomBound === '1') return;
    container.dataset.zoomBound = '1';

    container.classList.add('is-zoomable');
    container.setAttribute('role', 'button');
    container.setAttribute('tabindex', '0');
    container.setAttribute('aria-label', '다이어그램 확대해서 보기');

    // 클릭 시점에 SVG를 다시 찾아야 리렌더된 최신 다이어그램이 열린다
    const open = () => {
      const svg = container.querySelector('svg');
      if (svg) openLightbox(svg);
    };
    container.addEventListener('click', open);
    container.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open();
      }
    });
  }

  function cloneSvg(svg) {
    const oldId = svg.id;
    const newId = 'mermaid-zoom-' + Math.random().toString(36).slice(2, 9);
    const holder = document.createElement('div');
    // mermaid 내부 <style>이 #oldId로 스코프돼 있어 문자열 치환으로 함께 바꾼다
    holder.innerHTML = oldId ? svg.outerHTML.split(oldId).join(newId) : svg.outerHTML;
    const clone = holder.firstElementChild;
    if (!clone) return null;

    // mermaid는 SVG에 width="100%"를 걸어둔다. shrink-to-fit 컨테이너 안에서는
    // 이게 0으로 무너지므로, viewBox의 고유 크기를 실제 width/height로 박아준다.
    const vb = svg.viewBox?.baseVal;
    const rect = svg.getBoundingClientRect();
    const w = vb?.width || rect.width;
    const h = vb?.height || rect.height;
    if (w && h) {
      clone.setAttribute('width', String(w));
      clone.setAttribute('height', String(h));
    }
    // mermaid가 걸어둔 인라인 max-width는 제거만 한다. 'none'으로 덮으면
    // 인라인 스타일이 우선순위를 가져가 스타일시트의 뷰포트 상한이 무시된다.
    clone.style.removeProperty('max-width');
    return clone;
  }

  function openLightbox(sourceSvg) {
    const clone = cloneSvg(sourceSvg);
    if (!clone) return;

    const lastFocused = document.activeElement;

    const overlay = document.createElement('div');
    overlay.className = 'mermaid-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', '확대한 다이어그램');
    overlay.innerHTML = `
      <div class="mermaid-lightbox__toolbar">
        <button type="button" class="mermaid-lightbox__btn" data-act="out" aria-label="축소">−</button>
        <button type="button" class="mermaid-lightbox__btn" data-act="in" aria-label="확대">+</button>
        <button type="button" class="mermaid-lightbox__btn" data-act="reset" aria-label="화면에 맞추기">맞춤</button>
        <button type="button" class="mermaid-lightbox__btn" data-act="close" aria-label="닫기">✕</button>
      </div>
      <div class="mermaid-lightbox__stage"><div class="mermaid-lightbox__canvas"></div></div>
      <p class="mermaid-lightbox__footer">스크롤·핀치로 확대 · 드래그로 이동 · 더블클릭으로 초기화 · Esc로 닫기</p>
    `;

    const stage = overlay.querySelector('.mermaid-lightbox__stage');
    const canvas = overlay.querySelector('.mermaid-lightbox__canvas');
    canvas.appendChild(clone);

    const bodyOverflow = document.body.style.overflow;
    const MIN = 0.4;
    const MAX = 8;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    // 드래그로 끝난 클릭이 배경 클릭(=닫기)으로 오인되지 않게 하는 플래그
    let dragged = false;

    const clamp = (v) => Math.min(MAX, Math.max(MIN, v));
    const apply = () => {
      canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    };

    // 커서(또는 핀치 중심) 위치를 기준으로 확대해야 보고 있던 지점이 유지된다
    function zoomAt(clientX, clientY, factor) {
      const rect = stage.getBoundingClientRect();
      const px = clientX - rect.left - rect.width / 2;
      const py = clientY - rect.top - rect.height / 2;
      const next = clamp(scale * factor);
      const k = next / scale;
      tx = px - k * (px - tx);
      ty = py - k * (py - ty);
      scale = next;
      apply();
    }

    function reset() {
      scale = 1;
      tx = 0;
      ty = 0;
      apply();
    }

    function zoomCenter(factor) {
      const rect = stage.getBoundingClientRect();
      zoomAt(rect.left + rect.width / 2, rect.top + rect.height / 2, factor);
    }

    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.12 : 1 / 1.12);
      },
      { passive: false }
    );

    stage.addEventListener('dblclick', reset);

    // 드래그 패닝 + 두 손가락 핀치 줌 (포인터 이벤트로 마우스/터치 동시 처리)
    const pointers = new Map();
    let pinchDist = 0;
    let pinchMid = { x: 0, y: 0 };

    stage.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      stage.setPointerCapture(e.pointerId);
      if (pointers.size === 1) {
        dragged = false;
        stage.classList.add('is-panning');
      }
    });

    stage.addEventListener('pointermove', (e) => {
      const prev = pointers.get(e.pointerId);
      if (!prev) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (pointers.size === 1) {
        const dx = e.clientX - prev.x;
        const dy = e.clientY - prev.y;
        if (Math.abs(dx) > 2 || Math.abs(dy) > 2) dragged = true;
        tx += dx;
        ty += dy;
        apply();
        return;
      }

      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
        if (pinchDist > 0) {
          tx += mid.x - pinchMid.x;
          ty += mid.y - pinchMid.y;
          zoomAt(mid.x, mid.y, dist / pinchDist);
        }
        pinchDist = dist;
        pinchMid = mid;
      }
    });

    const endPointer = (e) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinchDist = 0;
      if (pointers.size === 0) stage.classList.remove('is-panning');
    };
    stage.addEventListener('pointerup', endPointer);
    stage.addEventListener('pointercancel', endPointer);

    function close() {
      document.removeEventListener('keydown', onKey);
      overlay.classList.remove('is-open');
      document.body.style.overflow = bodyOverflow;
      setTimeout(() => overlay.remove(), 180);
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }

    function onKey(e) {
      if (e.key === 'Escape') close();
      else if (e.key === '+' || e.key === '=') zoomCenter(1.2);
      else if (e.key === '-') zoomCenter(1 / 1.2);
      else if (e.key === '0') reset();
    }

    overlay.addEventListener('click', (e) => {
      const act = e.target instanceof Element ? e.target.closest('[data-act]')?.dataset.act : null;
      if (act === 'in') zoomCenter(1.2);
      else if (act === 'out') zoomCenter(1 / 1.2);
      else if (act === 'reset') reset();
      else if (act === 'close' || ((e.target === overlay || e.target === stage) && !dragged)) close();
    });

    document.addEventListener('keydown', onKey);

    document.body.style.overflow = 'hidden';
    document.body.appendChild(overlay);

    // 화면 폭에 맞추다 보면 원본보다 크게 줄어드는 경우가 있다(주로 모바일).
    // 글씨를 못 읽을 만큼 줄었을 때만 읽을 수 있는 배율로 열고, 나머지는 드래그로 본다.
    // 데스크톱처럼 이미 충분히 큰 경우엔 화면에 꽉 맞춘 상태가 낫기 때문에 건드리지 않는다.
    const fittedW = clone.getBoundingClientRect().width;
    const naturalW = Number(clone.getAttribute('width')) || fittedW;
    const fitRatio = naturalW > 0 ? fittedW / naturalW : 1;
    if (fitRatio > 0 && fitRatio < 0.6) {
      scale = clamp(0.75 / fitRatio);
      apply();
    }

    requestAnimationFrame(() => overlay.classList.add('is-open'));
    overlay.querySelector('[data-act="close"]')?.focus();
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initMermaid)
    : initMermaid();
</script>
