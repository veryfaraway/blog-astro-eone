      const modelSpecBar = root.querySelector<HTMLElement>('.ai-model-spec-bar')!;

      const dailyTitle = root.querySelector<HTMLElement>('.ai-daily-title')!;
      const dailyLabel = root.querySelector<HTMLElement>('.ai-daily-label')!;
      const dailyRange = root.querySelector<HTMLInputElement>('.ai-daily-range')!;
      const dailyChipsWrap = root.querySelector<HTMLElement>('.ai-daily-chips')!;

      const daysLabel = root.querySelector<HTMLElement>('.ai-days-label')!;
      const daysRange = root.querySelector<HTMLInputElement>('.ai-days-range')!;

      const compTitle = root.querySelector<HTMLElement>('.ai-comp-title')!;
      const compLabel = root.querySelector<HTMLElement>('.ai-comp-label')!;
      const compRange = root.querySelector<HTMLInputElement>('.ai-comp-range')!;
      const compTokens = root.querySelector<HTMLElement>('.ai-comp-tokens')!;
      const compChipsWrap = root.querySelector<HTMLElement>('.ai-comp-chips')!;

      const advSummaryPill = root.querySelector<HTMLElement>('.ai-adv-summary-pill')!;
      const cacheLabel = root.querySelector<HTMLElement>('.ai-cache-label')!;
      const cacheRange = root.querySelector<HTMLInputElement>('.ai-cache-range')!;
      const fxLabel = root.querySelector<HTMLElement>('.ai-fx-label')!;
      const fxRange = root.querySelector<HTMLInputElement>('.ai-fx-range')!;

      const vatChk = root.querySelector<HTMLInputElement>('.ai-vat-chk')!;
      const ttlChk = root.querySelector<HTMLInputElement>('.ai-ttl-chk')!;
      const cliffChk = root.querySelector<HTMLInputElement>('.ai-cliff-chk')!;
      const cliffStatus = root.querySelector<HTMLElement>('.ai-cliff-status')!;

      // Outputs
      const verdictSub = root.querySelector<HTMLElement>('.ai-verdict-sub')!;
      const verdictTitle = root.querySelector<HTMLElement>('.ai-verdict-title')!;
      const verdictBadge = root.querySelector<HTMLElement>('.ai-verdict-badge')!;
      const verdictDesc = root.querySelector<HTMLElement>('.ai-verdict-desc')!;

      const kpiApiMain = root.querySelector<HTMLElement>('.ai-kpi-api-main')!;
      const kpiApiSub = root.querySelector<HTMLElement>('.ai-kpi-api-sub')!;
      const kpiSubLabel = root.querySelector<HTMLElement>('.ai-kpi-sub-label')!;
      const kpiSubMain = root.querySelector<HTMLElement>('.ai-kpi-sub-main')!;
      const kpiSubDetail = root.querySelector<HTMLElement>('.ai-kpi-sub-detail')!;
      const kpiBeMain = root.querySelector<HTMLElement>('.ai-kpi-be-main')!;
      const kpiBeSub = root.querySelector<HTMLElement>('.ai-kpi-be-sub')!;
      const kpiRecMain = root.querySelector<HTMLElement>('.ai-kpi-rec-main')!;
      const kpiRecSub = root.querySelector<HTMLElement>('.ai-kpi-rec-sub')!;

      // SVG Chart
      const chartCaption = root.querySelector<HTMLElement>('.ai-chart-caption')!;
      const legend100 = root.querySelector<HTMLElement>('.ai-legend-100')!;
      const legend200 = root.querySelector<HTMLElement>('.ai-legend-200')!;
      const svgEl = root.querySelector<SVGSVGElement>('.ai-svg-chart')!;
      const svgGrid = root.querySelector<SVGGElement>('.ai-svg-grid')!;
      const svgSub20 = root.querySelector<SVGLineElement>('.ai-svg-sub20')!;
      const svgSub100 = root.querySelector<SVGLineElement>('.ai-svg-sub100')!;
      const svgSub200 = root.querySelector<SVGLineElement>('.ai-svg-sub200')!;
      const svgUncached = root.querySelector<SVGLineElement>('.ai-svg-uncached')!;
      const svgCached = root.querySelector<SVGLineElement>('.ai-svg-cached')!;
      const svgUserVline = root.querySelector<SVGLineElement>('.ai-svg-user-vline')!;
      const svgHoverVline = root.querySelector<SVGLineElement>('.ai-svg-hover-vline')!;
      const svgMarkers = root.querySelector<SVGGElement>('.ai-svg-markers')!;
      const svgLabels = root.querySelector<SVGGElement>('.ai-svg-labels')!;
      const svgHitrect = root.querySelector<SVGRectElement>('.ai-svg-hitrect')!;

      function applyPresetDefaults(pKey: PresetKey) {
        const cfg = PRESETS[pKey];
        dailyRange.max = String(cfg.dailyMax);
        dailyRange.value = String(cfg.defaultDaily);
        daysRange.value = String(cfg.defaultDays);
        compRange.min = String(cfg.compMin);
        compRange.max = String(cfg.compMax);
        compRange.value = String(cfg.defaultComp);
        cacheRange.value = String(cfg.defaultCachePct);

        dailyTitle.textContent = cfg.dailyTitle;
        compTitle.textContent = cfg.compTitle;

        dailyChipsWrap.innerHTML = cfg.dailyChips
          .map(
            (c) =>
              `<button type="button" data-daily="${c.val}" class="ai-daily-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">${c.label}</button>`,
          )
          .join('');

        compChipsWrap.innerHTML = cfg.compChips
          .map(
            (c) =>
              `<button type="button" data-comp="${c.val}" class="ai-comp-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">${c.label}</button>`,
          )
          .join('');

        dailyChipsWrap.querySelectorAll<HTMLButtonElement>('.ai-daily-chip').forEach((btn) => {
          btn.addEventListener('click', () => {
            hoveredX = null;
            dailyRange.value = btn.dataset.daily || String(cfg.defaultDaily);
            render();
          });
        });

        compChipsWrap.querySelectorAll<HTMLButtonElement>('.ai-comp-chip').forEach((btn) => {
          btn.addEventListener('click', () => {
            hoveredX = null;
            compRange.value = btn.dataset.comp || String(cfg.defaultComp);
            render();
          });
        });
      }

      let latestState = {
        billedCachedPerTask: 0,
        billedUncachedPerTask: 0,
        billedSub20: 20,
        billedSub100: 100,
        monthlyTasks: 60,
        maxX: 90,
        unitWord: '건',
      };

      function updateChartCaption(xCount: number, isHover: boolean) {
        const s = latestState;
        const apiAtX = xCount * s.billedCachedPerTask;
        const uncachedAtX = xCount * s.billedUncachedPerTask;
        const prefix = isHover ? `[비교 지점: 월 ${xCount}${s.unitWord}]` : `[내 사용량: 월 ${xCount}${s.unitWord}]`;
        chartCaption.textContent = `${prefix} 캐시 적용 API ${fmtUsd(apiAtX)} · 캐시 미적용 ${fmtUsd(uncachedAtX)} · $20 구독 ${fmtUsd(s.billedSub20)} · $100 구독 ${fmtUsd(s.billedSub100)}`;
      }

      function render() {
        // Sync active button classes
        presetBtns.forEach((btn) => {
          const active = btn.dataset.preset === currentPreset;
          btn.setAttribute('aria-selected', String(active));
          btn.className = active
            ? 'ai-preset-btn rounded-lg border border-primary bg-primary/10 px-3 py-2.5 text-left transition cursor-pointer'
            : 'ai-preset-btn rounded-lg border border-border bg-muted/40 px-3 py-2.5 text-left transition cursor-pointer hover:bg-muted/70';
        });

        modelBtns.forEach((btn) => {
          const active = btn.dataset.model === currentModelId;
          btn.setAttribute('aria-checked', String(active));
          btn.className = active
            ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
            : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60';
        });

        const cfg = PRESETS[currentPreset];
        const model = MODELS[currentModelId];
        const subGroup = SUB_TIERS[model.vendor];

        const dailyCount = Math.max(1, parseInt(dailyRange.value, 10) || cfg.defaultDaily);
        const daysCount = Math.max(1, Math.min(30, parseInt(daysRange.value, 10) || cfg.defaultDays));
        const compVal = Math.max(cfg.compMin, Math.min(cfg.compMax, parseInt(compRange.value, 10) || cfg.defaultComp));
        const cachePct = Math.max(0, Math.min(95, parseFloat(cacheRange.value) || 0));
        const fx = Math.max(1000, parseInt(fxRange.value, 10) || 1400);

        const vatActive = vatChk.checked;
        const ttlActive = ttlChk.checked;
        const cliffActive = cliffChk.checked;
        const billingMult = vatActive ? 1.1125 : 1.0;

        const monthlyTasks = dailyCount * daysCount;

        // Labels update
        dailyLabel.textContent = `${dailyCount}${cfg.unitWord} / 일`;
        daysLabel.textContent = `${daysCount}일 / 월 (총 ${monthlyTasks}${cfg.unitWord})`;
        compLabel.textContent = currentPreset === 'chat' ? `${compVal}배 규모` : `${compVal}회 루프`;
        cacheLabel.textContent = `${cachePct % 1 === 0 ? cachePct.toFixed(0) : cachePct.toFixed(1)}%`;
        fxLabel.textContent = `${fx.toLocaleString('ko-KR')}원 / $`;

        const pillParts = [
          `캐시 ${cachePct % 1 === 0 ? cachePct.toFixed(0) : cachePct.toFixed(1)}%`,
          `${fx.toLocaleString('ko-KR')}원/$`,
          vatActive ? '부가세·수수료 포함' : '사업자 면세·원가',
        ];
        if (ttlActive) pillParts.push('TTL 페널티');
        if (cliffActive) pillParts.push('>272K 장문');
        advSummaryPill.textContent = `${pillParts.join(' · ')} ▾`;

        if (cliffActive) {
          cliffStatus.textContent = model.has272kCliff
            ? '⚠️ GPT-6 >272K 할증 발동 중! (입력 2배 · 출력 1.5배 적용)'
            : '✓ 선택 모델은 1M 평탄 요금제 (단가 할증 0%, 280K+ 컨텍스트 분량만 반영)';
          cliffStatus.className = model.has272kCliff
            ? 'ai-cliff-status font-semibold text-amber-600 dark:text-amber-400'
            : 'ai-cliff-status font-semibold text-emerald-600 dark:text-emerald-400';
        } else {
          cliffStatus.textContent = '(GPT-6 입력 2배·출력 1.5배 할증 vs Claude·Gemini 1M 단일가 비교)';
          cliffStatus.className = 'ai-cliff-status text-muted-foreground';
        }

        // Model Spec Bar
        modelSubHint.textContent = model.subNote;
        const writeRate = model.inputRate * model.cacheWriteMult;
        const writeLabel =
          model.cacheWriteMult > 1
            ? `캐시 쓰기 $${writeRate.toFixed(2)}(${model.cacheWriteMult}×)`
            : `캐시 쓰기 할증 없음($${writeRate.toFixed(2)})`;
        modelSpecBar.innerHTML = `
          <span>입력 <strong>$${model.inputRate.toFixed(2)}</strong> · ${writeLabel} · 캐시 읽기 <strong>$${model.cacheReadRate}</strong> · 출력 <strong>$${model.outputRate.toFixed(2)}</strong> / 1M</span>
          <span>${model.cliffNote}</span>
        `;

        // Calculate costs
        const { rawCached, rawUncached, totalInputTok, outputTok } = calcTaskCostUsd(
          currentPreset,
          compVal,
          cachePct,
          model,
          ttlActive,
          cliffActive,
        );

        compTokens.textContent = `1회 누적 ${fmtTokens(totalInputTok)} 입 · ${fmtTokens(outputTok)} 출`;

        const billedCachedPerTask = rawCached * billingMult;
        const billedUncachedPerTask = rawUncached * billingMult;

        const rawMonthlyApi = rawCached * monthlyTasks;
        const billedMonthlyApi = billedCachedPerTask * monthlyTasks;
        const billedMonthlyUncached = billedUncachedPerTask * monthlyTasks;
        const savedByCache = Math.max(0, billedMonthlyUncached - billedMonthlyApi);

        const billedSub20 = subGroup.tier20Price * billingMult;
        const billedSub100 = subGroup.tier100Price * billingMult;
        const billedSub200 = subGroup.tier200Price * billingMult;

        // Break-even counts (invariant to billingMult since both sides scale equally)
        const be20Exact = rawCached > 0 ? subGroup.tier20Price / rawCached : Infinity;
        const be100Exact = rawCached > 0 ? subGroup.tier100Price / rawCached : Infinity;
        const be20Ceil = Math.ceil(be20Exact);
        const be100Ceil = Math.ceil(be100Exact);
        const be20Daily = be20Exact / daysCount;

        // KPI 1: API Monthly
        kpiApiMain.innerHTML = `${fmtUsd(billedMonthlyApi)} <span class="text-xs font-semibold text-muted-foreground">(${fmtKrw(billedMonthlyApi, fx)})</span>`;
        kpiApiSub.textContent = `1${cfg.unitWord}당 ${fmtUsd(billedCachedPerTask)} (${fmtKrw(billedCachedPerTask, fx)}) · 세전 월 ${fmtUsd(rawMonthlyApi)}`;

        // KPI 2: Subscription Fixed
        kpiSubLabel.textContent = `${subGroup.vendorLabel} 월 고정비`;
        kpiSubMain.innerHTML = `${fmtUsd(billedSub20)} <span class="text-xs font-semibold text-muted-foreground">· ${fmtUsd(billedSub100)}</span>`;
        const short20 = subGroup.tier20Name.replace(/^(Claude|ChatGPT|Google AI)\s*/, '');
        const short100 = subGroup.tier100Name.replace(/^(Claude|ChatGPT|Google AI)\s*/, '');
        const short200 = subGroup.tier200Name.replace(/^(Claude|ChatGPT|Google AI)\s*/, '');
        kpiSubDetail.textContent = `${short20} ${fmtKrwMan(billedSub20, fx)} · ${short100} ${fmtKrwMan(billedSub100, fx)} · ${short200} ${fmtUsd(billedSub200)}`;

        // KPI 3: Break-Even
        if (be20Ceil > 9999) {
          kpiBeMain.textContent = '구독 손익분기 도달 불가';
          kpiBeMain.className = 'ai-kpi-be-main mt-1 text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
          kpiBeSub.textContent = '초저가 API 구간으로 종량제가 상시 유리';
        } else {
          kpiBeMain.textContent = `월 ${be20Ceil.toLocaleString()}${cfg.unitWord} 이상 $20 구독 유리`;
          kpiBeMain.className =
            monthlyTasks >= be20Ceil
              ? 'ai-kpi-be-main mt-1 text-base sm:text-lg font-extrabold text-amber-600 dark:text-amber-400'
              : 'ai-kpi-be-main mt-1 text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
          kpiBeSub.textContent = `일 ${be20Daily < 10 ? be20Daily.toFixed(1) : Math.round(be20Daily)}${cfg.unitWord} · $100 구독 분기점: 월 ${be100Ceil.toLocaleString()}${cfg.unitWord}`;
        }

        // 3단 의사결정 배너 & KPI 4
        verdictSub.textContent = `월 ${monthlyTasks.toLocaleString()}${cfg.unitWord} (${daysCount}일 × 일 ${dailyCount}${cfg.unitWord}) · ${model.name} 기준`;

        if (model.vendor === 'deepseek') {
          const diffVs20 = billedSub20 - billedMonthlyApi;
          if (diffVs20 > 0) {
            verdictTitle.textContent = '초저가 오픈웨이트 API 압승: 정액 구독 불필요';
            verdictTitle.className = 'ai-verdict-title text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
            verdictBadge.textContent = `$20 구독 대비 월 ${fmtUsd(diffVs20)} (${fmtKrw(diffVs20, fx)}) 절약`;
            verdictBadge.className = 'ai-verdict-badge rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-bold text-emerald-700 dark:text-emerald-300';
          } else {
            verdictTitle.textContent = '대규모 스웜 물량 구간: 주말·오프피크 50% 할인 활용 권장';
            verdictTitle.className = 'ai-verdict-title text-base sm:text-lg font-extrabold text-cyan-600 dark:text-cyan-400';
            verdictBadge.textContent = `주말 반값 적용 시 약 ${fmtUsd(billedMonthlyApi * 0.5)} 수준`;
            verdictBadge.className = 'ai-verdict-badge rounded-md bg-cyan-500/15 px-2 py-0.5 text-xs font-bold text-cyan-700 dark:text-cyan-300';
          }
          verdictDesc.textContent =
            'DeepSeek V4.1 Flash는 별도 월정액 없이 Anthropic 호환 엔드포인트로 즉시 연결됩니다. UTC 오프피크 및 주말 전체 시간대에는 단가가 절반($0.15/$0.60)으로 내려가 대량 테스트·문서화 배치 워커로 압도적입니다.';
          kpiRecMain.textContent = 'API 직결 (오프피크 병행)';
          kpiRecMain.className = 'ai-kpi-rec-main mt-1 text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
        } else if (rawMonthlyApi < subGroup.tier20Price * 0.7) {
          // 구간 A: API 압승 (< ~$14)
          const saveUsd = billedSub20 - billedMonthlyApi;
          verdictTitle.textContent = '구간 A (API 종량제 압승): 구독 해지 및 BYOK 전환 추천';
          verdictTitle.className = 'ai-verdict-title text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
          verdictBadge.textContent = `${subGroup.tier20Name} 대비 월 ${fmtUsd(saveUsd)} (${fmtKrw(saveUsd, fx)}) 절약`;
          verdictBadge.className = 'ai-verdict-badge rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-bold text-emerald-700 dark:text-emerald-300';
          verdictDesc.textContent = model.hasFreeTier
            ? '현재 사용량에서는 $20 정액제가 고정비 낭비입니다. 특히 Gemini 4 Hydrogen은 무료 티어도 열려 있어 개인 학습·비보안 프로젝트는 0원으로 시작할 수 있습니다(단, 사내 코드는 반드시 유료 API 티어 연결).'
            : `월 예상 API 비용이 ${fmtUsd(billedMonthlyApi)}에 불과해 정액 구독료의 절반에도 못 미칩니다. 안 쓰는 주간에도 빠져나가는 구독을 정리하고 OpenRouter(BYOK 수수료 0%)나 공식 API 키를 연결해 쓴 만큼만 내세요.`;
          kpiRecMain.textContent = 'API 종량제 (BYOK)';
          kpiRecMain.className = 'ai-kpi-rec-main mt-1 text-base sm:text-lg font-extrabold text-emerald-600 dark:text-emerald-400';
        } else if (rawMonthlyApi <= subGroup.tier20Price * 1.4) {
          // 구간 B: 경계 구간 ($14 ~ $28)
          const diff = Math.abs(billedMonthlyApi - billedSub20);
          verdictTitle.textContent = `구간 B (손익분기 경계선): 심리적 정액 해방감 vs 5시간 쿼터 제한`;
          verdictTitle.className = 'ai-verdict-title text-base sm:text-lg font-extrabold text-amber-600 dark:text-amber-400';
          verdictBadge.textContent = `구독제와 월 차액 ${fmtUsd(diff)} (${fmtKrw(diff, fx)}) 이내`;
          verdictBadge.className = 'ai-verdict-badge rounded-md bg-amber-500/15 px-2 py-0.5 text-xs font-bold text-amber-700 dark:text-amber-300';
          verdictDesc.textContent =
            '금전적 유불리 차이가 커피 한두 잔 값 이내인 팽팽한 구간입니다. 프롬프트 던질 때마다 요금 미터기 눈치 보는 스트레스가 싫다면 $20 구독이 낫고, 특정 마감일에 몰아서 작업하다 5시간 롤링 쿼터 락아웃에 막히는 게 싫다면 API 종량제가 유리합니다.';
          kpiRecMain.textContent = rawMonthlyApi <= subGroup.tier20Price ? '성향별 선택 (경계 구간)' : `${subGroup.tier20Name} ($20) 우위`;
          kpiRecMain.className = 'ai-kpi-rec-main mt-1 text-base sm:text-lg font-extrabold text-amber-600 dark:text-amber-400';
        } else {
          // 구간 C: 헤비 에이전트 구간 (> $28)
          if (rawMonthlyApi < subGroup.tier100Price * 0.95) {
            const saveVs20 = billedMonthlyApi - billedSub20;
            verdictTitle.textContent = `구간 C (에이전트 본전 돌파): ${subGroup.tier20Name} + 경량 API 하이브리드 추천`;
            verdictTitle.className = 'ai-verdict-title text-base sm:text-lg font-extrabold text-cyan-600 dark:text-cyan-400';
            verdictBadge.textContent = `순수 API 대비 최대 ${fmtUsd(saveVs20)} 방어 구간`;
            verdictBadge.className = 'ai-verdict-badge rounded-md bg-cyan-500/15 px-2 py-0.5 text-xs font-bold text-cyan-700 dark:text-cyan-300';
            verdictDesc.textContent =
              model.id === 'claude-fable-5-2'
                ? '주의: Fable 5.2는 단가가 무거워 $20 Pro 구독에서는 몇 번만 호출해도 5시간 쿼터가 바닥납니다. 일상 구현은 Opus 5.5로 내리고, Fable 5.2를 주력으로 쓰려면 $100 Max 이상 티어가 필수입니다.'
                : `순수 API로만 쓰면 월 ${fmtUsd(billedMonthlyApi)}가 청구됩니다. $20 구독 1개를 베이스캠프로 깔고, 바쁜 오후 5시간 쿼터에 걸릴 때나 단순 파일 탐색 루프만 경량 API(Hydrogen · GPT-6.1 Sol · DeepSeek)로 우회하면 $100 티어로 올리지 않고도 쾌적하게 방어됩니다.`;
            kpiRecMain.textContent = '$20 구독 + 보조 API 하이브리드';
            kpiRecMain.className = 'ai-kpi-rec-main mt-1 text-base sm:text-lg font-extrabold text-cyan-600 dark:text-cyan-400';
          } else {
            const bestSubPrice = rawMonthlyApi >= subGroup.tier200Price * 1.15 ? billedSub200 : billedSub100;
            const bestSubName = rawMonthlyApi >= subGroup.tier200Price * 1.15 ? subGroup.tier200Name : subGroup.tier100Name;
            const saveHeavy = Math.max(0, billedMonthlyApi - bestSubPrice);
            verdictTitle.textContent = `구간 C (헤비 에이전트 경보): 순수 API 요금 폭탄 주의 → ${bestSubName} 추천`;
            verdictTitle.className = 'ai-verdict-title text-base sm:text-lg font-extrabold text-violet-600 dark:text-violet-400';
            verdictBadge.textContent =
              saveHeavy > 0
                ? `${bestSubName} 전환 시 월 ${fmtUsd(saveHeavy)} (${fmtKrwMan(saveHeavy, fx)}) 절약`
                : `${bestSubName} 손익분기 정면 돌파`;
            verdictBadge.className = 'ai-verdict-badge rounded-md bg-violet-500/15 px-2 py-0.5 text-xs font-bold text-violet-700 dark:text-violet-300';
            verdictDesc.textContent = `터미널 코딩 에이전트를 매일 본격 가동하는 전형적인 헤비 워크로드입니다. 순수 API 사용 시 월 ${fmtUsd(billedMonthlyApi)}(${fmtKrwMan(billedMonthlyApi, fx)})가 빠져나가므로 ${bestSubName} 정액제로 상한선을 잠그고, 병렬 스웜 워커는 초저가 API로 분리하세요.`;
            kpiRecMain.textContent = `${bestSubName} 정액제`;
            kpiRecMain.className = 'ai-kpi-rec-main mt-1 text-base sm:text-lg font-extrabold text-violet-600 dark:text-violet-400';
          }
        }

        kpiRecSub.textContent =
          savedByCache >= 1
            ? `프롬프트 캐싱이 월 ${fmtUsd(savedByCache)} 추가 폭탄 방어 중`
            : `캐시 절감액 월 ${fmtUsd(savedByCache)} 반영`;

        // ==================== SVG Chart Rendering ====================
        const padL = 58;
        const padR = 24;
        const padT = 18;
        const padB = 38;
        const plotW = 680 - padL - padR; // 598
        const plotH = 250 - padT - padB; // 194

        // X-axis range: ensure user's monthlyTasks and $20 break-even (if reasonable) are nicely visible
        let targetMaxX = Math.max(monthlyTasks * 1.45, currentPreset === 'chat' ? 300 : 40);
        if (be20Exact < monthlyTasks * 2.5 && Number.isFinite(be20Exact)) {
          targetMaxX = Math.max(targetMaxX, be20Exact * 1.35);
        }
        const stepUnit = targetMaxX <= 50 ? 10 : targetMaxX <= 150 ? 20 : targetMaxX <= 400 ? 50 : 100;
        const maxX = Math.ceil(targetMaxX / stepUnit) * stepUnit;

        const apiAtMaxX = maxX * billedCachedPerTask;
        const showSub100 = apiAtMaxX >= billedSub100 * 0.55 || billedMonthlyApi >= billedSub100 * 0.5;
        const showSub200 = apiAtMaxX >= billedSub200 * 0.7 || billedMonthlyApi >= billedSub200 * 0.7;

        legend100.classList.toggle('hidden', !showSub100);
        legend200.classList.toggle('hidden', !showSub200);

        let rawMaxY = Math.max(
          billedSub20 * 1.55,
          billedMonthlyApi * 1.28,
          apiAtMaxX * 1.08,
          showSub100 ? billedSub100 * 1.22 : 0,
          showSub200 ? billedSub200 * 1.15 : 0,
        );
        const yStep =
          rawMaxY <= 35 ? 10 : rawMaxY <= 80 ? 20 : rawMaxY <= 200 ? 50 : rawMaxY <= 500 ? 100 : 200;
        const maxY = Math.ceil(rawMaxY / yStep) * yStep;

        const xAt = (cnt: number) => padL + (cnt / maxX) * plotW;
        const yAt = (usd: number) => padT + plotH - (usd / maxY) * plotH;

        // Gridlines
        let gridHtml = '';
        const yTickCount = Math.min(5, Math.max(3, Math.round(maxY / yStep)));
        for (let i = 0; i <= yTickCount; i++) {
          const val = (maxY * i) / yTickCount;
          const y = yAt(val).toFixed(1);
          gridHtml += `<line x1="${padL}" y1="${y}" x2="${680 - padR}" y2="${y}" stroke="currentColor" stroke-opacity="0.1" stroke-width="1" />`;
          gridHtml += `<text x="${padL - 7}" y="${Number(y) + 4}" text-anchor="end" fill="currentColor" fill-opacity="0.6" font-size="11">$${Math.round(val)}</text>`;
        }

        const xTicks = 5;
        for (let i = 0; i <= xTicks; i++) {
          const cnt = Math.round((maxX * i) / xTicks);
          const x = xAt(cnt).toFixed(1);
          gridHtml += `<text x="${x}" y="${250 - 11}" text-anchor="middle" fill="currentColor" fill-opacity="0.65" font-size="11">${cnt}${cfg.unitWord}</text>`;
        }
        svgGrid.innerHTML = gridHtml;

        // Horizontal subscription lines
        const y20 = yAt(billedSub20).toFixed(1);
        svgSub20.setAttribute('y1', y20);
        svgSub20.setAttribute('y2', y20);

        if (showSub100) {
          const y100 = yAt(billedSub100).toFixed(1);
          svgSub100.setAttribute('y1', y100);
          svgSub100.setAttribute('y2', y100);
          svgSub100.classList.remove('hidden');
        } else {
          svgSub100.classList.add('hidden');
        }

        if (showSub200) {
          const y200 = yAt(billedSub200).toFixed(1);
          svgSub200.setAttribute('y1', y200);
          svgSub200.setAttribute('y2', y200);
          svgSub200.classList.remove('hidden');
        } else {
          svgSub200.classList.add('hidden');
        }

        // Sloped API lines from (0, 0) to (maxX, costAtMaxX)
        const yZero = yAt(0).toFixed(1);
        svgUncached.setAttribute('x1', String(padL));
        svgUncached.setAttribute('y1', yZero);
        svgUncached.setAttribute('x2', String(680 - padR));
        svgUncached.setAttribute('y2', yAt(maxX * billedUncachedPerTask).toFixed(1));

        svgCached.setAttribute('x1', String(padL));
        svgCached.setAttribute('y1', yZero);
        svgCached.setAttribute('x2', String(680 - padR));
        svgCached.setAttribute('y2', yAt(apiAtMaxX).toFixed(1));

        // User position vertical line & markers
        const ux = xAt(monthlyTasks).toFixed(1);
        const uy = yAt(billedMonthlyApi).toFixed(1);
        svgUserVline.setAttribute('x1', ux);
        svgUserVline.setAttribute('x2', ux);

        let markersHtml = '';
        let labelsHtml = '';

        // Right-aligned tier labels inside plot (guard against tight vertical overlap at extreme maxY)
        const y20Num = Number(y20);
        const y100Num = Number(yAt(billedSub100));
        const y200Num = Number(yAt(billedSub200));

        if (!showSub100 || y20Num - y100Num >= 14) {
          labelsHtml += `<text x="${680 - padR - 4}" y="${y20Num - 5}" text-anchor="end" fill="#f59e0b" font-size="10.5" font-weight="700">$20 구독 (${fmtUsd(billedSub20)})</text>`;
        }
        if (showSub100 && y100Num > padT + 12 && (!showSub200 || y100Num - y200Num >= 14)) {
          labelsHtml += `<text x="${680 - padR - 4}" y="${y100Num - 5}" text-anchor="end" fill="#8b5cf6" font-size="10.5" font-weight="700">$100 구독 (${fmtUsd(billedSub100)})</text>`;
        }
        if (showSub200 && y200Num > padT + 12) {
          labelsHtml += `<text x="${680 - padR - 4}" y="${y200Num - 5}" text-anchor="end" fill="#f43f5e" font-size="10.5" font-weight="700">$200 구독 (${fmtUsd(billedSub200)})</text>`;
        }

        // Break-even intersection dots
        if (be20Exact > 0 && be20Exact <= maxX) {
          const bx20 = xAt(be20Exact).toFixed(1);
          markersHtml += `<circle cx="${bx20}" cy="${y20}" r="4.5" fill="#f59e0b" stroke="hsl(var(--card))" stroke-width="1.5" />`;
          if (!showSub100 || y20Num - y100Num >= 12) {
            const labelAnchor = be20Exact > maxX * 0.8 ? 'end' : 'start';
            const labelDx = be20Exact > maxX * 0.8 ? -6 : 6;
            const labelY = Math.min(padT + plotH - 4, y20Num + 13);
            labelsHtml += `<text x="${Number(bx20) + labelDx}" y="${labelY}" text-anchor="${labelAnchor}" fill="#f59e0b" font-size="10" font-weight="700">BE ${be20Ceil}${cfg.unitWord}</text>`;
          }
        }

        if (showSub100 && be100Exact > 0 && be100Exact <= maxX) {
          const bx100 = xAt(be100Exact).toFixed(1);
          const by100 = y100Num.toFixed(1);
          markersHtml += `<circle cx="${bx100}" cy="${by100}" r="4.5" fill="#8b5cf6" stroke="hsl(var(--card))" stroke-width="1.5" />`;
          const labelAnchor = be100Exact > maxX * 0.8 ? 'end' : 'start';
          const labelDx = be100Exact > maxX * 0.8 ? -6 : 6;
          const labelY = Math.min(padT + plotH - 4, y100Num + 13);
          labelsHtml += `<text x="${Number(bx100) + labelDx}" y="${labelY}" text-anchor="${labelAnchor}" fill="#8b5cf6" font-size="10" font-weight="700">BE ${be100Ceil}${cfg.unitWord}</text>`;
        }

        // Glowing user marker
        markersHtml += `<circle cx="${ux}" cy="${uy}" r="9" fill="#06b6d4" fill-opacity="0.22" />`;
        markersHtml += `<circle cx="${ux}" cy="${uy}" r="5" fill="#06b6d4" stroke="#ffffff" stroke-width="1.75" />`;

        if (Number(uy) >= padT + 14) {
          const uAnchor = monthlyTasks > maxX * 0.78 ? 'end' : monthlyTasks < maxX * 0.15 ? 'start' : 'middle';
          const uDx = uAnchor === 'end' ? -8 : uAnchor === 'start' ? 8 : 0;
          labelsHtml += `<text x="${Number(ux) + uDx}" y="${Math.max(padT + 12, Number(uy) - 11)}" text-anchor="${uAnchor}" fill="#06b6d4" font-size="11" font-weight="800">현재 ${monthlyTasks}${cfg.unitWord} (${fmtUsd(billedMonthlyApi)})</text>`;
        }

        svgMarkers.innerHTML = markersHtml;
        svgLabels.innerHTML = labelsHtml;

        latestState = {
          billedCachedPerTask,
          billedUncachedPerTask,
          billedSub20,
          billedSub100,
          monthlyTasks,
          maxX,
          unitWord: cfg.unitWord,
        };

        if (hoveredX !== null) {
          const clamped = Math.min(maxX, Math.max(0, hoveredX));
          const hx = xAt(clamped).toFixed(1);
          svgHoverVline.setAttribute('x1', hx);
          svgHoverVline.setAttribute('x2', hx);
          svgHoverVline.classList.remove('hidden');
          updateChartCaption(clamped, true);
        } else {
          svgHoverVline.classList.add('hidden');
          updateChartCaption(monthlyTasks, false);
        }
      }

      // Event listeners
      presetBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = (btn.dataset.preset as PresetKey) || 'agent';
          currentPreset = next;
          hoveredX = null;
          applyPresetDefaults(currentPreset);
          render();
        });
      });

      modelBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = btn.dataset.model || 'claude-opus-5-5';
          if (MODELS[next]) {
            currentModelId = next;
            hoveredX = null;
            render();
          }
        });
      });

      [dailyRange, daysRange, compRange, cacheRange, fxRange].forEach((inp) => {
        inp.addEventListener('input', () => {
          hoveredX = null;
          render();
        });
      });

      [vatChk, ttlChk, cliffChk].forEach((chk) => {
        chk.addEventListener('change', () => {
          hoveredX = null;
          render();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.ai-days-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          hoveredX = null;
          daysRange.value = btn.dataset.days || '20';
          render();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.ai-cache-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          hoveredX = null;
          cacheRange.value = btn.dataset.cache || '90';
          render();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.ai-fx-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          hoveredX = null;
          fxRange.value = btn.dataset.fx || '1400';
          render();
        });
      });

      // SVG Pointer Interaction
      const handlePointer = (clientX: number) => {
        const rect = svgEl.getBoundingClientRect();
        if (rect.width <= 0) return;
        const svgX = ((clientX - rect.left) / rect.width) * 680;
        const padL = 58;
        const plotW = 598;
        const ratio = Math.max(0, Math.min(1, (svgX - padL) / plotW));
        hoveredX = Math.round(ratio * latestState.maxX);
        const hx = (padL + (hoveredX / latestState.maxX) * plotW).toFixed(1);
        svgHoverVline.setAttribute('x1', hx);
        svgHoverVline.setAttribute('x2', hx);
        svgHoverVline.classList.remove('hidden');
        updateChartCaption(hoveredX, true);
      };

      svgHitrect.addEventListener('pointermove', (e) => handlePointer(e.clientX));
      svgHitrect.addEventListener('pointerdown', (e) => handlePointer(e.clientX));
      svgEl.addEventListener('pointerleave', () => {
        hoveredX = null;
        svgHoverVline.classList.add('hidden');
        updateChartCaption(latestState.monthlyTasks, false);
      });

      applyPresetDefaults(currentPreset);
      render();
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initAiCostCalculators)
    : initAiCostCalculators();
</script>
