  function fmtUsd(v: number): string {
    if (v < 0.01 && v > 0) return `$${v.toFixed(4)}`;
    if (v < 1) return `$${v.toFixed(2)}`;
    return `$${v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  function fmtKrw(usd: number, fx: number): string {
    const won = Math.round(usd * fx);
    return `${won.toLocaleString('ko-KR')}원`;
  }

  function fmtKrwMan(usd: number, fx: number): string {
    const won = usd * fx;
    if (won >= 10000) {
      return `약 ${(won / 10000).toFixed(1)}만 원`;
    }
    return `약 ${Math.round(won).toLocaleString('ko-KR')}원`;
  }

  function fmtTokens(tok: number): string {
    if (tok >= 1_000_000) return `${(tok / 1_000_000).toFixed(2)}M`;
    return `${Math.round(tok / 1_000)}K`;
  }

  function calcTaskCostUsd(
    preset: PresetKey,
    compVal: number,
    cachePct: number,
    model: ModelSpec,
    ttlPenalty: boolean,
    cliffActive: boolean,
  ): {
    rawCached: number;
    rawUncached: number;
    totalInputTok: number;
    outputTok: number;
  } {
    const h = Math.max(0, Math.min(0.95, cachePct / 100));
    const inCliffMult = cliffActive && model.has272kCliff ? 2.0 : 1.0;
    const outCliffMult = cliffActive && model.has272kCliff ? 1.5 : 1.0;

    const effIn = model.inputRate * inCliffMult;
    const effWrite = model.inputRate * model.cacheWriteMult * inCliffMult;
    const effRead = model.cacheReadRate * inCliffMult;
    const effOut = model.outputRate * outCliffMult;

    if (preset === 'chat') {
      // 1단계 기본: 입력 2K + 출력 1.5K (장문 할증 체크 시 280K 문서 컨텍스트 가정)
      const baseIn = cliffActive ? 280_000 : 2_000 * compVal;
      const outTok = 1_500 * (1 + (compVal - 1) * 0.35);

      const effHit = ttlPenalty ? h * 0.5 : h;
      const readTok = baseIn * effHit;
      const nonReadTok = baseIn - readTok;

      // 일반 단문 채팅은 명시적 캐시 쓰기 할증 없이 일반 입력 처리 (장문/TTL 페널티 시 캐시 쓰기 반영)
      const writeUnit = cliffActive || ttlPenalty ? effWrite : effIn;
      const rawCached =
        (nonReadTok / 1_000_000) * writeUnit +
        (readTok / 1_000_000) * effRead +
        (outTok / 1_000_000) * effOut;
      const rawUncached =
        (baseIn / 1_000_000) * effIn + (outTok / 1_000_000) * effOut;

      return { rawCached, rawUncached, totalInputTok: baseIn, outputTok: outTok };
    }

    // 에이전트 & 스웜 모드: O(K^2) 누적 컨텍스트 수식
    // K = 25일 때 C1 = 29K, delta = 4K -> 신규 쓰기 125K + 반복 프리픽스 1,800K = 누적 1,925K (1.925M), 출력 25K
    const loops = Math.max(5, Math.min(50, compVal));
    const baseC1 = cliffActive ? 280_000 : 29_000;
    const delta = 4_000;

    const uniqueWriteTok = baseC1 + (loops - 1) * delta;
    const totalInputTok = loops * baseC1 + ((loops * (loops - 1)) / 2) * delta;
    const outputTok = loops * 1_000;

    const rawUncached =
      (totalInputTok / 1_000_000) * effIn + (outputTok / 1_000_000) * effOut;

    if (h <= 0) {
      return { rawCached: rawUncached, rawUncached, totalInputTok, outputTok };
    }

    let readTok = totalInputTok * h;
    let nonReadTok = totalInputTok - readTok;
    let cacheWriteTok = Math.min(nonReadTok, uniqueWriteTok);
    let regularMissTok = Math.max(0, nonReadTok - cacheWriteTok);

    // 커피 타임 5분 TTL 만료 시: 누적된 uniqueWriteTok 만큼 캐시 읽기가 증발하고 캐시 재쓰기가 1회 추가 발생
    if (ttlPenalty) {
      const extraWrite = Math.min(readTok, uniqueWriteTok);
      readTok -= extraWrite;
      cacheWriteTok += extraWrite;
    }

    const rawCached =
      (cacheWriteTok / 1_000_000) * effWrite +
      (regularMissTok / 1_000_000) * effIn +
      (readTok / 1_000_000) * effRead +
      (outputTok / 1_000_000) * effOut;

    return { rawCached, rawUncached, totalInputTok, outputTok };
  }

  function initAiCostCalculators() {
    document.querySelectorAll<HTMLElement>('.ai-calc-root').forEach((root) => {
