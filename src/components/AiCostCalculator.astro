---
interface Props {
  defaultPreset?: 'chat' | 'agent' | 'swarm';
  defaultModel?: string;
}

const {
  defaultPreset = 'agent',
  defaultModel = 'claude-opus-5-5',
} = Astro.props;

const uid = `aic-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="ai-calc-root not-prose my-6 rounded-xl border border-border bg-card p-4 sm:p-6 text-foreground shadow-sm"
  data-default-preset={defaultPreset}
  data-default-model={defaultModel}
  data-uid={uid}
>
  <!-- 1. 상단 헤더 바 -->
  <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between border-b border-border pb-4">
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        Interactive LLM &amp; Coding Agent Break-Even Simulator
      </div>
      <div class="mt-0.5 text-base sm:text-lg font-bold text-foreground">
        AI 구독제 vs API 종량제 손익분기점 계산기
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <span class="ai-snapshot-badge inline-flex items-center rounded-md border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-700 dark:text-cyan-300">
        2026.12 정규가 기준
      </span>
    </div>
  </div>

  <!-- 2. 사용 스타일 프리셋 탭 (3종) -->
  <div class="mt-4">
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="text-xs sm:text-sm font-semibold text-foreground">
        1. 평소 AI 사용 스타일 선택
      </span>
      <span class="text-[11px] text-muted-foreground">
        토큰 수 몰라도 행동 단위로 자동 환산
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" role="tablist" aria-label="AI 사용 스타일 프리셋">
      <button
        type="button"
        role="tab"
        aria-selected={defaultPreset === 'chat'}
        data-preset="chat"
        class={defaultPreset === 'chat'
          ? 'ai-preset-btn rounded-lg border border-primary bg-primary/10 px-3 py-2.5 text-left transition cursor-pointer'
          : 'ai-preset-btn rounded-lg border border-border bg-muted/40 px-3 py-2.5 text-left transition cursor-pointer hover:bg-muted/70'}
      >
        <div class="text-xs font-bold text-foreground">💬 일반 웹 채팅·번역/요약</div>
        <div class="text-[11px] text-muted-foreground mt-0.5">단일 질문 턴 · 일 10회 × 22일</div>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected={defaultPreset === 'agent'}
        data-preset="agent"
        class={defaultPreset === 'agent'
          ? 'ai-preset-btn rounded-lg border border-primary bg-primary/10 px-3 py-2.5 text-left transition cursor-pointer'
          : 'ai-preset-btn rounded-lg border border-border bg-muted/40 px-3 py-2.5 text-left transition cursor-pointer hover:bg-muted/70'}
      >
        <div class="text-xs font-bold text-foreground">💻 데일리 코딩 에이전트</div>
        <div class="text-[11px] text-muted-foreground mt-0.5">25회 툴 루프 · 일 3태스크 × 20일</div>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected={defaultPreset === 'swarm'}
        data-preset="swarm"
        class={defaultPreset === 'swarm'
          ? 'ai-preset-btn rounded-lg border border-primary bg-primary/10 px-3 py-2.5 text-left transition cursor-pointer'
          : 'ai-preset-btn rounded-lg border border-border bg-muted/40 px-3 py-2.5 text-left transition cursor-pointer hover:bg-muted/70'}
      >
        <div class="text-xs font-bold text-foreground">🚀 풀타임 멀티 에이전트·스웜</div>
        <div class="text-[11px] text-muted-foreground mt-0.5">40회 대형 루프 · 일 8태스크 × 22일</div>
      </button>
    </div>
  </div>

  <!-- 3. 주력 모델 선택 그리드 (8종) -->
  <div class="mt-4 border-t border-border pt-4">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between mb-2">
      <span class="text-xs sm:text-sm font-semibold text-foreground">
        2. 주력 비교 모델 선택 ($ / 1M 토큰, 입·출력 정규가)
      </span>
      <span class="ai-model-sub-hint text-[11px] text-muted-foreground">
        매칭 구독: Claude Pro $20 · Max $100 · Ultra $200
      </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" role="radiogroup" aria-label="비교할 AI 모델">
      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'claude-opus-5-5'}
        data-model="claude-opus-5-5"
        class={defaultModel === 'claude-opus-5-5'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-orange-600 dark:text-orange-400">Anthropic</span>
          <span class="rounded bg-foreground/10 px-1.5 py-0.5 text-[10px] font-semibold text-foreground">데일리 1순위</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">Claude Opus 5.5</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$4 / $20 · 캐시 $0.20</div>
      </button>

      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'claude-fable-5-2'}
        data-model="claude-fable-5-2"
        class={defaultModel === 'claude-fable-5-2'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-orange-600 dark:text-orange-400">Anthropic</span>
          <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">난제 플래그십</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">Claude Fable 5.2</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$8 / $40 · 캐시 $0.20</div>
      </button>

      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'claude-sonnet-5-5'}
        data-model="claude-sonnet-5-5"
        class={defaultModel === 'claude-sonnet-5-5'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-orange-600 dark:text-orange-400">Anthropic</span>
          <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">경량 워커</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">Claude Sonnet 5.5</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$2 / $10 · 캐시 $0.10</div>
      </button>

      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'gpt-6-1-sol'}
        data-model="gpt-6-1-sol"
        class={defaultModel === 'gpt-6-1-sol'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-emerald-600 dark:text-emerald-400">OpenAI</span>
          <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">가성비 주력</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">GPT-6.1 Sol</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$2 / $10 · 캐시 $0.10</div>
      </button>

      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'gemini-4-neon'}
        data-model="gemini-4-neon"
        class={defaultModel === 'gemini-4-neon'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-blue-600 dark:text-blue-400">Google</span>
          <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">프로덕션 기본</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">Gemini 4 Neon</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$3 / $15 · 캐시 $0.15</div>
      </button>

      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'gemini-4-carbon'}
        data-model="gemini-4-carbon"
        class={defaultModel === 'gemini-4-carbon'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-blue-600 dark:text-blue-400">Google</span>
          <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">12/1 정규가</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">Gemini 4 Carbon</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$4 / $20 · 캐시 $0.20</div>
      </button>

      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'gemini-4-hydrogen'}
        data-model="gemini-4-hydrogen"
        class={defaultModel === 'gemini-4-hydrogen'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-blue-600 dark:text-blue-400">Google</span>
          <span class="rounded bg-blue-500/15 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700 dark:text-blue-300">무료 티어</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">Gemini 4 Hydrogen</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$1.5 / $7.5 · 캐시 $0.075</div>
      </button>

      <button
        type="button"
        role="radio"
        aria-checked={defaultModel === 'deepseek-v4-1-flash'}
        data-model="deepseek-v4-1-flash"
        class={defaultModel === 'deepseek-v4-1-flash'
          ? 'ai-model-btn rounded-lg border border-primary bg-primary/10 p-2.5 text-left transition cursor-pointer shadow-xs'
          : 'ai-model-btn rounded-lg border border-border bg-muted/30 p-2.5 text-left transition cursor-pointer hover:bg-muted/60'}
      >
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] font-bold uppercase tracking-tight text-cyan-600 dark:text-cyan-400">DeepSeek</span>
          <span class="rounded bg-cyan-500/15 px-1.5 py-0.5 text-[10px] font-semibold text-cyan-700 dark:text-cyan-300">초저가 API</span>
        </div>
        <div class="mt-1 text-xs font-bold text-foreground">DeepSeek V4.1 Flash</div>
        <div class="mt-0.5 text-[11px] text-muted-foreground">$0.30 / $1.20 (주말 반값)</div>
      </button>
    </div>

    <!-- 선택 모델 단가 요약 바 -->
    <div class="ai-model-spec-bar mt-2.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-lg border border-border bg-muted/30 px-3 py-2 text-[11px] sm:text-xs text-muted-foreground">
      <span>입력 $4.00 · 캐시 쓰기 $5.00(1.25×) · 캐시 읽기 $0.20 · 출력 $20.00 / 1M</span>
      <span>1M 전 구간 평탄 요금</span>
    </div>
  </div>

  <!-- 4. 핵심 행동 단위 슬라이더 3종 -->
  <div class="mt-4 grid gap-3.5 sm:grid-cols-3 border-t border-border pt-4">
    <!-- (1) 하루 평균 작업/질문 수 -->
    <div class="rounded-lg border border-border bg-muted/20 p-3">
      <div class="flex items-center justify-between gap-2">
        <label class="ai-daily-title text-xs font-semibold text-foreground" for={`${uid}-daily`}>
          하루 에이전트 작업 수
        </label>
        <span class="ai-daily-label text-xs sm:text-sm font-extrabold text-foreground">3건 / 일</span>
      </div>
      <input
        id={`${uid}-daily`}
        type="range"
        min="1"
        max="30"
        step="1"
        value="3"
        class="ai-daily-range mt-2 w-full cursor-pointer accent-cyan-600"
      />
      <div class="ai-daily-chips mt-1.5 flex flex-wrap gap-1">
        <button type="button" data-daily="1" class="ai-daily-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">1건</button>
        <button type="button" data-daily="3" class="ai-daily-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">3건</button>
        <button type="button" data-daily="8" class="ai-daily-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">8건</button>
        <button type="button" data-daily="15" class="ai-daily-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">15건</button>
      </div>
    </div>

    <!-- (2) 한 달 사용 일수 -->
    <div class="rounded-lg border border-border bg-muted/20 p-3">
      <div class="flex items-center justify-between gap-2">
        <label class="text-xs font-semibold text-foreground" for={`${uid}-days`}>
          한 달 사용 일수
        </label>
        <span class="ai-days-label text-xs sm:text-sm font-extrabold text-foreground">20일 / 월</span>
      </div>
      <input
        id={`${uid}-days`}
        type="range"
        min="1"
        max="30"
        step="1"
        value="20"
        class="ai-days-range mt-2 w-full cursor-pointer accent-cyan-600"
      />
      <div class="mt-1.5 flex flex-wrap gap-1">
        <button type="button" data-days="8" class="ai-days-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">주말만 8일</button>
        <button type="button" data-days="20" class="ai-days-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">주 5일 20일</button>
        <button type="button" data-days="30" class="ai-days-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">매일 30일</button>
      </div>
    </div>

    <!-- (3) 작업 복잡도 / 툴 호출 루프 -->
    <div class="rounded-lg border border-border bg-muted/20 p-3">
      <div class="flex items-center justify-between gap-2">
        <label class="ai-comp-title text-xs font-semibold text-foreground" for={`${uid}-comp`}>
          태스크당 툴 호출 루프
        </label>
        <span class="ai-comp-label text-xs sm:text-sm font-extrabold text-cyan-600 dark:text-cyan-400">25회 루프</span>
      </div>
      <input
        id={`${uid}-comp`}
        type="range"
        min="5"
        max="50"
        step="1"
        value="25"
        class="ai-comp-range mt-2 w-full cursor-pointer accent-cyan-600"
      />
      <div class="mt-1.5 flex flex-wrap items-center justify-between gap-1">
        <span class="ai-comp-tokens text-[11px] text-muted-foreground">누적 1.93M 입 · 25K 출</span>
        <div class="ai-comp-chips flex flex-wrap gap-1">
          <button type="button" data-comp="12" class="ai-comp-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">단순 12회</button>
          <button type="button" data-comp="25" class="ai-comp-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">표준 25회</button>
          <button type="button" data-comp="40" class="ai-comp-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">대형 40회</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. 접이식 전문가 세부 변수 조정 -->
  <details class="ai-adv-details mt-3 rounded-lg border border-border bg-muted/20 text-xs">
    <summary class="flex flex-wrap items-center justify-between gap-2 px-3.5 py-2.5 font-semibold text-foreground cursor-pointer select-none hover:bg-muted/40 rounded-lg">
      <span>전문가 세부 변수 조정: 캐시 적중률 · 환율 · 숨은 할증</span>
      <span class="ai-adv-summary-pill text-[11px] font-normal text-muted-foreground">캐시 90% · 1,400원/$ · 부가세·수수료 포함 ▾</span>
    </summary>
    <div class="border-t border-border p-3.5 space-y-3.5">
      <div class="grid gap-3.5 sm:grid-cols-2">
        <!-- 프롬프트 캐시 적중률 -->
        <div class="rounded-md border border-border bg-card p-3">
          <div class="flex items-center justify-between gap-2">
            <label class="font-semibold text-foreground" for={`${uid}-cache`}>
              프롬프트 캐시 적중률
            </label>
            <span class="ai-cache-label font-extrabold text-cyan-600 dark:text-cyan-400">90%</span>
          </div>
          <input
            id={`${uid}-cache`}
            type="range"
            min="0"
            max="95"
            step="0.5"
            value="90"
            class="ai-cache-range mt-2 w-full cursor-pointer accent-cyan-600"
          />
          <div class="mt-1.5 flex flex-wrap gap-1">
            <button type="button" data-cache="0" class="ai-cache-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">미적용 0%</button>
            <button type="button" data-cache="75" class="ai-cache-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">분산 75%</button>
            <button type="button" data-cache="90" class="ai-cache-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">실전 90%</button>
            <button type="button" data-cache="93.5" class="ai-cache-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">무중단 93.5%</button>
          </div>
        </div>

        <!-- 적용 환율 -->
        <div class="rounded-md border border-border bg-card p-3">
          <div class="flex items-center justify-between gap-2">
            <label class="font-semibold text-foreground" for={`${uid}-fx`}>
              적용 환율 (원 / USD)
            </label>
            <span class="ai-fx-label font-extrabold text-foreground">1,400원 / $</span>
          </div>
          <input
            id={`${uid}-fx`}
            type="range"
            min="1250"
            max="1600"
            step="10"
            value="1400"
            class="ai-fx-range mt-2 w-full cursor-pointer accent-slate-600"
          />
          <div class="mt-1.5 flex flex-wrap gap-1">
            <button type="button" data-fx="1350" class="ai-fx-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">1,350원</button>
            <button type="button" data-fx="1400" class="ai-fx-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">1,400원</button>
            <button type="button" data-fx="1450" class="ai-fx-chip rounded border border-border bg-background px-1.5 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">1,450원</button>
          </div>
        </div>
      </div>

      <!-- 현실 보정 체크박스 3종 -->
      <div class="space-y-2 rounded-md border border-border bg-card p-3">
        <label class="flex items-start gap-2 font-medium text-foreground cursor-pointer select-none">
          <input
