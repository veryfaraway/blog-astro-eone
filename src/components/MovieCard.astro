---
interface Props {
  title: string;
  imdbId: string;
  poster?: string;
}

interface OmdbData {
  Title: string;
  Year: string;
  Genre: string;
  Plot: string;
  Poster: string;
  imdbRating: string;
  Response: string;
}

const { title, imdbId, poster } = Astro.props;

const apiKey = import.meta.env.PUBLIC_OMDB_API_KEY;
let movie: OmdbData | null = null;

if (apiKey) {
  try {
    const res = await fetch(
      `https://www.omdbapi.com/?i=${encodeURIComponent(imdbId)}&apikey=${apiKey}`
    );
    if (res.ok) {
      const data: OmdbData = await res.json();
      if (data.Response === 'True') movie = data;
    }
  } catch {
    // fetch 실패 → graceful degradation
  }
}

const displayTitle  = movie?.Title ?? title;
const displayPoster = poster ?? (movie?.Poster !== 'N/A' ? movie?.Poster : undefined);
const year          = movie?.Year;
const genre         = movie?.Genre?.split(',')[0].trim();
const rating        = movie?.imdbRating !== 'N/A' ? movie?.imdbRating : undefined;
const plot          = movie?.Plot !== 'N/A' ? movie?.Plot : undefined;
---

<div class="not-prose my-6 overflow-hidden rounded-xl border border-border bg-card text-sm">
  <a
    href={`https://www.imdb.com/title/${imdbId}/`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex gap-4 p-4 transition-colors hover:bg-muted/50"
  >
    <!-- Poster -->
    <div class="flex h-24 w-16 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-muted text-2xl">
      {displayPoster
        ? <img src={displayPoster} alt={`${displayTitle} 포스터`} class="h-full w-full object-cover" loading="lazy" />
        : '🎬'
      }
    </div>

    <!-- Info -->
    <div class="flex min-w-0 flex-1 flex-col justify-center gap-1.5">
      <div class="flex items-start justify-between gap-2">
        <h3 class="line-clamp-2 font-semibold leading-snug text-foreground">{displayTitle}</h3>
        <span class="shrink-0 rounded bg-amber-400 px-1.5 py-0.5 text-[10px] font-bold text-black">IMDb</span>
      </div>

      <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-muted-foreground">
        {rating && (
          <span class="flex items-center gap-0.5 font-semibold text-amber-500 dark:text-amber-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            {rating}
          </span>
        )}
        {year && <span>{year}</span>}
        {genre && <span>{genre}</span>}
      </div>

      {plot && (
        <p class="line-clamp-2 text-xs leading-relaxed text-muted-foreground">{plot}</p>
      )}
    </div>
  </a>
</div>
