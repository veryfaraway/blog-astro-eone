  function initTmuxPreviews() {
    document.querySelectorAll<HTMLElement>('[data-tmux-preview]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const lang = (root.dataset.lang === 'en' ? 'en' : 'ko') as 'ko' | 'en';
      let currentTheme = root.dataset.defaultTheme || 'catppuccin';
      if (!THEMES[currentTheme]) currentTheme = 'catppuccin';
      let currentVariant = Object.keys(THEMES[currentTheme].variants)[0];
      let currentPos: 'bottom' | 'top' = 'bottom';
      let currentSep: 'rounded' | 'powerline' | 'flat' = 'rounded';
      let isPrefixActive = false;
      let activeWin = '1';
      let activePane: 'left' | 'right' = 'left';

      const terminalEl = root.querySelector<HTMLElement>('.tp-terminal')!;
      const winTitleEl = root.querySelector<HTMLElement>('.tp-window-title')!;
      const variantsWrap = root.querySelector<HTMLElement>('.tp-variants')!;
      const swatchesWrap = root.querySelector<HTMLElement>('.tp-swatches')!;
      const codeOutputEl = root.querySelector<HTMLElement>('.tp-code-output code')!;
      const hexToastEl = root.querySelector<HTMLElement>('.tp-hex-toast')!;
      const prefixBtn = root.querySelector<HTMLButtonElement>('[data-prefix-toggle]')!;
      const prefixText = root.querySelector<HTMLElement>('.tp-prefix-text')!;
      const prefixDot = root.querySelector<HTMLElement>('.tp-prefix-dot')!;
      const sessionBadge = root.querySelector<HTMLElement>('.tp-session-badge')!;
      const sessionText = root.querySelector<HTMLElement>('.tp-session-text')!;
      const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy-config]')!;

      let toastTimer: ReturnType<typeof setTimeout> | null = null;

      function showHexToast(hex: string) {
        const prefix = hexToastEl.dataset.prefix || 'Copied:';
        hexToastEl.textContent = `${prefix} ${hex}`;
        hexToastEl.style.opacity = '1';
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          hexToastEl.style.opacity = '0';
        }, 1600);
      }

      function renderVariants() {
        const themeObj = THEMES[currentTheme];
        variantsWrap.innerHTML = '';
        Object.entries(themeObj.variants).forEach(([vKey, vSpec]) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.variant = vKey;
          const active = vKey === currentVariant;
          btn.className = active
            ? 'tp-var-btn rounded-md border border-primary bg-primary/15 px-2 py-0.5 text-[11px] font-semibold text-foreground cursor-pointer transition'
            : 'tp-var-btn rounded-md border border-border bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground hover:text-foreground cursor-pointer transition';
          btn.textContent = vSpec.label;
          btn.addEventListener('click', () => {
            currentVariant = vKey;
            renderAll();
          });
          variantsWrap.appendChild(btn);
        });
      }

      function renderSwatches(palette: PaletteSpec) {
        swatchesWrap.innerHTML = '';
        palette.swatches.forEach((sw) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'tp-swatch-btn group flex flex-col items-start rounded-md border border-border bg-background p-1.5 text-left hover:border-primary transition cursor-pointer';
          btn.innerHTML = `
            <span class="h-4 w-full rounded-xs border border-black/10 dark:border-white/10" style="background-color:${sw.hex}"></span>
            <span class="mt-1 text-[10px] font-semibold text-foreground truncate w-full">${sw.label}</span>
            <span class="text-[10px] font-mono text-muted-foreground">${sw.hex}</span>
          `;
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(sw.hex);
              showHexToast(sw.hex);
            } catch {
              // ignore clipboard permission errors
            }
          });
          swatchesWrap.appendChild(btn);
        });
      }

      function renderAll() {
        const themeObj = THEMES[currentTheme];
        const palette = themeObj.variants[currentVariant];

        // 1. 테마 탭 활성 상태
        root.querySelectorAll<HTMLButtonElement>('[data-theme-btn]').forEach((btn) => {
          const isSel = btn.dataset.themeBtn === currentTheme;
          btn.setAttribute('aria-selected', isSel ? 'true' : 'false');
          btn.classList.toggle('border-primary', isSel);
          btn.classList.toggle('bg-primary/10', isSel);
          btn.classList.toggle('shadow-xs', isSel);
          btn.classList.toggle('border-border', !isSel);
          btn.classList.toggle('bg-muted/35', !isSel);
        });

        // 2. 위치 & 구분자 모드 속성 및 버튼 상태
        root.dataset.posMode = currentPos;
        root.dataset.sepMode = currentSep;

        root.querySelectorAll<HTMLButtonElement>('.tp-pos-btn').forEach((btn) => {
          const active = btn.dataset.pos === currentPos;
          btn.classList.toggle('bg-muted', active);
          btn.classList.toggle('font-semibold', active);
          btn.classList.toggle('text-foreground', active);
          btn.classList.toggle('font-medium', !active);
          btn.classList.toggle('text-muted-foreground', !active);
        });

        root.querySelectorAll<HTMLButtonElement>('.tp-sep-btn').forEach((btn) => {
          const active = btn.dataset.sep === currentSep;
          btn.classList.toggle('bg-muted', active);
          btn.classList.toggle('font-semibold', active);
          btn.classList.toggle('text-foreground', active);
          btn.classList.toggle('font-medium', !active);
          btn.classList.toggle('text-muted-foreground', !active);
        });

        // 3. CSS 변수 적용
        terminalEl.style.setProperty('--tp-bg', palette.bg);
        terminalEl.style.setProperty('--tp-mantle', palette.mantle);
        terminalEl.style.setProperty('--tp-surface', palette.surface);
        terminalEl.style.setProperty('--tp-fg', palette.fg);
        terminalEl.style.setProperty('--tp-muted', palette.muted);
        terminalEl.style.setProperty('--tp-accent', palette.accent);
        terminalEl.style.setProperty('--tp-accent-fg', palette.accentFg);
        terminalEl.style.setProperty('--tp-secondary', palette.secondary);
        terminalEl.style.setProperty('--tp-secondary-fg', palette.secondaryFg);
        terminalEl.style.setProperty('--tp-green', palette.green);
        terminalEl.style.setProperty('--tp-yellow', palette.yellow);
        terminalEl.style.setProperty('--tp-peach', palette.peach);
        terminalEl.style.setProperty('--tp-red', palette.red);
        terminalEl.style.setProperty('--tp-cyan', palette.cyan);

        winTitleEl.textContent = `ghostty — tmux · ${themeObj.title} (${palette.label})`;

        // 4. Prefix 상태 반영
        if (isPrefixActive) {
          sessionBadge.style.backgroundColor = palette.peach;
          sessionBadge.style.color = palette.accentFg;
          sessionText.textContent = 'PREFIX';
          prefixText.textContent = prefixBtn.dataset.labelActive || 'Prefix Active';
          prefixDot.className = 'tp-prefix-dot h-2 w-2 rounded-full bg-amber-500 animate-pulse';
          prefixBtn.classList.add('border-amber-500/70', 'bg-amber-500/10');
        } else {
          sessionBadge.style.backgroundColor = palette.green;
          sessionBadge.style.color = palette.accentFg;
          sessionText.textContent = 'work';
          prefixText.textContent = prefixBtn.dataset.labelIdle || 'Simulate Prefix';
          prefixDot.className = 'tp-prefix-dot h-2 w-2 rounded-full bg-emerald-500';
          prefixBtn.classList.remove('border-amber-500/70', 'bg-amber-500/10');
        }

        // 5. 윈도우 탭 활성 상태
        root.querySelectorAll<HTMLButtonElement>('.tp-win-tab').forEach((tab) => {
          const isWin = tab.dataset.win === activeWin;
          if (isWin) {
            tab.style.backgroundColor = palette.accent;
            tab.style.color = palette.accentFg;
            tab.classList.add('font-bold');
            tab.classList.remove('font-medium');
          } else {
            tab.style.backgroundColor = palette.surface;
            tab.style.color = palette.fg;
            tab.classList.remove('font-bold');
            tab.classList.add('font-medium');
          }
        });

        // 6. 분할 패인 활성 보더 상태
        root.querySelectorAll<HTMLElement>('.tp-pane').forEach((pane) => {
          const isAct = pane.dataset.pane === activePane;
          const badge = pane.querySelector<HTMLElement>('.tp-pane-badge');
          pane.style.borderColor = isAct ? palette.accent : palette.surface;
          if (badge) {
            badge.textContent = isAct ? 'ACTIVE PANE' : pane.dataset.pane === 'left' ? 'PANE 1' : 'PANE 2';
            badge.style.color = isAct ? palette.accent : palette.muted;
            badge.style.opacity = isAct ? '1' : '0.65';
          }
        });

        // 7. 플레이버 버튼, 스와치, .tmux.conf 스니펫 갱신
        renderVariants();
        renderSwatches(palette);
        codeOutputEl.textContent = themeObj.buildConfig({
          variant: currentVariant,
          pos: currentPos,
          sep: currentSep,
          lang,
        });
      }

      // 이벤트 바인딩
      root.querySelectorAll<HTMLButtonElement>('[data-theme-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = btn.dataset.themeBtn;
          if (!next || !THEMES[next]) return;
          currentTheme = next;
          currentVariant = Object.keys(THEMES[currentTheme].variants)[0];
          renderAll();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.tp-pos-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentPos = btn.dataset.pos === 'top' ? 'top' : 'bottom';
          renderAll();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.tp-sep-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const s = btn.dataset.sep;
          currentSep = s === 'powerline' || s === 'flat' ? s : 'rounded';
          renderAll();
        });
      });

      prefixBtn.addEventListener('click', () => {
        isPrefixActive = !isPrefixActive;
        renderAll();
      });

      root.querySelectorAll<HTMLButtonElement>('.tp-win-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          activeWin = tab.dataset.win || '1';
          renderAll();
        });
      });

      root.querySelectorAll<HTMLElement>('.tp-pane').forEach((pane) => {
        pane.addEventListener('click', () => {
          activePane = pane.dataset.pane === 'right' ? 'right' : 'left';
          renderAll();
        });
      });

      let copyTimer: ReturnType<typeof setTimeout> | null = null;
      copyBtn.addEventListener('click', async () => {
        const snippet = codeOutputEl.textContent || '';
        try {
          await navigator.clipboard.writeText(snippet);
          copyBtn.textContent = copyBtn.dataset.labelCopied || 'Copied ✓';
          if (copyTimer) clearTimeout(copyTimer);
          copyTimer = setTimeout(() => {
            copyBtn.textContent = copyBtn.dataset.labelIdle || 'Copy';
          }, 1600);
        } catch {
          // ignore clipboard permission errors
        }
      });

      renderAll();
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initTmuxPreviews)
    : initTmuxPreviews();
  document.addEventListener('astro:page-load', initTmuxPreviews);
</script>
