---
interface Props {
  lang?: 'ko' | 'en';
  defaultTheme?: 'catppuccin' | 'tokyo-night' | 'dracula' | 'nord' | 'gruvbox' | 'minimal';
}

const { lang = 'ko', defaultTheme = 'catppuccin' } = Astro.props;

const i18n = {
  ko: {
    eyebrow: 'Interactive Tmux Simulator',
    title: '실시간 tmux 테마 & 상태바 시뮬레이터',
    subtitle: '테마·세부 플레이버·상태바 옵션을 클릭해 색감을 비교하고, 바로 쓸 수 있는 .tmux.conf 설정을 복사하세요.',
    themeLabel: '1. 테마 선택 (TOP 5 + 보너스)',
    bonusBadge: '보너스 · 무플러그인',
    variantLabel: '팔레트 변형',
    posBottom: '상태바 하단',
    posTop: '상태바 상단',
    sepRounded: '캡슐형',
    sepPowerline: '파워라인',
    sepFlat: '플랫',
    prefixBtn: 'Prefix 입력 시뮬레이션',
    prefixActive: 'Prefix 대기 중 (C-a)',
    paletteLabel: '핵심 Hex 팔레트 (클릭 시 복사)',
    copiedHex: '복사됨:',
    configTitle: '선택한 옵션이 반영된 .tmux.conf 스니펫',
    copyBtn: '설정 복사',
    copiedBtn: '복사 완료 ✓',
    paneHint: '팁: 윈도우 탭(1～3)이나 분할 패인을 직접 클릭해 활성 강조 색상을 확인해보세요.',
  },
  en: {
    eyebrow: 'Interactive Tmux Simulator',
    title: 'Live tmux Theme & Status Bar Simulator',
    subtitle: 'Switch themes, flavors, and status bar styles side by side, then copy the generated .tmux.conf snippet.',
    themeLabel: '1. Choose Theme (TOP 5 + Bonus)',
    bonusBadge: 'Bonus · Zero-Plugin',
    variantLabel: 'Palette Flavor',
    posBottom: 'Bar: Bottom',
    posTop: 'Bar: Top',
    sepRounded: 'Rounded',
    sepPowerline: 'Powerline',
    sepFlat: 'Flat',
    prefixBtn: 'Simulate Prefix Key',
    prefixActive: 'Prefix Active (C-a)',
    paletteLabel: 'Official Hex Palette (Click to copy)',
    copiedHex: 'Copied:',
    configTitle: 'Generated .tmux.conf Snippet',
    copyBtn: 'Copy Config',
    copiedBtn: 'Copied ✓',
    paneHint: 'Tip: Click window tabs (1–3) or either split pane to test active border & tab highlights.',
  },
}[lang];

const themeButtons = [
  {
    id: 'catppuccin',
    name: '1. Catppuccin',
    tagKo: '파스텔 대세 · 4종',
    tagEn: 'Pastel · 4 Flavors',
    dots: ['#1e1e2e', '#cba6f7', '#89b4fa'],
    isBonus: false,
  },
  {
    id: 'tokyo-night',
    name: '2. Tokyo Night',
    tagKo: '네온 딥 다크 · 3종',
    tagEn: 'Neon Deep · 3 Modes',
    dots: ['#1a1b26', '#7aa2f7', '#bb9af7'],
    isBonus: false,
  },
  {
    id: 'dracula',
    name: '3. Dracula',
    tagKo: '고대비 퍼플·핑크',
    tagEn: 'High-Contrast Purple',
    dots: ['#282a36', '#bd93f9', '#ff79c6'],
    isBonus: false,
  },
  {
    id: 'nord',
    name: '4. Nord',
    tagKo: '북유럽 아이스 블루',
    tagEn: 'Arctic Frost Blue',
    dots: ['#2e3440', '#88c0d0', '#81a1c1'],
    isBonus: false,
  },
  {
    id: 'gruvbox',
    name: '5. Gruvbox',
    tagKo: '웜 레트로 · 다크/라이트',
    tagEn: 'Warm Retro · 2 Modes',
    dots: ['#282828', '#fabd2f', '#fe8019'],
    isBonus: false,
  },
  {
    id: 'minimal',
    name: lang === 'ko' ? '+ 순정 p10k 커스텀' : '+ Pure .tmux.conf',
    tagKo: '플러그인 0개 · 초경량',
    tagEn: 'Zero-Plugin · Native',
    dots: ['#181825', '#10b981', '#38bdf8'],
    isBonus: true,
  },
];
---

<div
  class="tmux-preview-root not-prose my-8 rounded-xl border border-border bg-card p-4 sm:p-6 text-foreground shadow-sm"
  data-tmux-preview
  data-lang={lang}
  data-default-theme={defaultTheme}
>
  <!-- 헤더 -->
  <div class="border-b border-border pb-4">
    <div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
      {i18n.eyebrow}
    </div>
    <div class="mt-0.5 text-base sm:text-lg font-bold text-foreground">
      {i18n.title}
    </div>
    <p class="mt-1 text-xs sm:text-sm text-muted-foreground">
      {i18n.subtitle}
    </p>
  </div>

  <!-- 1. 테마 선택 탭 -->
  <div class="mt-4">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-semibold text-foreground">{i18n.themeLabel}</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" role="tablist" aria-label={i18n.themeLabel}>
      {
        themeButtons.map((t) => {
          const isSelected = t.id === defaultTheme;
          return (
            <button
              type="button"
              role="tab"
              aria-selected={isSelected ? 'true' : 'false'}
              data-theme-btn={t.id}
              class:list={[
                'tp-theme-btn group relative flex flex-col items-start rounded-lg border px-3 py-2 text-left transition cursor-pointer',
                isSelected
                  ? 'border-primary bg-primary/10 shadow-xs'
                  : 'border-border bg-muted/35 hover:bg-muted/70',
              ]}
            >
              <div class="flex w-full items-center justify-between gap-1.5">
                <span class="text-xs font-bold text-foreground truncate">{t.name}</span>
                <span class="flex items-center gap-1 shrink-0" aria-hidden="true">
                  {t.dots.map((hex) => (
                    <span
                      class="inline-block h-2.5 w-2.5 rounded-full border border-black/15 dark:border-white/15"
                      style={`background-color:${hex}`}
                    />
                  ))}
                </span>
              </div>
              <span class="mt-0.5 text-[11px] text-muted-foreground">
                {lang === 'ko' ? t.tagKo : t.tagEn}
              </span>
            </button>
          );
        })
      }
    </div>
  </div>

  <!-- 2. 세부 플레이버 & 상태바 인터랙션 바 -->
  <div class="mt-3 flex flex-col gap-2.5 lg:flex-row lg:items-center lg:justify-between rounded-lg border border-border bg-muted/25 px-3 py-2.5">
    <!-- 좌측: 플레이버 칩 컨테이너 (JS에서 테마별로 갱신) -->
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-[11px] font-semibold text-muted-foreground mr-1">{i18n.variantLabel}:</span>
      <div class="tp-variants flex flex-wrap items-center gap-1">
        <button type="button" data-variant="mocha" class="tp-var-btn rounded-md border border-primary bg-primary/15 px-2 py-0.5 text-[11px] font-semibold text-foreground cursor-pointer">Mocha</button>
        <button type="button" data-variant="macchiato" class="tp-var-btn rounded-md border border-border bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground hover:text-foreground cursor-pointer">Macchiato</button>
        <button type="button" data-variant="frappe" class="tp-var-btn rounded-md border border-border bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground hover:text-foreground cursor-pointer">Frappé</button>
        <button type="button" data-variant="latte" class="tp-var-btn rounded-md border border-border bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground hover:text-foreground cursor-pointer">Latte</button>
      </div>
    </div>

    <!-- 우측: 상태바 위치 / 구분자 모양 / Prefix 시뮬레이션 -->
    <div class="flex flex-wrap items-center gap-1.5">
      <!-- 위치 토글 -->
      <div class="inline-flex rounded-md border border-border bg-background p-0.5" role="group">
        <button
          type="button"
          data-pos="bottom"
          class="tp-pos-btn rounded px-2 py-0.5 text-[11px] font-semibold bg-muted text-foreground cursor-pointer transition"
        >
          {i18n.posBottom}
        </button>
        <button
          type="button"
          data-pos="top"
          class="tp-pos-btn rounded px-2 py-0.5 text-[11px] font-medium text-muted-foreground hover:text-foreground cursor-pointer transition"
        >
          {i18n.posTop}
        </button>
      </div>

      <!-- 구분자 토글 -->
      <div class="inline-flex rounded-md border border-border bg-background p-0.5" role="group">
        <button
          type="button"
          data-sep="rounded"
          class="tp-sep-btn rounded px-2 py-0.5 text-[11px] font-semibold bg-muted text-foreground cursor-pointer transition"
        >
          {i18n.sepRounded}
        </button>
        <button
          type="button"
          data-sep="powerline"
          class="tp-sep-btn rounded px-2 py-0.5 text-[11px] font-medium text-muted-foreground hover:text-foreground cursor-pointer transition"
        >
          {i18n.sepPowerline}
        </button>
        <button
          type="button"
          data-sep="flat"
          class="tp-sep-btn rounded px-2 py-0.5 text-[11px] font-medium text-muted-foreground hover:text-foreground cursor-pointer transition"
        >
          {i18n.sepFlat}
        </button>
      </div>

      <!-- Prefix 키 시뮬레이션 -->
      <button
        type="button"
        data-prefix-toggle
        data-label-idle={i18n.prefixBtn}
        data-label-active={i18n.prefixActive}
        class="tp-prefix-btn inline-flex items-center gap-1 rounded-md border border-border bg-background px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition cursor-pointer"
      >
        <span class="tp-prefix-dot h-2 w-2 rounded-full bg-emerald-500 transition"></span>
        <span class="tp-prefix-text">{i18n.prefixBtn}</span>
      </button>
    </div>
  </div>

  <!-- 3. 터미널 + tmux 상태바 라이브 캔버스 -->
  <div
    class="tp-terminal mt-4 overflow-hidden rounded-xl border border-black/15 dark:border-white/15 shadow-md transition-colors duration-200"
    style="--tp-bg:#1e1e2e; --tp-mantle:#181825; --tp-surface:#313244; --tp-fg:#cdd6f4; --tp-muted:#6c7086; --tp-accent:#cba6f7; --tp-accent-fg:#11111b; --tp-secondary:#89b4fa; --tp-secondary-fg:#11111b; --tp-green:#a6e3a1; --tp-yellow:#f9e2af; --tp-peach:#fab387; --tp-red:#f38ba8; --tp-cyan:#89dceb; background-color:var(--tp-bg); color:var(--tp-fg);"
  >
    <!-- macOS 윈도우 타이틀바 -->
    <div
      class="flex items-center justify-between px-3.5 py-2 text-[11px] font-mono select-none border-b"
      style="background-color:var(--tp-mantle); color:var(--tp-muted); border-color:var(--tp-surface);"
    >
      <div class="flex items-center gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span>
      </div>
      <div class="tp-window-title truncate px-2 font-medium" style="color:var(--tp-fg); opacity:0.85;">
        ghostty — tmux · Catppuccin (Mocha)
      </div>
      <div class="text-[10px] opacity-75">UTF-8 · 24-bit RGB</div>
    </div>

    <!-- 메인 터미널 바디 (flex-col 또는 flex-col-reverse로 상태바 상/하단 전환) -->
    <div class="tp-body flex flex-col">
      <!-- 분할 패인 영역 -->
      <div class="grid grid-cols-1 md:grid-cols-12 font-mono text-[11.5px] leading-[1.6]">
        <!-- 좌측 패인: Neovim 코드 에디터 -->
        <div
          data-pane="left"
          class="tp-pane md:col-span-7 p-3 sm:p-3.5 border-b md:border-b-0 md:border-r transition-colors cursor-pointer"
          style="border-color:var(--tp-accent);"
        >
          <div class="mb-2 flex items-center justify-between text-[10px]" style="color:var(--tp-muted);">
            <span>nvim · src/server/session.ts</span>
            <span class="tp-pane-badge rounded px-1.5 py-0.5 font-semibold" style="background-color:var(--tp-surface); color:var(--tp-accent);">ACTIVE PANE</span>
          </div>
          <div class="space-y-0.5 overflow-x-auto">
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 1 </span><span style="color:var(--tp-accent)">import</span> &#123; createPool &#125; <span style="color:var(--tp-accent)">from</span> <span style="color:var(--tp-green)">'@/lib/redis'</span>;</div>
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 2 </span><span style="color:var(--tp-muted)">// Keep session TTL synced with edge cache</span></div>
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 3 </span><span style="color:var(--tp-accent)">export async function</span> <span style="color:var(--tp-secondary)">verifySession</span>(token: <span style="color:var(--tp-yellow)">string</span>) &#123;</div>
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 4 </span>  <span style="color:var(--tp-accent)">const</span> ttl = <span style="color:var(--tp-peach)">3600</span>;</div>
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 5 </span>  <span style="color:var(--tp-accent)">if</span> (!token) <span style="color:var(--tp-accent)">return</span> &#123; ok: <span style="color:var(--tp-peach)">false</span>, reason: <span style="color:var(--tp-red)">'expired'</span> &#125;;</div>
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 6 </span>  <span style="color:var(--tp-accent)">const</span> session = <span style="color:var(--tp-accent)">await</span> createPool().<span style="color:var(--tp-secondary)">get</span>(token);</div>
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 7 </span>  <span style="color:var(--tp-accent)">return</span> &#123; ok: <span style="color:var(--tp-peach)">true</span>, session, ttl &#125;;</div>
            <div class="whitespace-pre"><span style="color:var(--tp-muted)"> 8 </span>&#125;</div>
          </div>
        </div>

        <!-- 우측 패인: Shell + Git + 로그 -->
        <div
          data-pane="right"
          class="tp-pane md:col-span-5 p-3 sm:p-3.5 border-t md:border-t-0 md:border-l transition-colors cursor-pointer"
          style="border-color:var(--tp-surface);"
        >
          <div class="mb-2 flex items-center justify-between text-[10px]" style="color:var(--tp-muted);">
            <span>zsh · ~/work/blog-astro</span>
            <span class="tp-pane-badge rounded px-1.5 py-0.5 opacity-65" style="background-color:var(--tp-surface); color:var(--tp-muted);">PANE 2</span>
          </div>
          <div class="space-y-1 overflow-x-auto">
            <div class="whitespace-pre">
              <span style="color:var(--tp-secondary); font-weight:700;">~/blog-astro</span>
              <span style="color:var(--tp-accent)"> on git:main</span>
              <span style="color:var(--tp-yellow)"> *</span>
            </div>
            <div class="whitespace-pre">
              <span style="color:var(--tp-green)">❯</span> pnpm check
            </div>
            <div class="whitespace-pre" style="color:var(--tp-muted);">14:52:09 [content] Synced 64 documents</div>
            <div class="whitespace-pre" style="color:var(--tp-green);">✔ 0 errors · 0 warnings · 0 hints</div>
            <div class="pt-1 whitespace-pre">
              <span style="color:var(--tp-green)">❯</span> git status -sb
            </div>
            <div class="whitespace-pre">
              <span style="color:var(--tp-yellow)"> M</span> src/components/TmuxThemePreview.astro
            </div>
            <div class="whitespace-pre">
              <span style="color:var(--tp-cyan)">??</span> src/content/tools/en/2026/tmux-theme-top5.mdx
            </div>
          </div>
        </div>
      </div>

      <!-- tmux 상태바 (가로 스크롤 안전 래퍼) -->
      <div
        class="tp-statusbar-wrap overflow-x-auto border-t"
        style="background-color:var(--tp-mantle); border-color:var(--tp-surface); -webkit-overflow-scrolling:touch;"
      >
        <div class="tp-statusbar flex min-w-[540px] items-center justify-between px-2 py-1.5 font-mono text-[11px] select-none gap-2">
          <!-- 좌측: 세션 배지 + 윈도우 목록 -->
          <div class="flex items-center gap-1.5">
            <!-- 세션 배지 -->
            <span
              class="tp-seg tp-session-badge inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-bold transition-colors"
              style="background-color:var(--tp-green); color:var(--tp-accent-fg);"
            >
              <svg class="h-3 w-3 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M2 3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3zm2.5 2.5L7 8l-2.5 2.5 1 1L9 8 5.5 4.5l-1 1zM8.5 11h3v-1.5h-3V11z" />
              </svg>
              <span class="tp-session-text">work</span>
            </span>

            <!-- 윈도우 탭 1~3 -->
            <button
              type="button"
              data-win="1"
              class="tp-seg tp-win-tab inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-bold cursor-pointer transition-colors"
              style="background-color:var(--tp-accent); color:var(--tp-accent-fg);"
            >
              <span>1</span>
              <span>nvim*</span>
            </button>
            <button
              type="button"
              data-win="2"
              class="tp-seg tp-win-tab inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-medium cursor-pointer transition-colors"
              style="background-color:var(--tp-surface); color:var(--tp-fg);"
            >
              <span>2</span>
              <span>server</span>
            </button>
            <button
              type="button"
              data-win="3"
              class="tp-seg tp-win-tab inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-medium cursor-pointer transition-colors"
              style="background-color:var(--tp-surface); color:var(--tp-muted);"
            >
              <span>3</span>
              <span>ssh-prod-</span>
            </button>
          </div>

          <!-- 우측: 경로 · 리소스 · 시각 모듈 -->
          <div class="flex items-center gap-1.5">
            <span
              class="tp-seg inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-medium"
              style="background-color:var(--tp-surface); color:var(--tp-fg);"
            >
              <svg class="h-3 w-3 shrink-0" style="color:var(--tp-peach);" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M1.75 2.5A1.75 1.75 0 0 1 3.5.75h2.44c.46 0 .91.18 1.24.51l.94.94h4.38c.97 0 1.75.78 1.75 1.75v8.3c0 .97-.78 1.75-1.75 1.75h-9A1.75 1.75 0 0 1 1.75 12.25V2.5z" />
              </svg>
              <span>blog-astro</span>
            </span>
            <span
              class="tp-seg inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-medium"
              style="background-color:var(--tp-surface); color:var(--tp-fg);"
            >
              <span style="color:var(--tp-cyan);">CPU</span>
              <span>12%</span>
            </span>
            <span
              class="tp-seg inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 font-semibold"
              style="background-color:var(--tp-secondary); color:var(--tp-secondary-fg);"
            >
              <span>23:40</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-1.5 text-[11px] text-muted-foreground">
    {i18n.paneHint}
  </div>

  <!-- 4. 공식 팔레트 스와치 바 -->
  <div class="mt-4 rounded-lg border border-border bg-muted/20 p-3">
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="text-xs font-semibold text-foreground">{i18n.paletteLabel}</span>
      <span class="tp-hex-toast text-[11px] font-mono font-semibold text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity" data-prefix={i18n.copiedHex}></span>
    </div>
    <div class="tp-swatches grid grid-cols-4 sm:grid-cols-8 gap-1.5">
      <!-- 초기 SSR 스와치 (Catppuccin Mocha) -->
      {
        [
          { label: 'base', hex: '#1e1e2e' },
          { label: 'mantle', hex: '#181825' },
          { label: 'surface0', hex: '#313244' },
          { label: 'text', hex: '#cdd6f4' },
          { label: 'mauve', hex: '#cba6f7' },
          { label: 'blue', hex: '#89b4fa' },
          { label: 'green', hex: '#a6e3a1' },
          { label: 'peach', hex: '#fab387' },
        ].map((sw) => (
          <button
            type="button"
            data-hex={sw.hex}
            class="tp-swatch-btn group flex flex-col items-start rounded-md border border-border bg-background p-1.5 text-left hover:border-primary transition cursor-pointer"
          >
            <span
              class="h-4 w-full rounded-xs border border-black/10 dark:border-white/10"
              style={`background-color:${sw.hex}`}
            />
            <span class="mt-1 text-[10px] font-semibold text-foreground truncate w-full">{sw.label}</span>
