---
interface Props {
  tag: string;
  href?: string;
  variant?: 'default' | 'section';
}

const { tag, href, variant = 'default' } = Astro.props;
---

{href ? (
  <a
    href={href}
    class:list={[
      'inline-flex items-center px-2 py-0.5 rounded text-xs font-medium transition-colors',
      variant === 'section'
        ? 'text-foreground border'
        : 'bg-muted text-muted-foreground hover:bg-muted/80 hover:text-foreground',
    ]}
    style={variant === 'section' ? 'border-color: var(--section-accent); color: var(--section-accent);' : ''}
  >
    {tag}
  </a>
) : (
  <span
    class:list={[
      'inline-flex items-center px-2 py-0.5 rounded text-xs font-medium',
      variant === 'section'
        ? 'border'
        : 'bg-muted text-muted-foreground',
    ]}
    style={variant === 'section' ? 'border-color: var(--section-accent); color: var(--section-accent);' : ''}
  >
    {tag}
  </span>
)}
