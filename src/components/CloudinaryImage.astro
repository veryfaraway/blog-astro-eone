---
import {
  buildCloudinaryImageUrl,
  buildCloudinaryLqipUrl,
  resolveWatermarkStyle,
  type WatermarkOption,
  type WatermarkPosition,
} from '@/lib/cloudinary';

interface Props {
  publicId: string;
  alt: string;
  sizes?: string;
  width?: number;
  height?: number;
  caption?: string;
  credit?: string;
  creditUrl?: string;
  watermark?: WatermarkOption;
  watermarkPosition?: WatermarkPosition;
}

const {
  publicId,
  alt,
  sizes = '(max-width: 1200px) 100vw, 1200px',
  width,
  height,
  caption,
  credit,
  creditUrl,
  watermark,
  watermarkPosition = 'south_east',
} = Astro.props;

const cloudName = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || 'doal3ofyr';

// 외부 출처(credit)가 명시된 인용 이미지는 기본적으로 워터마크를 생략하고, 자체/생성 이미지는 낙관('nakgwan')을 기본 적용
const resolvedWatermark = resolveWatermarkStyle(watermark, credit ? false : 'nakgwan');

const src = cloudName
  ? buildCloudinaryImageUrl(publicId, {
      cloudName,
      width: 1200,
      watermark: resolvedWatermark,
      position: watermarkPosition,
    })
  : undefined;

const srcset = cloudName
  ? [400, 800, 1200, 1600]
      .map(
        (w) =>
          `${buildCloudinaryImageUrl(publicId, {
            cloudName,
            width: w,
            watermark: resolvedWatermark,
            position: watermarkPosition,
          })} ${w}w`
      )
      .join(', ')
  : undefined;

const lqip = cloudName ? buildCloudinaryLqipUrl(publicId, cloudName) : undefined;

// width/height가 있으면 aspect-ratio로 레이아웃 시프트 방지
const aspectRatio = width && height ? `${width} / ${height}` : undefined;
---

{src ? (
  <figure class="not-prose my-6">
    <div
      class="overflow-hidden rounded-lg bg-muted"
      style={[
        lqip        ? `background-image:url('${lqip}');background-size:cover;background-position:center;` : '',
        aspectRatio ? `aspect-ratio:${aspectRatio};` : '',
      ].filter(Boolean).join('')}
    >
      <img
        src={src}
        srcset={srcset}
        sizes={sizes}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class="block h-auto w-full"
      />
    </div>
    {(caption || credit) && (
      <figcaption class="mt-2 text-center text-sm text-muted-foreground">
        {caption && <span>{caption}</span>}
        {credit && (
          <span class:list={['text-xs opacity-80', caption && 'ml-1.5']}>
            (출처:{' '}
            {creditUrl ? (
              <a
                href={creditUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-2 hover:text-foreground"
              >
                {credit}
              </a>
            ) : (
              credit
            )}
            )
          </span>
        )}
      </figcaption>
    )}
  </figure>
) : (
  <div class="not-prose my-6 rounded-lg border border-dashed border-border p-4 text-center text-sm text-muted-foreground">
    PUBLIC_CLOUDINARY_CLOUD_NAME 환경변수가 설정되지 않았습니다.
  </div>
)}
