---
import { getLocalizedPath, type Locale } from '@/lib/i18n';

export interface SeriesPost {
  title: string;
  slug: string;
  section: string;
  series_order?: number;
}

interface Props {
  seriesName: string;
  posts: SeriesPost[];
  currentSlug: string;
  lang?: Locale;
}

const { seriesName, posts, currentSlug, lang = 'ko' } = Astro.props;
---

<div class="not-prose mb-10 rounded-xl overflow-hidden border border-border shadow-sm">

  <!-- Header -->
  <div class="flex items-center gap-3 px-5 py-4" style="background-color: var(--section-accent)">
    <svg
      xmlns="http://www.w3.org/2000/svg" width="18" height="18"
      viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round"
      class="shrink-0 opacity-90"
    >
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
    </svg>
    <div class="flex-1 min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wide mb-0.5" style="color: rgba(255,255,255,0.75)">시리즈</p>
      <h3 class="font-bold text-base leading-tight truncate text-white">{seriesName}</h3>
    </div>
    <span class="shrink-0 rounded-full px-3 py-0.5 text-sm font-medium text-white"
          style="background-color: rgba(255,255,255,0.2)">
      {posts.length}편
    </span>
  </div>

  <!-- Post list -->
  <ol class="bg-card">
    {posts.map((post, i) => {
      const isCurrent = post.slug === currentSlug;
      return (
        <li
          class:list={[
            'flex items-center gap-3 px-5 py-3 border-t border-border transition-colors',
            !isCurrent && 'hover:bg-muted/40',
          ]}
          style={isCurrent ? 'background-color: var(--section-accent-light, oklch(0.94 0.069 303))' : undefined}
        >
          <!-- Number badge -->
          <span
            class:list={[
              'shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold',
              isCurrent ? 'text-white' : 'bg-muted text-muted-foreground border border-border',
            ]}
            style={isCurrent ? 'background-color: var(--section-accent)' : undefined}
          >
            {i + 1}
          </span>

          {isCurrent ? (
            <Fragment>
              <span class="flex-1 text-sm font-semibold leading-snug"
                    style="color: var(--section-accent)">
                {post.title}
              </span>
              <span class="shrink-0 text-xs px-2 py-0.5 rounded-full font-medium text-white"
                    style="background-color: var(--section-accent)">
                현재
              </span>
            </Fragment>
          ) : (
            <a
              href={getLocalizedPath(lang, `${post.section}/${post.slug}`)}
              class="flex-1 text-sm text-muted-foreground hover:text-foreground transition-colors leading-snug line-clamp-1"
            >
              {post.title}
            </a>
          )}
        </li>
      );
    })}
  </ol>

</div>
