---
interface Props {
  /** 북마크할 웹페이지 URL */
  url: string;
  /** 제목 수동 지정 (생략 시 OG/HTML title 파싱, 차단 사이트 폴백용으로도 활용) */
  title?: string;
  /** 요약 설명 수동 지정 (생략 시 OG/meta description 파싱) */
  description?: string;
  /** 썸네일 이미지 수동 지정 (false 지정 시 썸네일 숨김) */
  image?: string | false;
  /** 출처 사이트명 수동 지정 */
  siteName?: string;
  /** 카드 하단 코멘트 */
  comment?: string;
  /** 추가 래퍼 클래스 */
  class?: string;
}

interface OgMetadata {
  title?: string;
  description?: string;
  image?: string;
  siteName?: string;
}

const g = globalThis as unknown as {
  __ogPreviewCache?: Map<string, Promise<OgMetadata | null>>;
};
const ogCache = (g.__ogPreviewCache ??= new Map());

function decodeEntities(raw: string): string {
  return raw
    .replace(/&amp;/gi, '&')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))
    .replace(/&#(\d+);/g, (_, dec) => String.fromCodePoint(parseInt(dec, 10)))
    .replace(/\s+/g, ' ')
    .trim();
}

function extractMetaContent(headHtml: string, keys: string[]): string | undefined {
  for (const key of keys) {
    const escaped = key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const r1 = new RegExp(
      `<meta[^>]+(?:property|name)=["']${escaped}["'][^>]+content=["']([^"']+)["'][^>]*>`,
      'i'
    );
    const m1 = headHtml.match(r1);
    if (m1?.[1]) return decodeEntities(m1[1]);

    const r2 = new RegExp(
      `<meta[^>]+content=["']([^"']+)["'][^>]+(?:property|name)=["']${escaped}["'][^>]*>`,
      'i'
    );
    const m2 = headHtml.match(r2);
    if (m2?.[1]) return decodeEntities(m2[1]);
  }
  return undefined;
}

async function fetchOgMetadata(targetUrl: string): Promise<OgMetadata | null> {
  if (!ogCache.has(targetUrl)) {
    ogCache.set(
      targetUrl,
      (async () => {
        try {
          const res = await fetch(targetUrl, {
            headers: {
              'User-Agent':
                'Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)',
              Accept: 'text/html,application/xhtml+xml',
            },
            signal: AbortSignal.timeout(3500),
          });
          if (!res.ok) return null;
          const contentType = res.headers.get('content-type') ?? '';
          if (!contentType.includes('text/html') && !contentType.includes('application/xhtml')) {
            return null;
          }

          const html = (await res.text()).slice(0, 90_000);
          const headEnd = html.toLowerCase().indexOf('</head>');
          const head = headEnd !== -1 ? html.slice(0, headEnd + 7) : html;

          const titleTag = head.match(/<title[^>]*>([\s\S]*?)<\/title>/i)?.[1];
          const title =
            extractMetaContent(head, ['og:title', 'twitter:title']) ??
            (titleTag ? decodeEntities(titleTag) : undefined);

          const description = extractMetaContent(head, [
            'og:description',
            'twitter:description',
            'description',
          ]);

          const rawImg = extractMetaContent(head, ['og:image', 'twitter:image']);
          let image: string | undefined;
          if (rawImg) {
            try {
              image = new URL(rawImg, targetUrl).toString();
            } catch {
              image = undefined;
            }
          }

          const siteName = extractMetaContent(head, ['og:site_name']);
          return { title, description, image, siteName };
        } catch {
          return null;
        }
      })()
    );
  }
  return ogCache.get(targetUrl)!;
}

const {
  url,
  title: manualTitle,
  description: manualDesc,
  image: manualImage,
  siteName: manualSiteName,
  comment,
  class: className,
} = Astro.props;

let parsedUrl: URL | null = null;
try {
  parsedUrl = new URL(url);
} catch {
  parsedUrl = null;
}

const needFetch =
  !manualTitle || (!manualDesc && manualImage === undefined);
const og = needFetch && parsedUrl ? await fetchOgMetadata(url) : null;

const hostname = parsedUrl ? parsedUrl.hostname.replace(/^www\./i, '') : url;
const displayTitle = manualTitle ?? og?.title ?? hostname;
const displayDesc = manualDesc ?? og?.description;
const displaySite = manualSiteName ?? og?.siteName ?? hostname;
const displayImage = manualImage === false ? undefined : (manualImage ?? og?.image);
const faviconUrl = parsedUrl
  ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(parsedUrl.hostname)}&sz=32`
  : undefined;
---

<div class:list={['@container not-prose my-6 overflow-hidden rounded-xl border border-border bg-card text-sm', className]}>
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-stretch justify-between gap-4 p-4 transition-colors hover:bg-muted/50"
  >
    <!-- 좌측: 제목 · 요약 · 파비콘+도메인 -->
    <div class="flex min-w-0 flex-1 flex-col justify-between gap-2">
      <div class="space-y-1">
        <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-foreground @[480px]:text-base">
          {displayTitle}
        </h3>
        {displayDesc && (
          <p class="line-clamp-2 text-xs leading-relaxed text-muted-foreground">
            {displayDesc}
          </p>
        )}
      </div>

      <div class="flex min-w-0 items-center gap-1.5 pt-0.5 text-xs text-muted-foreground">
        {faviconUrl && (
          <img src={faviconUrl} alt="" width="14" height="14" class="h-3.5 w-3.5 shrink-0 rounded-xs object-contain" loading="lazy" />
        )}
        <span class="truncate font-medium text-foreground/75">{displaySite}</span>
        {displaySite !== hostname && (
          <span class="hidden truncate font-mono text-[11px] text-muted-foreground/80 @[420px]:inline">
            · {hostname}
          </span>
        )}
      </div>
    </div>

    <!-- 우측: OG 썸네일 이미지 (있을 때만 표시) -->
    {displayImage && (
      <div class="hidden h-22 w-36 shrink-0 overflow-hidden rounded-lg border border-border/60 bg-muted @[460px]:block">
        <img
          src={displayImage}
          alt=""
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    )}
  </a>

  {comment && (
    <p class="border-t border-border px-4 py-3 text-xs leading-relaxed text-muted-foreground sm:text-sm">
      {comment}
    </p>
  )}
</div>
