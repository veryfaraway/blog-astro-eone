---
import { cn } from '../lib/utils';

interface Props {
  slot?: 'inArticle' | 'display';
  /** Overrides the slot id from env. Rarely needed. */
  adSlot?: string;
  class?: string;
}

const { slot: type = 'display', adSlot, class: className } = Astro.props;

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const isInArticle = type === 'inArticle';

// Slot ids come from env by type, so posts and layouts can just write
// <AdSlot slot="inArticle" /> without carrying ids around.
const slotId =
  adSlot ||
  (isInArticle
    ? import.meta.env.PUBLIC_ADSENSE_SLOT_INARTICLE
    : import.meta.env.PUBLIC_ADSENSE_SLOT_DISPLAY);

// AdSense 미설정 시 렌더링 안 함
if (!client || !slotId) return;
---

<div
  class={cn(
    'ad-slot not-prose w-full',
    isInArticle ? 'my-8' : 'my-6 max-w-[756px] mx-auto',
    className
  )}
  data-pagefind-ignore
>
  <ins
    class="adsbygoogle"
    style={isInArticle ? 'display:block; text-align:center;' : 'display:block'}
    data-ad-client={client}
    data-ad-slot={slotId}
    data-ad-format={isInArticle ? 'fluid' : 'auto'}
    data-ad-layout={isInArticle ? 'in-article' : undefined}
    data-full-width-responsive={isInArticle ? undefined : 'true'}
  />
</div>
