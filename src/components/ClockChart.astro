---
interface Segment {
  start: number;  // 0–24 (소수 허용, 예: 23.5)
  end: number;
  label: string;
  color: string;
}

interface Props {
  segments: Segment[];
  caption?: string;
}

const { segments, caption } = Astro.props;

const CX = 150;
const CY = 150;
const R = 118;           // 파이 반지름
const R_TEXT = 73;       // 섹터 내부 레이블 반지름 (R의 약 62%)
const R_LABEL = 136;     // 시간 레이블 반지름

function rad(hour: number): number {
  return (hour / 24) * 2 * Math.PI - Math.PI / 2;
}

function ptXY(r: number, hour: number): [number, number] {
  const a = rad(hour);
  return [CX + r * Math.cos(a), CY + r * Math.sin(a)];
}

function piePath(startH: number, endH: number): string {
  const e = endH <= startH ? endH + 24 : endH;
  const large = e - startH > 12 ? 1 : 0;
  const f = (n: number) => n.toFixed(2);
  const [x1, y1] = ptXY(R, startH);
  const [x2, y2] = ptXY(R, e);
  return `M${CX},${CY}L${f(x1)},${f(y1)}A${R},${R},0,${large},1,${f(x2)},${f(y2)}Z`;
}

function segDuration(startH: number, endH: number): number {
  return (endH <= startH ? endH + 24 : endH) - startH;
}

function midXY(startH: number, endH: number, r: number): [number, number] {
  const e = endH <= startH ? endH + 24 : endH;
  return ptXY(r, (startH + e) / 2);
}

function formatHour(h: number): string {
  const hh = Math.floor(h);
  const mm = h % 1 >= 0.5 ? '30' : '00';
  return `${hh}:${mm}`;
}

// 배경색 밝기에 따라 레이블 색상 결정
function labelColor(hex: string): string {
  const r = parseInt(hex.slice(1, 3), 16) / 255;
  const g = parseInt(hex.slice(3, 5), 16) / 255;
  const b = parseInt(hex.slice(5, 7), 16) / 255;
  const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return lum > 0.45 ? '#1a1a1a' : '#ffffff';
}

const ticks = Array.from({ length: 24 }, (_, i) => {
  const major = i % 6 === 0;
  const [x1, y1] = ptXY(R + 1, i);
  const [x2, y2] = ptXY(R + (major ? 11 : 5), i);
  return { x1, y1, x2, y2, major };
});

const majorLabels: Array<{ hour: number; text: string; anchor: string; baseline: string }> = [
  { hour: 0,  text: '자정', anchor: 'middle', baseline: 'hanging' },
  { hour: 6,  text: '6시',  anchor: 'middle', baseline: 'central' },
  { hour: 12, text: '정오', anchor: 'middle', baseline: 'auto'    },
  { hour: 18, text: '18시', anchor: 'middle', baseline: 'central' },
];

const labelNodes = majorLabels.map(({ hour, text, anchor, baseline }) => {
  const [lx, ly] = ptXY(R_LABEL, hour);
  return { lx, ly, text, anchor, baseline };
});

// 섹터 내부 레이블 (2시간 이상인 구간만)
const innerLabels = segments
  .filter(seg => segDuration(seg.start, seg.end) >= 2)
  .map(seg => {
    const [tx, ty] = midXY(seg.start, seg.end, R_TEXT);
    return { tx, ty, label: seg.label, color: labelColor(seg.color) };
  });
---

<figure class="not-prose my-6">
  <div class="flex flex-col items-center gap-4">
    <svg
      viewBox="0 0 300 300"
      class="w-full max-w-sm"
      role="img"
      aria-label={caption ?? '24시간 원형 시간표'}
    >
      {/* 파이 섹터 */}
      {segments.map(seg => (
        <path
          d={piePath(seg.start, seg.end)}
          fill={seg.color}
          stroke="white"
          stroke-width="1.5"
        />
      ))}

      {/* 눈금 */}
      {ticks.map(({ x1, y1, x2, y2, major }) => (
        <line
          x1={x1.toFixed(2)} y1={y1.toFixed(2)}
          x2={x2.toFixed(2)} y2={y2.toFixed(2)}
          stroke="currentColor"
          stroke-width={major ? '1.5' : '0.75'}
          opacity={major ? '0.4' : '0.18'}
        />
      ))}

      {/* 시간 레이블 */}
      {labelNodes.map(({ lx, ly, text, anchor, baseline }) => (
        <text
          x={lx.toFixed(2)}
          y={ly.toFixed(2)}
          text-anchor={anchor}
          dominant-baseline={baseline}
          font-size="11"
          fill="currentColor"
          opacity="0.6"
        >
          {text}
        </text>
      ))}

      {/* 섹터 내부 레이블 */}
      {innerLabels.map(({ tx, ty, label, color }) => (
        <text
          x={tx.toFixed(2)}
          y={ty.toFixed(2)}
          text-anchor="middle"
          dominant-baseline="central"
          font-size="11"
          font-weight="700"
          fill={color}
        >
          {label}
        </text>
      ))}

      {/* 중앙 점 */}
      <circle cx="150" cy="150" r="5" fill="currentColor" opacity="0.75" />
    </svg>

    {/* 범례 */}
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-1.5 text-sm">
      {segments.map(seg => (
        <div class="flex items-center gap-1.5">
          <span class="h-3 w-3 flex-shrink-0 rounded-sm" style={`background:${seg.color}`} />
          <span class="font-medium">{seg.label}</span>
          <span class="text-xs text-muted-foreground">
            {formatHour(seg.start)}–{formatHour(seg.end)}
          </span>
        </div>
      ))}
    </div>
  </div>

  {caption && (
    <figcaption class="mt-3 text-center text-xs text-muted-foreground">{caption}</figcaption>
  )}
</figure>
