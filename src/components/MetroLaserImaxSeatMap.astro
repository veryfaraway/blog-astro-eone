    width: var(--center-aisle-w);
    height: var(--row-h);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: rgba(251, 191, 36, 0.05);
    border-left: 1px dashed rgba(251, 191, 36, 0.28);
    border-right: 1px dashed rgba(251, 191, 36, 0.28);
    box-sizing: border-box;
