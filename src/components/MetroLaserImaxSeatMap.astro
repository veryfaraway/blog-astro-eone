  function isWangsimniWideSeat(theater: TheaterId, row: string, col: number): boolean {
    return (
      theater === 'wangsimni' &&
      ['A', 'C', 'E', 'G', 'I'].includes(row) &&
      (col === 15 || col === 17)
    );
  }

  function getSeatState(theater: TheaterId, row: string, col: number): SeatState {
    if (theater === 'wangsimni') {
      // 전방 A–B열 양끝 사블 비움 정규화
      if ((row === 'A' || row === 'B') && (col <= 4 || col >= 29)) return 'empty';
      return 'present';
    }

    if (theater === 'cheonho') {
      // 2025.12 리뉴얼 시 좌블 A–C열 철거 반영 (B·C열 1–10번 철거 슬롯 표시)
      if ((row === 'B' || row === 'C') && col <= 10) return 'removed';
      if (row === 'B' && col >= 32) return 'empty';
      if (row === 'P' && (col <= 5 || col >= 30)) return 'empty';
      return 'present';
    }

    if (theater === 'gwanggyo') {
      if (row === 'A' && (col <= 3 || col >= 25)) return 'empty';
      if (row === 'L' && (col <= 2 || col >= 26)) return 'empty';
      return 'present';
    }

    // yeongdeungpo
    if (row === 'A' && (col <= 3 || col >= 26)) return 'empty';
    if (row === 'N' && (col <= 2 || col >= 27)) return 'empty';
    return 'present';
  }

  function isGoldenCore(theater: TheaterId, row: string, col: number): boolean {
    if (theater === 'wangsimni') {
      return (
        (row === 'G' && (col === 15 || col === 17)) ||
        ((row === 'F' || row === 'H') && (col === 16 || col === 17))
      );
    }
    if (theater === 'cheonho') {
      return ['G', 'H', 'I'].includes(row) && (col === 17 || col === 18);
    }
    if (theater === 'gwanggyo') {
      return (row === 'G' || row === 'H') && (col === 13 || col === 14);
    }
    return (row === 'H' || row === 'I') && (col === 14 || col === 15);
  }

  function getTier(theater: TheaterId, row: string, col: number): TierKey {
    if (theater === 'wangsimni') {
      if (['A', 'B', 'C'].includes(row)) return 'avoid';
      if (col <= 4 || col >= 29) return 'avoid';

      if (['F', 'G', 'H'].includes(row)) {
        if (col >= 13 && col <= 20) return 's';
        if ((col >= 11 && col <= 12) || (col >= 21 && col <= 22)) return 'a';
        if ((col >= 8 && col <= 10) || (col >= 23 && col <= 25)) return 'b';
        return 'c'; // 5–7, 26–28 외곽 중블
      }

      if (row === 'E' || row === 'I') {
        if (col >= 12 && col <= 21) return 'a';
        if ((col >= 8 && col <= 11) || (col >= 22 && col <= 25)) return 'b';
        return 'c'; // 5–7, 26–28 외곽 중블
      }

      if (row === 'J') {
        if (col >= 11 && col <= 22) return 'b';
        return 'c'; // 5–10, 23–28 외곽 중블
      }

      // D열 중블 (5–28)
      if (row === 'D') {
        return 'c';
      }

      return 'avoid';
    }

    if (theater === 'cheonho') {
      if (['B', 'C', 'D'].includes(row)) return 'avoid';
      if (col <= 6 || col >= 30) return 'avoid';

      // 중블 11–25
      const inCenter = col >= 11 && col <= 25;
      // 사블 안쪽 7–10, 26–29
      const inInnerSide = (col >= 7 && col <= 10) || (col >= 26 && col <= 29);

      if (['G', 'H', 'I'].includes(row)) {
        if (col >= 14 && col <= 22) return 's';
        if (inCenter) return 'a'; // 11–13, 23–25
        if (inInnerSide) return 'c';
        return 'avoid';
      }

      if (row === 'F' || row === 'J') {
        if (col >= 13 && col <= 23) return 'a';
        if (inCenter) return 'b'; // 11–12, 24–25
        if (inInnerSide) return 'c';
        return 'avoid';
      }

      if (['E', 'K', 'L'].includes(row)) {
        if (inCenter) return 'b';
        if (row !== 'E' && inInnerSide) return 'c';
        return 'avoid';
      }

      // M–P열
      if (['M', 'N', 'O', 'P'].includes(row)) {
        if (inCenter) return 'c';
        if (row === 'M' && inInnerSide) return 'c';
        return 'avoid';
      }

      return 'avoid';
    }

    if (theater === 'gwanggyo') {
      if (['A', 'B', 'C'].includes(row)) return 'avoid';
      if (col <= 3 || col >= 25) return 'avoid';

      const inCenter = col >= 7 && col <= 21;
      const inInnerSide = (col >= 4 && col <= 6) || (col >= 22 && col <= 24);

      if (row === 'G' || row === 'H') {
        if (col >= 10 && col <= 18) return 's';
        if (col === 9 || col === 19) return 'a';
        if (inCenter) return 'b'; // 7–8, 20–21
        if (inInnerSide) return 'c';
        return 'avoid';
      }

      if (row === 'F' || row === 'I') {
        if (col >= 9 && col <= 19) return 'a';
        if (inCenter) return 'b'; // 7–8, 20–21
        if (inInnerSide) return 'c';
        return 'avoid';
      }

      if (['E', 'J', 'K'].includes(row)) {
        if (inCenter) return 'b';
        if (inInnerSide) return 'c';
        return 'avoid';
      }

      // D·L열
      if (row === 'D' || row === 'L') {
        if (inCenter) return 'c';
        return 'avoid';
      }

      return 'avoid';
    }

    // yeongdeungpo
    if (['A', 'B', 'C', 'D', 'E'].includes(row)) return 'avoid';
    if (col <= 3 || col >= 26) return 'avoid';

    const inCenter = col >= 7 && col <= 22;
    const inInnerSide = (col >= 4 && col <= 6) || (col >= 23 && col <= 25);

    if (row === 'H' || row === 'I') {
      if (col >= 11 && col <= 18) return 's';
      if (col === 10 || col === 19) return 'a';
      if ((col >= 8 && col <= 9) || (col >= 20 && col <= 21)) return 'b';
      if (col === 7 || col === 22 || inInnerSide) return 'c';
      return 'avoid';
    }

    if (row === 'G' || row === 'J') {
      if (col >= 10 && col <= 19) return 'a';
      if ((col >= 8 && col <= 9) || (col >= 20 && col <= 21)) return 'b';
      if (col === 7 || col === 22 || inInnerSide) return 'c';
      return 'avoid';
    }

    if (row === 'F' || row === 'K') {
      if (col >= 10 && col <= 19) return 'b';
      if (inCenter) return 'c';
      if (row === 'K' && inInnerSide) return 'c';
      return 'avoid';
    }

    // L–N열 중블
    if (['L', 'M', 'N'].includes(row)) {
      if (inCenter) return 'c';
      return 'avoid';
    }

    return 'avoid';
  }

  function getZone(theater: TheaterId, row: string, col: number): ZoneKey {
    const tier = getTier(theater, row, col);
    if (tier === 'avoid') return 'avoid';

    if (theater === 'wangsimni') {
      if (['F', 'G', 'H'].includes(row) && col >= 11 && col <= 22) return 'core';
      if ((row === 'D' || row === 'E') && col >= 8 && col <= 25) return 'imm';
      if ((row === 'I' || row === 'J') && col >= 8 && col <= 25) return 'comf';
      return 'warn'; // 외곽 중블 5–7, 26–28 등
    }

    if (theater === 'cheonho') {
      if (['G', 'H', 'I'].includes(row) && col >= 12 && col <= 24) return 'core';
      if ((row === 'E' || row === 'F') && col >= 11 && col <= 25) return 'imm';
      if (['J', 'K', 'L'].includes(row) && col >= 11 && col <= 25) return 'comf';
      return 'warn'; // M–P 원거리 중블 및 사블 안쪽
    }

    if (theater === 'gwanggyo') {
      if ((row === 'G' || row === 'H') && col >= 9 && col <= 19) return 'core';
      if ((row === 'E' || row === 'F') && col >= 7 && col <= 21) return 'imm';
      if (['I', 'J', 'K'].includes(row) && col >= 7 && col <= 21) return 'comf';
      return 'warn'; // D·L열 중블 및 사블 안쪽
    }

    // yeongdeungpo
    if ((row === 'H' || row === 'I') && col >= 10 && col <= 19) return 'core';
    if ((row === 'F' || row === 'G') && col >= 9 && col <= 20) return 'imm';
    if ((row === 'J' || row === 'K') && col >= 9 && col <= 20) return 'comf';
    return 'warn'; // L–N열 및 외곽·사블 안쪽
  }

