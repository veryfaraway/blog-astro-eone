    width: var(--seat-w);
    height: var(--seat-h);
    flex-shrink: 0;
    border-radius: 2px;
    border: 1px dashed rgba(148, 163, 184, 0.16);
    background: rgba(15, 23, 42, 0.35);
    box-sizing: border-box;
    pointer-events: none;
  }

  .mli-seat {
    appearance: none;
    border: 0;
    padding: 0;
    width: var(--seat-w);
    height: var(--seat-h);
    border-radius: 3px 3px 2px 2px;
    cursor: pointer;
    flex-shrink: 0;
    font-size: 7px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.12s ease;
    box-sizing: border-box;
    position: relative;
  }

  /* 황금 코어 좌석 (노란 인셋 보더) */
  .mli-seat.is-golden-core {
    box-shadow: inset 0 0 0 1.5px #fde047, 0 0 8px rgba(56, 189, 248, 0.45);
