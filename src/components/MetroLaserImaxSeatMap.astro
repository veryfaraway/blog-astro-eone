<script>
  type TheaterId = 'wangsimni' | 'cheonho' | 'gwanggyo' | 'yeongdeungpo';
  type ViewMode = 'tier' | 'zone';
  type TierKey = 's' | 'a' | 'b' | 'c' | 'avoid';
  type ZoneKey = 'core' | 'imm' | 'comf' | 'warn' | 'avoid';
  type SeatState = 'present' | 'empty' | 'removed';

  interface BlockSegment {
    kind: 'seats' | 'aisle' | 'center-aisle';
    cols?: number[];
    headerText?: string;
    centerTag?: string;
    isCenterBlock?: boolean;
