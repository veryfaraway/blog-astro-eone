  .mli-center-aisle::after {
    content: '';
    width: 8px;
    height: 2px;
    border-radius: 1px;
    background: rgba(251, 191, 36, 0.42);
  }

  .mli-seat-empty {
    width: var(--seat-w);
    height: var(--seat-h);
    flex-shrink: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* 천아맥 철거 좌석 슬롯 (좌블 B–C열 1–10번 시각화용) */
