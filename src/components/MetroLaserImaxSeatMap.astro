      seatsLabel: '영아맥(387석 · A–N열)',
      screenLabel: 'IMAX WITH LASER · 18.5m × 10.6m (상단 거치형 스크린 · CoLa 4K + 12채널)',
      screenCaption:
        '※ 구 SPHEREX 리뉴얼(2023.12) · 상단 거치 특성상 앞줄(A–E열) 목 꺾임 주의, H–J열 중블 수평 시야 우수',
      bannerClass: 'is-amber',
      bannerHtml:
        '⚠️ <strong>7층 12관 전용</strong>(6층 SCREENX 혼동 주의!) · 계단 바닥과 <strong>시트 등받이 알파벳 반 계단 착시</strong> 확인 필수',
      rows: ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L', 'M', 'N'],
      sweetRows: ['G', 'H', 'I', 'J'],
      centerCols: [14, 15],
      segments: [
        { kind: 'seats', cols: range(1, 6), headerText: '좌블 1–6' },
        { kind: 'aisle', headerText: '통로' },
        {
          kind: 'seats',
          cols: range(7, 22),
          headerText: '중블 7–22',
          centerTag: '14·15 정중앙',
          isCenterBlock: true,
        },
