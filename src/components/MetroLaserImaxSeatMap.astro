      if (tier === 'c') {
        return {
          desc: `${row === 'D' ? '근접 시야 부담이 시작되는 D열 중블' : row === 'L' ? '최후방 벽면 인접 L열 중블(시야는 안정적이나 후방 반사음 소폭 존재)' : '중열 사이드 블록 안쪽 통로 인접(4–6·22–24번)'}입니다.`,
          verdict: 'A–C열 앞줄보다 훨씬 쾌적한 현실적 타협선입니다.',
        };
      }

      return {
        desc: '스크린과 너무 가까운 A–C열 앞줄이거나 양 끝 극사이드(1–3·25–27번)라 시야각 왜곡이 큰 구역입니다.',
        verdict: '다른 회차 중블이나 상영 20분 전 취소표 방출 대기를 추천합니다.',
      };
    }

    // yeongdeungpo
    if (tier === 's') {
      if (col === 14 || col === 15) {
        return {
          desc: '영아맥(7층 12관) 387석의 정중앙 황금 코어(H–I열 14·15번)입니다. 비교적 높게 상단 거치된 18.5m×10.6m 레이저 스크린의 중심축과 시선이 정면으로 맞물리며 12채널 입체 음향의 밸런스가 가장 뛰어납니다.',
          verdict: '서울 서남권에서 4K 레이저 IMAX를 가장 완벽하게 즐길 수 있는 0순위 명당입니다.',
        };
      }
      return {
        desc: '영아맥 S등급 핵심 권역(H–I열 11–18번)입니다. 상단 거치 스크린 특성상 일반 상영관보다 한두 줄 뒤인 H–I열에서 목 피로 없는 최적 시야각이 완성됩니다.',
        verdict: '보이는 즉시 선점하세요(입장 시 계단 바닥 대신 시트 등받이 열 알파벳을 꼭 확인하세요!).',
      };
    }

    if (tier === 'a') {
      if (row === 'J') {
        return {
          desc: '높게 거치된 영아맥 스크린 특성상 눈높이 수평 시야와 하단 자막 가독성이 가장 편안하게 떨어지는 숨은 명당 열(J열 10–19번)입니다.',
          verdict: '3시간에 달하는 장편 대작을 목 뻐근함 제로로 관람하고 싶다면 S석 못지않은 최고의 선택입니다.',
        };
      }
      return {
        desc: '박력 있는 시야각과 12채널 사운드 직진성이 살아 있는 G열 10–19번(또는 H–I열 10·19번)입니다.',
        verdict: 'H–I열 코어가 매진되었을 때 가장 먼저 선택해야 할 A급 명당입니다.',
      };
    }

    if (tier === 'b') {
      return {
        desc: `${row === 'F' ? '상단 거치 스크린을 살짝 올려다보며 몰입하는 F열 중앙(10–19번)' : row === 'K' ? '시선이 아주 편안하고 사운드 밸런스도 준수한 K열 중앙(10–19번)' : '황금 열(G–J열) 중블 통로 인접 구역(8–9·20–21번)'}입니다.`,
        verdict: '피크타임 예매 시 충분히 돈값을 해내는 추천 좌석입니다.',
      };
    }

    if (tier === 'c') {
      return {
        desc: `${['L', 'M', 'N'].includes(row) ? '후방(L–N열) 중블이라 18.5m 스크린이 다소 아담하게 느껴지지만 시선 높이는 매우 편안한 구역' : 'F·K열 중블 외곽 또는 중열 사이드 블록 안쪽(4–6·23–25번)'}입니다.`,
        verdict: '영아맥은 앞줄(A–E열) 목 꺾임이 심하므로 매진 시 앞줄 대신 반드시 이 구역으로 우회하세요.',
      };
    }

    return {
      desc: `${['A', 'B', 'C', 'D', 'E'].includes(row) ? '영아맥은 스크린이 높게 상단 거치되어 있어 E열 이하 앞줄에 앉으면 러닝타임 내내 고개를 심하게 젖혀야 하는 목 꺾임 위험 구역' : '양 끝 극사이드(1–3·26–28번)라 측면 왜곡이 큰 구역'}입니다.`,
      verdict: '일반 관의 E열 감각으로 예매하면 후회하기 쉽습니다. 최소 G–K열 취소표를 노리세요.',
    };
  }

  function initMetroLaserImaxMaps() {
    document.querySelectorAll<HTMLElement>('[data-mli-map]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const blockHeadersEl = root.querySelector<HTMLElement>('[data-mli-block-headers]')!;
      const colsEl = root.querySelector<HTMLElement>('[data-mli-cols]')!;
      const gridEl = root.querySelector<HTMLElement>('[data-mli-grid]')!;
      const legendEl = root.querySelector<HTMLElement>('[data-mli-legend]')!;
      const bannerEl = root.querySelector<HTMLElement>('[data-mli-banner]')!;
      const tooltipEl = root.querySelector<HTMLElement>('[data-mli-tooltip]')!;
      const screenBoxEl = root.querySelector<HTMLElement>('[data-mli-screen-box]')!;
      const screenLabelEl = root.querySelector<HTMLElement>('[data-mli-screen-label]')!;
      const screenCapEl = root.querySelector<HTMLElement>('[data-mli-screen-caption]')!;

      const theaterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.mli-theater-tab'));
      const modeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.mli-mode-tab'));

      let currentTheater: TheaterId = 'wangsimni';
      let currentMode: ViewMode = 'tier';
      let pinnedKey: string | null = null;
      const seatButtons = new Map<string, HTMLButtonElement>();

      function calcBlockWidthCss(count: number): string {
        return `calc(${count} * var(--seat-w) + ${count - 1} * var(--seat-gap))`;
      }

      function buildHeaders() {
        const spec = THEATER_SPECS[currentTheater];
        blockHeadersEl.innerHTML = '';
        colsEl.innerHTML = '';

        const spBhL = document.createElement('div');
        spBhL.className = 'mli-label-spacer';
        blockHeadersEl.appendChild(spBhL);

        const spColL = document.createElement('div');
        spColL.className = 'mli-label-spacer';
        colsEl.appendChild(spColL);

        spec.segments.forEach((seg) => {
          if (seg.kind === 'aisle') {
            const ah = document.createElement('div');
            ah.className = 'mli-aisle-hd';
            ah.textContent = seg.headerText || '통로';
            blockHeadersEl.appendChild(ah);

            const ac = document.createElement('div');
            ac.className = 'mli-col-aisle';
            colsEl.appendChild(ac);
            return;
          }

          if (seg.kind === 'center-aisle') {
            const cah = document.createElement('div');
            cah.className = 'mli-center-aisle-hd';
            cah.textContent = seg.headerText || '중앙통로';
            blockHeadersEl.appendChild(cah);

            const cac = document.createElement('div');
            cac.className = 'mli-col-center-aisle';
            colsEl.appendChild(cac);
            return;
          }

          const cols = seg.cols || [];
          const bh = document.createElement('div');
          bh.style.width = calcBlockWidthCss(cols.length);

          if (seg.isCenterBlock && seg.centerTag) {
            bh.className = 'mli-bh mli-bh-center';
            bh.innerHTML = `<span>${seg.headerText}</span><span class="mli-center-tag">${seg.centerTag}</span>`;
          } else if (seg.isCenterBlock) {
            bh.className = 'mli-bh mli-bh-center mli-bh-center-single';
            bh.innerHTML = `<span>${seg.headerText}</span>`;
          } else {
            bh.className = 'mli-bh';
            bh.textContent = seg.headerText || '';
          }
          blockHeadersEl.appendChild(bh);

          const colBlk = document.createElement('div');
          colBlk.className = 'mli-col-block';
          cols.forEach((c) => {
            const cn = document.createElement('div');
            cn.className = `mli-col-num${spec.centerCols.includes(c) ? ' is-center-col' : ''}`;
            cn.textContent = String(c);
            colBlk.appendChild(cn);
          });
          colsEl.appendChild(colBlk);
        });

        const spBhR = document.createElement('div');
        spBhR.className = 'mli-label-spacer-r';
        blockHeadersEl.appendChild(spBhR);

        const spColR = document.createElement('div');
        spColR.className = 'mli-label-spacer-r';
        colsEl.appendChild(spColR);
      }

      function updateScreenAndMeta() {
        const spec = THEATER_SPECS[currentTheater];
        root.setAttribute('data-theater-active', currentTheater);
        screenBoxEl.className = `mli-screen-box is-${currentTheater}`;
        screenLabelEl.textContent = spec.screenLabel;
        screenCapEl.textContent = spec.screenCaption;
        gridEl.setAttribute('aria-label', spec.fullName);
        legendEl.innerHTML = buildLegendHtml(currentMode, currentTheater);
        bannerEl.innerHTML = `<div class="mli-struct-pill ${spec.bannerClass}">${spec.bannerHtml}</div>`;
      }

      function getSeatClass(row: string, col: number, key: string): string {
        const tier = getTier(currentTheater, row, col);
        const zone = getZone(currentTheater, row, col);
        const colorCls =
          currentMode === 'tier' ? `mli-c-tier-${tier}` : `mli-c-zone-${zone}`;
        const coreCls = isGoldenCore(currentTheater, row, col) ? ' is-golden-core' : '';
        const wideCls = isWangsimniWideSeat(currentTheater, row, col) ? ' is-wide-seat' : '';
        const pinCls = pinnedKey === key ? ' is-pinned' : '';
        return `mli-seat ${colorCls}${coreCls}${wideCls}${pinCls}`;
      }

      function applySeatClasses() {
        seatButtons.forEach((btn, key) => {
          const [row, colStr] = key.split('-');
          const col = Number(colStr);
          btn.className = getSeatClass(row, col, key);
          btn.setAttribute('aria-pressed', pinnedKey === key ? 'true' : 'false');
        });
      }

      function renderTooltip(row: string, col: number, pinned: boolean) {
        const spec = THEATER_SPECS[currentTheater];
        const tier = getTier(currentTheater, row, col);
        const zone = getZone(currentTheater, row, col);
        const posText = getBlockPositionText(currentTheater, col);
        const { desc, verdict } = getSeatDetail(currentTheater, row, col, tier);
        const wide = isWangsimniWideSeat(currentTheater, row, col);

        const pinHint = pinned
          ? ' <span style="font-size:10px;color:#94a3b8;font-weight:500">(고정됨 · 재클릭 또는 Esc로 해제)</span>'
          : '';
        const zoneChipCls = zone === 'warn' ? 'mli-chip mli-chip-warn' : 'mli-chip mli-chip-zone';
        const wideChip = wide
          ? '<span class="mli-chip mli-chip-wide">1.5배 와이드석 (지그재그)</span>'
          : '';

        tooltipEl.innerHTML = `
          <div class="mli-tt-top">
            <span class="mli-tt-theater">${spec.shortName}</span>
            <span class="mli-tt-coord">${row}열 ${col}번${pinHint}</span>
            <span class="mli-chip mli-chip-tier">${TIER_LABELS[tier]}</span>
            ${wideChip}
            <span class="${zoneChipCls}">${ZONE_LABELS[zone]} · ${posText}</span>
          </div>
          <div class="mli-tt-desc">${desc}</div>
          <div class="mli-tt-verdict">⚡ 예매 판단: ${verdict}</div>
        `;
      }

      function restoreDefaultOrPinned() {
        if (pinnedKey) {
          const [r, cStr] = pinnedKey.split('-');
          renderTooltip(r, Number(cStr), true);
        } else {
          const spec = THEATER_SPECS[currentTheater];
          tooltipEl.innerHTML = `현재 <strong>${spec.seatsLabel}</strong> 배치도입니다. 좌석에 마우스를 올리거나 탭하면 <strong>추천 등급 · 시야/단차/12채널 음향 체감 · 한 줄 예매 판단</strong>이 표시됩니다.`;
        }
      }

      function buildGrid() {
        const spec = THEATER_SPECS[currentTheater];
        gridEl.innerHTML = '';
        seatButtons.clear();

        spec.rows.forEach((row) => {
          const rowEl = document.createElement('div');
          rowEl.className = 'mli-seat-row';

          const sweetRow = spec.sweetRows.includes(row);
          const lblL = document.createElement('div');
          lblL.className = `mli-row-label mli-row-label-l${sweetRow ? ' is-sweet-row' : ''}`;
          lblL.textContent = row;
          rowEl.appendChild(lblL);

          spec.segments.forEach((seg) => {
            if (seg.kind === 'aisle') {
              const a = document.createElement('div');
              a.className = 'mli-aisle';
              a.setAttribute('aria-hidden', 'true');
              rowEl.appendChild(a);
              return;
            }

            if (seg.kind === 'center-aisle') {
              const ca = document.createElement('div');
              ca.className = 'mli-center-aisle';
              ca.setAttribute('aria-hidden', 'true');
              ca.title = '왕아맥 정중앙(16|17번) 계단 통로';
              rowEl.appendChild(ca);
              return;
            }

            const blk = document.createElement('div');
            blk.className = 'mli-block';
            (seg.cols || []).forEach((col) => {
              const state = getSeatState(currentTheater, row, col);
              if (state === 'empty') {
                const empty = document.createElement('div');
                empty.className = 'mli-seat-empty';
                empty.setAttribute('aria-hidden', 'true');
                blk.appendChild(empty);
                return;
              }
              if (state === 'removed') {
                const rem = document.createElement('div');
                rem.className = 'mli-seat-removed';
                rem.setAttribute('aria-hidden', 'true');
                rem.title = '2025.12 레이저 리뉴얼 시 철거된 좌석 구역';
                blk.appendChild(rem);
                return;
              }

              const key = `${row}-${col}`;
              const tier = getTier(currentTheater, row, col);
              const wide = isWangsimniWideSeat(currentTheater, row, col);
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.dataset.seat = key;
              btn.className = getSeatClass(row, col, key);
              btn.setAttribute('aria-pressed', 'false');
              btn.setAttribute(
                'aria-label',
                `${spec.shortName} ${row}열 ${col}번${wide ? ' 와이드석' : ''}, ${TIER_LABELS[tier]}`
              );
              btn.textContent = String(col);

              btn.addEventListener('mouseenter', () => {
                renderTooltip(row, col, pinnedKey === key);
              });
              btn.addEventListener('mouseleave', () => {
                restoreDefaultOrPinned();
              });
              btn.addEventListener('focus', () => {
                renderTooltip(row, col, pinnedKey === key);
              });
              btn.addEventListener('blur', () => {
                restoreDefaultOrPinned();
              });
              btn.addEventListener('click', () => {
                pinnedKey = pinnedKey === key ? null : key;
                applySeatClasses();
                restoreDefaultOrPinned();
              });

              seatButtons.set(key, btn);
              blk.appendChild(btn);
            });

            rowEl.appendChild(blk);
          });

          const lblR = document.createElement('div');
          lblR.className = `mli-row-label mli-row-label-r${sweetRow ? ' is-sweet-row' : ''}`;
          lblR.setAttribute('aria-hidden', 'true');
          lblR.textContent = row;
          rowEl.appendChild(lblR);

          gridEl.appendChild(rowEl);
        });
      }

      // 초기 렌더링
      updateScreenAndMeta();
      buildHeaders();
      buildGrid();
      restoreDefaultOrPinned();

      // 상영관 탭 전환
      theaterBtns.forEach((tab) => {
        tab.addEventListener('click', () => {
          const nextTheater = tab.dataset.theater as TheaterId;
          if (!nextTheater || nextTheater === currentTheater) return;
          currentTheater = nextTheater;
          pinnedKey = null;

          theaterBtns.forEach((b) => {
            const active = b === tab;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });

          updateScreenAndMeta();
          buildHeaders();
          buildGrid();
          restoreDefaultOrPinned();
        });
      });

      // 보기 모드 토글
      modeBtns.forEach((tab) => {
        tab.addEventListener('click', () => {
          const nextMode = tab.dataset.mode as ViewMode;
          if (!nextMode || nextMode === currentMode) return;
          currentMode = nextMode;

          modeBtns.forEach((b) => {
            const active = b === tab;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-selected', active ? 'true' : 'false');
          });

          legendEl.innerHTML = buildLegendHtml(currentMode, currentTheater);
          applySeatClasses();
        });
      });

      // Escape 키 고정 해제 (연결 해제 시 리스너 자동 정리)
      const onKeyDown = (e: KeyboardEvent) => {
        if (!root.isConnected) {
          document.removeEventListener('keydown', onKeyDown);
          return;
        }
        if (e.key === 'Escape' && pinnedKey !== null) {
          pinnedKey = null;
          applySeatClasses();
          restoreDefaultOrPinned();
        }
      };
      document.addEventListener('keydown', onKeyDown);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMetroLaserImaxMaps);
  } else {
    initMetroLaserImaxMaps();
  }
  document.addEventListener('astro:page-load', initMetroLaserImaxMaps);
</script>
