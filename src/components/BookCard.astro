---
interface Props {
  /** 도서 제목 (API 미조회·실패 시 폴백으로도 사용) */
  title: string;
  /** ISBN13 또는 ISBN10 (하이픈 유무 무관, 비워두면 API 조회를 건너뛰고 수동 Props만 표시) */
  isbn13?: string;
  /** 저자 수동 지정 (지정 시 API 조회값보다 우선) */
  author?: string;
  /** 출판사 수동 지정 */
  publisher?: string;
  /** 표지 이미지 URL 수동 지정 */
  cover?: string;
  /** 판매가/정가 수동 지정 (숫자 입력 시 원화 포맷, 문자열 입력 시 그대로 표시) */
  price?: number | string;
  /** 카드 하단 전체 폭으로 표시할 짧은 추천 코멘트 (2~3문장 이내 권장) */
  comment?: string;
  /** 알라딘 상품 링크 (직접 지정 시 우선, 생략 시 ISBN 기반 일반 도서 정보 링크 제공) */
  aladinHref?: string;
  /** 교보문고 상품 링크 (선택) */
  kyoboHref?: string;
  /** 예스24 상품 링크 (선택) */
  yes24Href?: string;
  /** 쿠팡 파트너스 제휴 링크 (선택 — 사용 시 포스트 frontmatter에 affiliate: true 권장) */
  coupangHref?: string;
  /** Amazon 제휴/상품 링크 (선택 — 사용 시 포스트 frontmatter에 affiliate: true 권장) */
  amazonHref?: string;
  /** 표시 언어 ('ko' 기본, 영문 포스트에서는 'en' 지정 시 버튼·폴백 문구 영문 전환) */
  lang?: 'ko' | 'en';
  /** 추가 래퍼 클래스 */
  class?: string;
}

interface BookMeta {
  title?: string;
  author?: string;
  publisher?: string;
  pubYear?: string;
  cover?: string;
  price?: number;
  infoUrl?: string;
}

interface KakaoBookResponse {
  documents?: Array<{
    title?: string;
    authors?: string[];
    translators?: string[];
    publisher?: string;
    datetime?: string;
    price?: number;
    sale_price?: number;
    thumbnail?: string;
    url?: string;
  }>;
}

interface GoogleBooksResponse {
  items?: Array<{
    volumeInfo?: {
      title?: string;
      authors?: string[];
      publisher?: string;
      publishedDate?: string;
      infoLink?: string;
      imageLinks?: {
        thumbnail?: string;
        smallThumbnail?: string;
      };
    };
  }>;
}

const g = globalThis as unknown as {
  __bookMetaCache?: Map<string, Promise<BookMeta | null>>;
};
const bookCache = (g.__bookMetaCache ??= new Map());

function normalizeKakaoThumb(url?: string): string | undefined {
  if (!url) return undefined;
  return url.replace(/^http:\/\//i, 'https://');
}

async function fetchKakaoBook(isbn: string, apiKey: string): Promise<BookMeta | null> {
  try {
    const res = await fetch(
      `https://dapi.kakao.com/v3/search/book?target=isbn&query=${encodeURIComponent(isbn)}`,
      {
        headers: { Authorization: `KakaoAK ${apiKey}` },
        signal: AbortSignal.timeout(4000),
      }
    );
    if (!res.ok) return null;
    const data = (await res.json()) as KakaoBookResponse;
    const doc = data.documents?.[0];
    if (!doc) return null;

    const authors = doc.authors?.filter(Boolean) ?? [];
    const translators = doc.translators?.filter(Boolean) ?? [];
    const authorText =
      authors.length > 0
        ? translators.length > 0
          ? `${authors.join(', ')} (${translators.join(', ')} 옮김)`
          : authors.join(', ')
        : undefined;

    const effectivePrice =
      typeof doc.sale_price === 'number' && doc.sale_price > 0
        ? doc.sale_price
        : typeof doc.price === 'number' && doc.price > 0
          ? doc.price
          : undefined;

    return {
      title: doc.title,
      author: authorText,
      publisher: doc.publisher || undefined,
      pubYear: doc.datetime ? doc.datetime.slice(0, 4) : undefined,
      cover: normalizeKakaoThumb(doc.thumbnail),
      price: effectivePrice,
      infoUrl: doc.url,
    };
  } catch {
    return null;
  }
}

async function fetchGoogleBook(isbn: string): Promise<BookMeta | null> {
  try {
    const res = await fetch(
      `https://www.googleapis.com/books/v1/volumes?q=isbn:${encodeURIComponent(isbn)}`,
      { signal: AbortSignal.timeout(4000) }
    );
    if (!res.ok) return null;
    const data = (await res.json()) as GoogleBooksResponse;
    const info = data.items?.[0]?.volumeInfo;
    if (!info) return null;

    const rawThumb = info.imageLinks?.thumbnail ?? info.imageLinks?.smallThumbnail;
    const secureCover = rawThumb ? rawThumb.replace(/^http:\/\//i, 'https://') : undefined;

    return {
      title: info.title,
      author: info.authors?.length ? info.authors.join(', ') : undefined,
      publisher: info.publisher,
      pubYear: info.publishedDate?.slice(0, 4),
      cover: secureCover,
      infoUrl: info.infoLink,
    };
  } catch {
    return null;
  }
}

async function resolveBookByIsbn(rawIsbn: string, lang: 'ko' | 'en' = 'ko'): Promise<BookMeta | null> {
  const cacheKey = `${lang}:${rawIsbn}`;
  if (!bookCache.has(cacheKey)) {
    bookCache.set(
      cacheKey,
      (async () => {
        // 영문 모드(lang="en")는 영문 메타데이터·표지를 위해 Google Books를 1순위로 조회
        if (lang === 'en') {
          const google = await fetchGoogleBook(rawIsbn);
          if (google) return google;
        }

        const kakaoKey =
          import.meta.env.KAKAO_REST_API_KEY ||
          import.meta.env.PUBLIC_KAKAO_REST_API_KEY ||
          process.env.KAKAO_REST_API_KEY;

        // 한국어 모드 1순위: 카카오 책 검색 API (국내 도서 커버리지 최상)
        if (kakaoKey) {
          const kakao = await fetchKakaoBook(rawIsbn, kakaoKey);
          if (kakao) return kakao;
        }

        // 폴백: Google Books 무인증 조회 (해외 원서 및 키 미설정 환경)
        return lang === 'en' ? null : await fetchGoogleBook(rawIsbn);
      })()
    );
  }
  return bookCache.get(cacheKey)!;
}

const {
  title,
  isbn13 = '',
  author: manualAuthor,
  publisher: manualPublisher,
  cover: manualCover,
  price: manualPrice,
  comment,
  aladinHref,
  kyoboHref,
  yes24Href,
  coupangHref,
  amazonHref,
  lang = 'ko',
  class: className,
} = Astro.props;

const isEn = lang === 'en';
const cleanIsbn = isbn13.replace(/[-\s]/g, '').trim();
const isValidIsbn = /^(?:\d{10}|\d{13}|\d{9}[\dXx])$/.test(cleanIsbn);

const fetched = isValidIsbn ? await resolveBookByIsbn(cleanIsbn, lang) : null;

const displayTitle = title || fetched?.title || (isEn ? 'Book Info' : '도서 정보');
const displayAuthor = manualAuthor ?? fetched?.author;
const displayPublisher = manualPublisher ?? fetched?.publisher;
const pubYear = fetched?.pubYear;
const displayCover = manualCover ?? fetched?.cover;

const formattedPrice =
  manualPrice !== undefined
    ? typeof manualPrice === 'number'
      ? isEn
        ? `$${manualPrice.toLocaleString('en-US')}`
        : `${manualPrice.toLocaleString('ko-KR')}원`
      : manualPrice
    : !isEn && fetched?.price !== undefined && fetched.price > 0
      ? `${fetched.price.toLocaleString('ko-KR')}원`
      : undefined;

// 우측 구매·정보 버튼 목록 구성 (지정된 서점·제휴 링크 우선, 아무 링크도 없고 ISBN만 있으면 기본 도서 정보 링크 폴백)
interface ActionBtn {
  label: string;
  subText: string;
  href: string;
  badgeBg: string;
  badgeTextColor?: string;
  isAffiliate?: boolean;
}

const actions: ActionBtn[] = [];
if (coupangHref) {
  actions.push({
    label: isEn ? 'Coupang' : '쿠팡',
    subText: isEn ? 'Buy' : '구매하기',
    href: coupangHref,
    badgeBg: '#E94B22',
    isAffiliate: true,
  });
}
if (amazonHref) {
  actions.push({
    label: 'Amazon',
    subText: isEn ? 'Buy' : '구매하기',
    href: amazonHref,
    badgeBg: '#FF9900',
    badgeTextColor: '#171717',
    isAffiliate: true,
  });
}
if (aladinHref) {
  actions.push({
    label: isEn ? 'Aladin' : '알라딘',
    subText: isEn ? 'View' : '보러가기',
    href: aladinHref,
    badgeBg: '#2F9DDC',
  });
}
if (kyoboHref) {
  actions.push({
    label: isEn ? 'Kyobo' : '교보문고',
    subText: isEn ? 'View' : '보러가기',
    href: kyoboHref,
    badgeBg: '#474C98',
  });
}
if (yes24Href) {
  actions.push({
    label: 'YES24',
    subText: isEn ? 'View' : '보러가기',
    href: yes24Href,
    badgeBg: '#196AB3',
  });
}

if (actions.length === 0 && isValidIsbn) {
  if (isEn) {
    actions.push(
      fetched?.infoUrl
        ? {
            label: 'Google',
            subText: 'Book Info',
            href: fetched.infoUrl,
            badgeBg: '#4285F4',
          }
        : {
            label: 'Amazon',
            subText: 'Search',
            href: `https://www.amazon.com/s?k=${encodeURIComponent(cleanIsbn)}`,
            badgeBg: '#FF9900',
            badgeTextColor: '#171717',
          }
    );
  } else {
    const isKoreanIsbn = cleanIsbn.startsWith('97889') || cleanIsbn.startsWith('97911');
    actions.push(
      isKoreanIsbn
        ? {
            label: '알라딘',
            subText: '도서 정보',
            href: `https://www.aladin.co.kr/shop/wproduct.aspx?ISBN=${encodeURIComponent(cleanIsbn)}`,
            badgeBg: '#2F9DDC',
          }
        : {
            label: '교보문고',
            subText: '도서 검색',
            href: `https://search.kyobobook.co.kr/search?keyword=${encodeURIComponent(cleanIsbn)}`,
            badgeBg: '#474C98',
          }
    );
  }
}
---

<div class:list={['@container not-prose my-6 overflow-hidden rounded-xl border border-border bg-card p-4 text-sm', className]}>
  <!-- 1행: (표지 + 도서 메타데이터) | 서점·구매 버튼 -->
  <div class="flex flex-col gap-4 @[480px]:flex-row @[480px]:items-stretch">
    <div class="flex min-w-0 flex-1 items-center gap-4">
      <!-- Cover -->
      <div class="flex h-28 w-20 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-border/60 bg-muted text-2xl shadow-2xs">
        {displayCover ? (
          <img
            src={displayCover}
            alt={isEn ? `${displayTitle} cover` : `${displayTitle} 표지`}
            class="h-full w-full object-cover"
            loading="lazy"
            referrerpolicy="no-referrer"
          />
        ) : (
          '📖'
        )}
      </div>

      <!-- Info -->
      <div class="flex min-w-0 flex-1 flex-col justify-center gap-1.5">
        <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-foreground @[480px]:text-base">
          {displayTitle}
        </h3>

        {(displayAuthor || displayPublisher || pubYear) && (
          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-muted-foreground">
            {displayAuthor && <span class="line-clamp-1">{displayAuthor}</span>}
            {displayPublisher && <span>· {displayPublisher}</span>}
            {pubYear && <span class="font-mono text-[11px]">({pubYear})</span>}
          </div>
        )}

        {formattedPrice && (
          <p class="font-mono text-sm font-semibold tabular-nums text-foreground">
            {formattedPrice}
          </p>
        )}
      </div>
    </div>

    <!-- 우측(좁은 폭에서는 하단 가로열): 서점/구매 버튼 -->
    {actions.length > 0 && (
      <div class="flex shrink-0 flex-row gap-2 border-t border-border pt-3 @[480px]:w-26 @[480px]:flex-col @[480px]:justify-center @[480px]:border-l @[480px]:border-t-0 @[480px]:pl-4 @[480px]:pt-0">
        {actions.map((btn) => (
          <a
            href={btn.href}
            target="_blank"
            rel={btn.isAffiliate ? 'noopener noreferrer nofollow' : 'noopener noreferrer'}
            class="flex flex-1 flex-row items-center justify-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-muted @[480px]:flex-initial @[480px]:flex-col @[480px]:gap-1 @[480px]:px-2"
          >
            <span
              class="rounded px-1.5 py-0.5 text-[9px] font-bold"
              style={`background-color: ${btn.badgeBg}; color: ${btn.badgeTextColor ?? '#ffffff'};`}
            >
              {btn.label}
            </span>
            <span>{btn.subText}</span>
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- 2행: 추천 코멘트 (카드 전체 폭) -->
  {comment && (
    <p class="mt-3 border-t border-border pt-3 text-xs leading-relaxed text-muted-foreground sm:text-sm">
      {comment}
    </p>
  )}
</div>
