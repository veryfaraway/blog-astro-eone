        inHevEff.value = String(p.hevEff);
        inHevCc.value = String(p.hevCc);
        inHevMaint.value = String(p.hevMaint);

        if (applyModelY) {
          inEvPrice.value = String(MODEL_Y_SPEC.evPrice);
          inEvSub.value = String(MODEL_Y_SPEC.evSub);
          inEvEff.value = String(MODEL_Y_SPEC.evEff);
          inEvMaint.value = String(MODEL_Y_SPEC.evMaint);
        } else {
          inEvPrice.value = String(p.evPrice);
          inEvSub.value = String(p.evSub);
          inEvEff.value = String(p.evEff);
          inEvMaint.value = String(p.evMaint);
        }
        isCustomEdited = false;
      }

      function syncSegmentUI() {
        segBtns.forEach((btn) => {
          const active = btn.dataset.segment === currentSegment;
          btn.setAttribute('aria-selected', String(active));
          btn.className = active
            ? 'ev-seg-btn rounded-lg border border-primary bg-primary/10 px-3 py-2 text-left transition cursor-pointer'
