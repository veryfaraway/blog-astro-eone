---
interface Props {
  defaultPreset?: 'compact' | 'midsize-suv' | 'fullsize';
  defaultAnnualKm?: number;
  defaultYears?: number;
}

const {
  defaultPreset = 'midsize-suv',
  defaultAnnualKm = 15000,
  defaultYears = 5,
} = Astro.props;

const uid = `evc-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="ev-calc-root not-prose my-6 rounded-xl border border-border bg-card p-4 sm:p-6 text-foreground shadow-sm"
  data-default-preset={defaultPreset}
  data-default-km={defaultAnnualKm}
  data-default-years={defaultYears}
>
  <!-- 1. 상단 헤더 + 실시간 유가/보조금 확인 바로가기 -->
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-border pb-4">
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        2026 Tax · Subsidy · TCO Breakeven Simulator
      </div>
      <div class="mt-0.5 text-base sm:text-lg font-bold text-foreground">
        전기차 vs 하이브리드 vs 가솔린 손익분기 계산기
      </div>
    </div>
    <div class="flex flex-wrap gap-2 shrink-0">
      <a
        href="https://www.opinet.co.kr/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border bg-muted/60 px-3 py-1.5 text-xs font-semibold text-foreground transition hover:bg-muted"
      >
        <span>오피넷 전국 유가</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href="https://www.ev.or.kr/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white shadow-xs transition hover:bg-emerald-700"
      >
        <span>무공해차 보조금 조회</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <!-- 2. 차급 프리셋 탭 + 모델 Y RWD 서브 프리셋 -->
  <div class="mt-4">
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="text-xs sm:text-sm font-semibold text-foreground">
        1. 비교 차급 선택 (2026 연식 실거래 트림 기준)
      </span>
      <span class="ev-custom-badge hidden rounded bg-amber-500/15 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:text-amber-400">
        직접 수정 견적 반영 중
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" role="tablist" aria-label="차급 프리셋">
      <button
        type="button"
        role="tab"
        aria-selected={defaultPreset === 'compact'}
        data-segment="compact"
        class="ev-seg-btn rounded-lg border border-border bg-muted/40 px-3 py-2 text-left transition cursor-pointer hover:bg-muted/70"
      >
        <div class="text-xs font-bold text-foreground">준중형 엔트리</div>
        <div class="text-[11px] text-muted-foreground mt-0.5">아반떼 1.6 · HEV vs EV3</div>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected={defaultPreset === 'midsize-suv'}
        data-segment="midsize-suv"
        class="ev-seg-btn rounded-lg border border-primary bg-primary/10 px-3 py-2 text-left transition cursor-pointer"
      >
        <div class="text-xs font-bold text-foreground">중형 패밀리 SUV</div>
        <div class="text-[11px] text-muted-foreground mt-0.5">쏘렌토 2.5T · HEV vs 아이오닉 5</div>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected={defaultPreset === 'fullsize'}
        data-segment="fullsize"
        class="ev-seg-btn rounded-lg border border-border bg-muted/40 px-3 py-2 text-left transition cursor-pointer hover:bg-muted/70"
      >
        <div class="text-xs font-bold text-foreground">준대형 세단·크로스오버</div>
        <div class="text-[11px] text-muted-foreground mt-0.5">그랜저 2.5 · HEV vs 더 뉴 EV6</div>
      </button>
    </div>

    <!-- 선택된 모델 요약 + 테슬라 모델 Y RWD 스왑 칩 -->
    <div class="mt-2.5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between rounded-lg border border-border bg-muted/30 px-3 py-2">
      <div class="ev-model-summary flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] sm:text-xs text-muted-foreground">
        <span><strong class="text-orange-600 dark:text-orange-400">가솔린</strong> 더 뉴 쏘렌토 2.5T</span>
        <span><strong class="text-blue-600 dark:text-blue-400">HEV</strong> 쏘렌토 1.6T HEV</span>
        <span><strong class="text-emerald-600 dark:text-emerald-400">EV</strong> 아이오닉 5 E-Lite</span>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <button
          type="button"
          class="ev-modely-btn rounded-md border border-border bg-background px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition cursor-pointer"
        >
          ⚡ 모델 Y RWD 대입 (보조금 300만)
        </button>
      </div>
    </div>
  </div>

  <!-- 3. 핵심 주행·충전 슬라이더 4종 -->
  <div class="mt-5 grid gap-4 sm:grid-cols-2 border-t border-border pt-4">
    <!-- (1) 연간 주행거리 -->
    <div class="rounded-lg border border-border bg-muted/20 p-3">
      <div class="flex items-center justify-between gap-2">
        <label class="text-xs sm:text-sm font-semibold text-foreground" for={`${uid}-km`}>
          연간 주행거리
        </label>
        <span class="ev-km-label text-sm font-extrabold text-foreground">15,000 km / 년</span>
      </div>
      <input
        id={`${uid}-km`}
        type="range"
        min="5000"
        max="40000"
        step="1000"
        value={defaultAnnualKm}
        class="ev-km-range mt-2 w-full cursor-pointer accent-emerald-600"
      />
      <div class="mt-1.5 flex flex-wrap items-center justify-between gap-1">
        <span class="text-[11px] text-muted-foreground">빠른 대입:</span>
        <div class="flex flex-wrap gap-1">
          <button type="button" data-km="8000" class="ev-km-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">8천km</button>
          <button type="button" data-km="15000" class="ev-km-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">1.5만km</button>
          <button type="button" data-km="25000" class="ev-km-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground cursor-pointer hover:text-foreground">2.5만km</button>
          <button type="button" data-km="35000" class="ev-km-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground cursor-pointer hover:text-foreground">3.5만km</button>
        </div>
      </div>
    </div>

    <!-- (2) 목표 보유 기간 -->
    <div class="rounded-lg border border-border bg-muted/20 p-3">
      <div class="flex items-center justify-between gap-2">
        <label class="text-xs sm:text-sm font-semibold text-foreground" for={`${uid}-years`}>
          목표 보유 기간
        </label>
        <span class="ev-years-label text-sm font-extrabold text-foreground">5년 (총 7.5만 km)</span>
      </div>
      <input
        id={`${uid}-years`}
        type="range"
        min="1"
        max="10"
        step="1"
        value={defaultYears}
        class="ev-years-range mt-2 w-full cursor-pointer accent-blue-600"
      />
      <div class="mt-1.5 flex flex-wrap items-center justify-between gap-1">
        <span class="text-[11px] text-muted-foreground">빠른 선택:</span>
        <div class="flex flex-wrap gap-1">
          <button type="button" data-years="3" class="ev-years-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">3년</button>
          <button type="button" data-years="5" class="ev-years-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">5년</button>
          <button type="button" data-years="7" class="ev-years-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">7년</button>
          <button type="button" data-years="10" class="ev-years-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">10년</button>
        </div>
      </div>
    </div>

    <!-- (3) 전기차 집밥(완속) 충전 비중 -->
    <div class="rounded-lg border border-border bg-muted/20 p-3">
      <div class="flex items-center justify-between gap-2">
        <label class="text-xs sm:text-sm font-semibold text-foreground" for={`${uid}-home`}>
          전기차 '집밥'(완속) 비중
        </label>
        <span class="ev-home-label text-xs sm:text-sm font-extrabold text-emerald-600 dark:text-emerald-400">
          80% · 평균 301원/kWh
        </span>
      </div>
      <input
        id={`${uid}-home`}
        type="range"
        min="0"
        max="100"
        step="10"
        value="80"
        class="ev-home-range mt-2 w-full cursor-pointer accent-emerald-600"
      />
      <div class="mt-1.5 flex flex-wrap items-center justify-between gap-1">
        <span class="text-[11px] text-muted-foreground">완속 285원 · 급속 365원:</span>
        <div class="flex flex-wrap gap-1">
          <button type="button" data-home="90" class="ev-home-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">집밥 90%</button>
          <button type="button" data-home="50" class="ev-home-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">반반 50%</button>
          <button type="button" data-home="0" class="ev-home-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">집밥 없음(급속 100%)</button>
        </div>
      </div>
    </div>

    <!-- (4) 보통휘발유 단가 -->
    <div class="rounded-lg border border-border bg-muted/20 p-3">
      <div class="flex items-center justify-between gap-2">
        <label class="text-xs sm:text-sm font-semibold text-foreground" for={`${uid}-fuel`}>
          보통휘발유 단가
        </label>
        <span class="ev-fuel-label text-sm font-extrabold text-orange-600 dark:text-orange-400">
          1,800원 / L
        </span>
      </div>
      <input
        id={`${uid}-fuel`}
        type="range"
        min="1500"
        max="2200"
        step="10"
        value="1800"
        class="ev-fuel-range mt-2 w-full cursor-pointer accent-orange-500"
      />
      <div class="mt-1.5 flex flex-wrap items-center justify-between gap-1">
        <span class="text-[11px] text-muted-foreground">유가 시나리오:</span>
        <div class="flex flex-wrap gap-1">
          <button type="button" data-fuel="1650" class="ev-fuel-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">안정 1,650원</button>
          <button type="button" data-fuel="1800" class="ev-fuel-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">평균 1,800원</button>
          <button type="button" data-fuel="2050" class="ev-fuel-chip rounded border border-border bg-background px-2 py-0.5 text-[11px] text-muted-foreground hover:text-foreground cursor-pointer">고유가 2,050원</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 현실 보정 체크박스 2종 -->
  <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-5 rounded-lg border border-border bg-muted/30 px-3.5 py-2.5">
    <label class="inline-flex items-center gap-2 text-xs font-medium text-foreground cursor-pointer select-none">
      <input
        type="checkbox"
        checked
        class="ev-winter-chk h-4 w-4 rounded border-border accent-emerald-600 cursor-pointer"
      />
      <span>겨울철·사계절 실전비 보정 <span class="text-muted-foreground">(전기차 공인전비 -8% 적용)</span></span>
    </label>
    <label class="inline-flex items-center gap-2 text-xs font-medium text-foreground cursor-pointer select-none">
      <input
        type="checkbox"
        class="ev-conv-chk h-4 w-4 rounded border-border accent-emerald-600 cursor-pointer"
      />
      <span>2026 내연기관차 전환지원금 <span class="text-muted-foreground">(3년↑ 가솔린·디젤 처분 시 보조금 +100만 원)</span></span>
    </label>
  </div>

  <!-- 5. 접이식 내 견적 직접 입력 패널 -->
  <details class="ev-custom-details mt-3 rounded-lg border border-border bg-muted/20 text-xs">
    <summary class="flex items-center justify-between px-3.5 py-2.5 font-semibold text-foreground cursor-pointer select-none hover:bg-muted/40 rounded-lg">
      <span>내 대리점 견적서·지자체 보조금 직접 입력하기 (선택)</span>
      <span class="text-[11px] font-normal text-muted-foreground">출고가 · 보조금 · 연비 · 소모품 수정 ▾</span>
    </summary>
    <div class="border-t border-border p-3.5">
      <div class="grid gap-3 md:grid-cols-3">
        <!-- 가솔린 입력 -->
        <div class="rounded-md border border-border bg-card p-2.5 space-y-2">
          <div class="font-bold text-orange-600 dark:text-orange-400">가솔린 제원·견적</div>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">출고가(만 원)</span>
            <input type="number" step="10" min="1000" max="30000" value="3966" class="ev-in-gas-price w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">복합연비(km/L)</span>
            <input type="number" step="0.1" min="4" max="35" value="10.8" class="ev-in-gas-eff w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">배기량(cc)</span>
            <input type="number" step="1" min="800" max="6500" value="2497" class="ev-in-gas-cc w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">연 소모품(만 원)</span>
            <input type="number" step="1" min="0" max="500" value="50" class="ev-in-gas-maint w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
        </div>

        <!-- 하이브리드 입력 -->
        <div class="rounded-md border border-border bg-card p-2.5 space-y-2">
          <div class="font-bold text-blue-600 dark:text-blue-400">하이브리드 제원·견적</div>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">세제후 출고가(만)</span>
            <input type="number" step="10" min="1000" max="30000" value="4260" class="ev-in-hev-price w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">복합연비(km/L)</span>
            <input type="number" step="0.1" min="5" max="40" value="15.7" class="ev-in-hev-eff w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">배기량(cc)</span>
            <input type="number" step="1" min="800" max="6500" value="1598" class="ev-in-hev-cc w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">연 소모품(만 원)</span>
            <input type="number" step="1" min="0" max="500" value="42" class="ev-in-hev-maint w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
        </div>

        <!-- 전기차 입력 -->
        <div class="rounded-md border border-border bg-card p-2.5 space-y-2">
          <div class="font-bold text-emerald-600 dark:text-emerald-400">전기차 제원·견적</div>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">세제후 출고가(만)</span>
            <input type="number" step="10" min="1000" max="30000" value="5064" class="ev-in-ev-price w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">국비+지방비(만)</span>
            <input type="number" step="10" min="0" max="5000" value="780" class="ev-in-ev-sub w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">복합전비(km/kWh)</span>
            <input type="number" step="0.1" min="2" max="12" value="5.2" class="ev-in-ev-eff w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
          <label class="flex items-center justify-between gap-2">
            <span class="text-muted-foreground">연 소모품(만 원)</span>
            <input type="number" step="1" min="0" max="500" value="30" class="ev-in-ev-maint w-24 rounded border border-border bg-background px-2 py-1 text-right font-semibold text-foreground" />
          </label>
        </div>
      </div>
      <div class="mt-2.5 flex items-center justify-between text-[11px] text-muted-foreground">
        <span>※ 전기차 취득세 과세표준은 보조금 차감 전 출고가 기준으로 산정 후 최대 140만 원이 감면됩니다.</span>
        <button type="button" class="ev-reset-custom rounded border border-border bg-background px-2.5 py-1 font-semibold text-foreground hover:bg-muted cursor-pointer shrink-0">
          프리셋 기본값 복원
        </button>
      </div>
    </div>
  </details>

  <!-- ==================== 출력 영역 ==================== -->

  <!-- 1. 핵심 판독 배너 -->
  <div class="mt-5 rounded-xl border border-border bg-muted/40 p-4" aria-live="polite">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="ev-verdict-sub text-xs font-medium text-muted-foreground">
          5년 보유 · 총 7.5만 km 주행 기준 총소유비용(TCO) 1위
        </div>
        <div class="mt-1 flex flex-wrap items-baseline gap-2">
          <span class="ev-verdict-winner text-lg sm:text-xl font-extrabold text-emerald-600 dark:text-emerald-400">
            전기차 (아이오닉 5 E-Lite) 가장 유리
          </span>
          <span class="ev-verdict-save rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-bold text-emerald-700 dark:text-emerald-400">
            2위 하이브리드보다 584.5만 원 절약
          </span>
        </div>
      </div>
      <div class="ev-verdict-3rd text-xs text-muted-foreground sm:text-right">
        3위 가솔린 대비 <strong class="text-foreground">870.4만 원</strong> 절약
      </div>
    </div>
    <p class="ev-verdict-comment mt-2.5 border-t border-border/70 pt-2.5 text-xs leading-relaxed text-muted-foreground">
      보조금 780만 원과 취득세 140만 원 감면 덕분에 초기 취등록 포함 실구매가부터 하이브리드보다 저렴하게 출발하며, 연간 100만 원 이상 적은 유지비로 격차를 벌립니다.
    </p>
  </div>

  <!-- 손익분기 카드 3종 -->
  <div class="mt-3 grid gap-3 sm:grid-cols-3">
    <div class="rounded-lg border border-border bg-muted/30 p-3.5">
      <div class="flex items-center justify-between text-[11px] font-semibold text-muted-foreground">
