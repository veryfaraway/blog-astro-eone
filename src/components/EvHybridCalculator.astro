      // Custom quote inputs
      const inGasPrice = root.querySelector<HTMLInputElement>('.ev-in-gas-price')!;
      const inGasEff = root.querySelector<HTMLInputElement>('.ev-in-gas-eff')!;
      const inGasCc = root.querySelector<HTMLInputElement>('.ev-in-gas-cc')!;
      const inGasMaint = root.querySelector<HTMLInputElement>('.ev-in-gas-maint')!;

      const inHevPrice = root.querySelector<HTMLInputElement>('.ev-in-hev-price')!;
      const inHevEff = root.querySelector<HTMLInputElement>('.ev-in-hev-eff')!;
      const inHevCc = root.querySelector<HTMLInputElement>('.ev-in-hev-cc')!;
