  function calcIceBaseTaxWon(cc: number): number {
    if (cc <= 1000) return cc * 104;
    if (cc <= 1600) return cc * 182;
    return cc * 260;
  }

  function calcAgeDiscount(year: number): number {
    if (year <= 2) return 1;
    return Math.max(0.5, 1 - (year - 2) * 0.05);
  }

  function fmtManwon(v: number): string {
    const r = Math.round(v * 10) / 10;
    return `${r.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}만 원`;
  }

  function fmtManwonShort(v: number): string {
    const r = Math.round(v * 10) / 10;
    return `${r.toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}만`;
  }

  function calcBreakeven(
    targetTco: number[],
    baseTco: number[],
    annualKm: number,
  ): { main: string; sub: string; isImmediate: boolean; isNever: boolean } {
    const diff0 = targetTco[0] - baseTco[0];
    if (diff0 <= 0) {
      // 초기 실구매부터 이미 저렴하거나 동일한 경우
      for (let y = 1; y <= 10; y++) {
        const dPrev = targetTco[y - 1] - baseTco[y - 1];
        const dCurr = targetTco[y] - baseTco[y];
        if (dPrev <= 0 && dCurr > 0) {
          const frac = Math.abs(dPrev) / (Math.abs(dPrev) + dCurr);
          const yr = (y - 1) + frac;
          return {
            main: `초기 우위 → ${yr.toFixed(1)}년 역전`,
            sub: `초기 ${fmtManwonShort(Math.abs(diff0))} 저렴하나 유지비로 역전`,
            isImmediate: false,
            isNever: true,
          };
        }
      }
      return {
        main: '출고 즉시 이득',
        sub: diff0 < -0.05 ? `0년 차 초기 비용부터 ${fmtManwon(Math.abs(diff0))} 저렴` : '초기 실구매가 동일 · 유지비 즉시 절감',
        isImmediate: true,
        isNever: false,
      };
    }

    for (let y = 1; y <= 10; y++) {
      const dPrev = targetTco[y - 1] - baseTco[y - 1];
      const dCurr = targetTco[y] - baseTco[y];
      if (dPrev > 0 && dCurr <= 0) {
        const frac = dPrev / (dPrev - dCurr);
        const exactYr = (y - 1) + frac;
        const exactKm = exactYr * annualKm;
        const kmStr =
          exactKm >= 10000
            ? `약 ${(exactKm / 10000).toFixed(1)}만 km`
            : `약 ${Math.round(exactKm / 100) * 100}km`;
        return {
          main: `${exactYr.toFixed(1)}년 · ${kmStr}`,
          sub: `초기 차액 +${fmtManwon(diff0)} 회수 시점`,
          isImmediate: false,
          isNever: false,
        };
      }
    }

    const diff10 = targetTco[10] - baseTco[10];
    return {
      main: '10년 내 회수 불가',
      sub: `10년 운행 후에도 +${fmtManwon(diff10)} 더 지출`,
      isImmediate: false,
      isNever: true,
    };
  }

