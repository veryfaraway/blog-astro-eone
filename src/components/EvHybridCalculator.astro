      function numVal(el: HTMLInputElement, fallback: number, min = 0, max = 100000): number {
        const v = parseFloat(el.value);
        if (!Number.isFinite(v)) return fallback;
        return Math.min(max, Math.max(min, v));
      }

      let lastGasTco: number[] = [];
      let lastHevTco: number[] = [];
      let lastEvTco: number[] = [];

      function updateCaptionForYear(yr: number, annualKm: number) {
        const totalManKm = ((yr * annualKm) / 10000).toFixed(1);
        const prefix = yr === 0 ? '[0년 차 · 초기 실구매가]' : `[${yr}년 차 · ${totalManKm}만 km]`;
        chartCaption.textContent = `${prefix} 가솔린 ${fmtManwonShort(lastGasTco[yr])} · 하이브리드 ${fmtManwonShort(lastHevTco[yr])} · 전기차 ${fmtManwonShort(lastEvTco[yr])} 원`;
      }

      function render() {
        syncSegmentUI();

        const annualKm = Math.max(1000, parseInt(kmRange.value, 10) || 15000);
        const targetYears = Math.max(1, Math.min(10, parseInt(yearsRange.value, 10) || 5));
        const homePct = Math.max(0, Math.min(100, parseInt(homeRange.value, 10) || 0));
        const homeRatio = homePct / 100;
        const fuelPrice = Math.max(1000, parseInt(fuelRange.value, 10) || 1800);
        const winterAdjust = winterChk.checked;
        const conversionBonus = convChk.checked;

        const blendedElecPrice = Math.round(homeRatio * HOME_ELEC_KRW + (1 - homeRatio) * FAST_ELEC_KRW);

        // Update slider labels
        kmLabel.textContent = `${annualKm.toLocaleString()} km / 년`;
        yearsLabel.textContent = `${targetYears}년 (총 ${((annualKm * targetYears) / 10000).toFixed(1)}만 km)`;
        homeLabel.textContent = `${homePct}% · 평균 ${blendedElecPrice}원/kWh`;
        fuelLabel.textContent = `${fuelPrice.toLocaleString()}원 / L`;

        // Specs
        const gasPrice = numVal(inGasPrice, 3966, 100);
        const gasEff = numVal(inGasEff, 10.8, 1);
        const gasCc = numVal(inGasCc, 2497, 100);
        const gasMaint = numVal(inGasMaint, 50, 0);

        const hevPrice = numVal(inHevPrice, 4260, 100);
        const hevEff = numVal(inHevEff, 15.7, 1);
        const hevCc = numVal(inHevCc, 1598, 100);
        const hevMaint = numVal(inHevMaint, 42, 0);

        const evSticker = numVal(inEvPrice, 5064, 100);
        const evSubsidy = numVal(inEvSub, 780, 0);
        const evEffRaw = numVal(inEvEff, 5.2, 0.5);
        const evMaint = numVal(inEvMaint, 30, 0);

        // 2026 Acquisition tax (won -> manwon)
        const gasAcqTax = Math.round(((gasPrice * 10000) / 1.1) * 0.07) / 10000;
        const hevAcqTax = Math.round(((hevPrice * 10000) / 1.1) * 0.07) / 10000;
        const evAcqTax =
          Math.max(0, Math.round(((evSticker * 10000) / 1.1) * 0.07) - 1400000) / 10000;

        // Year 0 initial purchase total
        const gasInit = gasPrice + gasAcqTax;
        const hevInit = hevPrice + hevAcqTax;
        const evNetVehicle = Math.max(0, evSticker - evSubsidy - (conversionBonus ? 100 : 0));
        const evInit = evNetVehicle + evAcqTax;

        // Annual energy cost (manwon)
        const gasFuelYr = ((annualKm / gasEff) * fuelPrice) / 10000;
        const hevFuelYr = ((annualKm / hevEff) * fuelPrice) / 10000;
        const effectiveEvEff = winterAdjust ? evEffRaw * 0.92 : evEffRaw;
        const evFuelYr = ((annualKm / effectiveEvEff) * blendedElecPrice) / 10000;

        // Base annual auto tax (manwon)
        const gasBaseTax = calcIceBaseTaxWon(gasCc) / 10000;
        const hevBaseTax = calcIceBaseTaxWon(hevCc) / 10000;
        const evTax = 13.0;

        const gasTco: number[] = [gasInit];
        const hevTco: number[] = [hevInit];
        const evTco: number[] = [evInit];

        for (let y = 1; y <= 10; y++) {
          const disc = calcAgeDiscount(y);
          gasTco.push(gasTco[y - 1] + gasBaseTax * disc + gasFuelYr + gasMaint);
          hevTco.push(hevTco[y - 1] + hevBaseTax * disc + hevFuelYr + hevMaint);
          evTco.push(evTco[y - 1] + evTax + evFuelYr + evMaint);
        }

        lastGasTco = gasTco;
        lastHevTco = hevTco;
        lastEvTco = evTco;

        const p = PRESETS[currentSegment];
        const names = {
          gas: isCustomEdited ? '가솔린' : `가솔린 (${p.gasName})`,
          hev: isCustomEdited ? '하이브리드' : `하이브리드 (${p.hevName})`,
          ev: isCustomEdited
            ? '전기차'
            : `전기차 (${isModelYActive ? MODEL_Y_SPEC.evName : p.evName})`,
        };

        // Rank at targetYears
        const ranking = [
          {
            key: 'gas' as const,
            short: '가솔린',
            full: names.gas,
            tco: gasTco[targetYears],
            textCls: 'text-orange-600 dark:text-orange-400',
            badgeCls: 'bg-orange-500/15 text-orange-700 dark:text-orange-400',
          },
          {
            key: 'hev' as const,
            short: '하이브리드',
            full: names.hev,
            tco: hevTco[targetYears],
            textCls: 'text-blue-600 dark:text-blue-400',
            badgeCls: 'bg-blue-500/15 text-blue-700 dark:text-blue-400',
          },
          {
            key: 'ev' as const,
            short: '전기차',
            full: names.ev,
            tco: evTco[targetYears],
            textCls: 'text-emerald-600 dark:text-emerald-400',
            badgeCls: 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-400',
          },
        ].sort((a, b) => a.tco - b.tco);

        const first = ranking[0];
        const second = ranking[1];
        const third = ranking[2];

        const totalKmMan = ((annualKm * targetYears) / 10000).toFixed(1);
        verdictSub.textContent = `${targetYears}년 보유 · 총 ${totalKmMan}만 km 주행 기준 총소유비용(TCO) 1위`;
        verdictWinner.textContent = `${first.full} 가장 유리`;
        verdictWinner.className = `ev-verdict-winner text-lg sm:text-xl font-extrabold ${first.textCls}`;
        verdictSave.textContent = `2위 ${second.short}보다 ${fmtManwon(second.tco - first.tco)} 절약`;
        verdictSave.className = `ev-verdict-save rounded-md px-2 py-0.5 text-xs font-bold ${first.badgeCls}`;
        verdict3rd.innerHTML = `3위 ${third.short} 대비 <strong class="text-foreground">${fmtManwon(third.tco - first.tco)}</strong> 절약`;

        // Contextual diagnosis comment
        if (first.key === 'gas') {
          verdictComment.textContent =
            '연간 주행거리가 짧거나 상위 파워트레인과의 초기 출고가·취득세 격차가 커서, 아낀 유류비보다 처음에 덜 낸 차값이 더 크게 남는 실속 구간입니다.';
        } else if (first.key === 'hev') {
          verdictComment.textContent =
            homePct <= 30
              ? '공용 급속 충전 비중이 높거나 전기차 보조금이 적어 하이브리드의 가성비가 빛나는 조건입니다. 충전 스트레스 없이 세금·유류비를 동시에 방어할 수 있습니다.'
              : '1.6 터보 다운사이징 자동차세 절감과 높은 복합연비가 시너지를 내며 초기 차값 차액을 안정적으로 회수하는 구간입니다.';
        } else {
          verdictComment.textContent =
            evInit <= hevInit
              ? '국고·지자체 보조금과 취득세 최대 140만 원 감면이 맞물려 초기 실구매가부터 하이브리드 이하로 내려왔습니다. 타면 탈수록 유지비 격차가 벌어집니다.'
              : '초기 실구매가는 더 높지만, 완속 집밥 충전 단가와 연 13만 원 고정 자동차세 덕분에 목표 보유 기간 안에 초기 차액을 모두 회수하고 남습니다.';
        }

        // Breakeven cards
        const resHevGas = calcBreakeven(hevTco, gasTco, annualKm);
        const resEvGas = calcBreakeven(evTco, gasTco, annualKm);
        const resEvHev = calcBreakeven(evTco, hevTco, annualKm);

        function applyBeCard(
          mainEl: HTMLElement,
          subEl: HTMLElement,
          res: ReturnType<typeof calcBreakeven>,
          accentCls: string,
        ) {
          mainEl.textContent = res.main;
          if (res.isImmediate) {
            mainEl.className = `mt-1 text-base sm:text-lg font-extrabold ${accentCls}`;
          } else if (res.isNever) {
            mainEl.className = 'mt-1 text-base sm:text-lg font-extrabold text-muted-foreground';
          } else {
            mainEl.className = 'mt-1 text-base sm:text-lg font-extrabold text-foreground';
          }
          subEl.textContent = res.sub;
        }

        applyBeCard(beHevGas, beHevGasSub, resHevGas, 'text-blue-600 dark:text-blue-400');
        applyBeCard(beEvGas, beEvGasSub, resEvGas, 'text-emerald-600 dark:text-emerald-400');
        applyBeCard(beEvHev, beEvHevSub, resEvHev, 'text-emerald-600 dark:text-emerald-400');

        // SVG Line Chart rendering (viewBox 680 x 260)
        const padL = 62;
        const padR = 24;
        const padT = 20;
        const padB = 36;
        const plotW = 680 - padL - padR; // 594
        const plotH = 260 - padT - padB; // 204

        const allVals = [...gasTco, ...hevTco, ...evTco];
        const minV = Math.floor(Math.min(...allVals) / 500) * 500;
        const maxVRaw = Math.ceil(Math.max(...allVals) / 500) * 500;
        const maxV = maxVRaw <= minV ? minV + 1000 : maxVRaw;

        const xAt = (yr: number) => padL + (yr / 10) * plotW;
        const yAt = (val: number) => padT + plotH - ((val - minV) / (maxV - minV)) * plotH;

        // Gridlines (4 horizontal steps + X labels 0..10)
        let gridHtml = '';
        const yTicks = 4;
        for (let i = 0; i <= yTicks; i++) {
          const v = minV + ((maxV - minV) * i) / yTicks;
          const y = yAt(v).toFixed(1);
          const labelText = `${Math.round(v).toLocaleString()}만`;
          gridHtml += `<line x1="${padL}" y1="${y}" x2="${680 - padR}" y2="${y}" stroke="currentColor" stroke-opacity="0.1" stroke-width="1" />`;
          gridHtml += `<text x="${padL - 8}" y="${Number(y) + 4}" text-anchor="end" fill="currentColor" fill-opacity="0.6" font-size="11">${labelText}</text>`;
        }
        for (let yr = 0; yr <= 10; yr++) {
          const x = xAt(yr).toFixed(1);
          const isTarget = yr === targetYears;
          gridHtml += `<text x="${x}" y="${260 - 10}" text-anchor="middle" fill="currentColor" fill-opacity="${isTarget ? '1' : '0.65'}" font-weight="${isTarget ? '700' : '400'}" font-size="11">${yr}년</text>`;
        }
        svgGrid.innerHTML = gridHtml;

        const targetX = xAt(targetYears).toFixed(1);
        svgTargetLine.setAttribute('x1', targetX);
        svgTargetLine.setAttribute('x2', targetX);
        svgTargetLine.setAttribute('y1', String(padT));
        svgTargetLine.setAttribute('y2', String(padT + plotH));

        const buildPath = (arr: number[]) =>
          arr.map((v, yr) => `${yr === 0 ? 'M' : 'L'}${xAt(yr).toFixed(1)},${yAt(v).toFixed(1)}`).join(' ');

        svgPathGas.setAttribute('d', buildPath(gasTco));
        svgPathHev.setAttribute('d', buildPath(hevTco));
        svgPathEv.setAttribute('d', buildPath(evTco));

        const activeYr = hoveredYear !== null ? hoveredYear : targetYears;
        let ptsHtml = '';
        for (let yr = 0; yr <= 10; yr++) {
          const x = xAt(yr).toFixed(1);
          const r = yr === activeYr ? '5' : '3';
          ptsHtml += `<circle cx="${x}" cy="${yAt(gasTco[yr]).toFixed(1)}" r="${r}" fill="#f97316" />`;
          ptsHtml += `<circle cx="${x}" cy="${yAt(hevTco[yr]).toFixed(1)}" r="${r}" fill="#3b82f6" />`;
          ptsHtml += `<circle cx="${x}" cy="${yAt(evTco[yr]).toFixed(1)}" r="${r}" fill="#10b981" />`;
        }
        svgPoints.innerHTML = ptsHtml;

        let hitsHtml = '';
        const colW = plotW / 10;
        for (let yr = 0; yr <= 10; yr++) {
          const cx = xAt(yr);
          const rx = Math.max(padL, cx - colW / 2);
          const rw = yr === 0 || yr === 10 ? colW / 2 + 8 : colW;
          hitsHtml += `<rect data-yr="${yr}" x="${rx.toFixed(1)}" y="${padT}" width="${rw.toFixed(1)}" height="${plotH + 24}" fill="transparent" style="cursor:pointer;" />`;
        }
        svgHitareas.innerHTML = hitsHtml;

        svgHitareas.querySelectorAll<SVGRectElement>('rect[data-yr]').forEach((rect) => {
          const yr = parseInt(rect.dataset.yr || '0', 10);
          const activate = () => {
            hoveredYear = yr;
            const hx = xAt(yr).toFixed(1);
            svgHoverLine.setAttribute('x1', hx);
            svgHoverLine.setAttribute('x2', hx);
            svgHoverLine.setAttribute('y1', String(padT));
            svgHoverLine.setAttribute('y2', String(padT + plotH));
            svgHoverLine.classList.remove('hidden');
            svgPoints.querySelectorAll<SVGCircleElement>('circle').forEach((c, idx) => {
              const ptYr = Math.floor(idx / 3);
              c.setAttribute('r', ptYr === yr ? '5' : '3');
            });
            updateCaptionForYear(yr, annualKm);
          };
          rect.addEventListener('mouseenter', activate);
          rect.addEventListener('click', activate);
        });

        updateCaptionForYear(activeYr, annualKm);

        // Table rendering
        thTco.textContent = `${targetYears}년 누적 총비용`;
        const gasPerKm = Math.round(fuelPrice / gasEff);
        const hevPerKm = Math.round(fuelPrice / hevEff);
        const evPerKm = Math.round(blendedElecPrice / effectiveEvEff);

        const gasYr1Fixed = gasBaseTax + gasMaint;
        const hevYr1Fixed = hevBaseTax + hevMaint;
        const evYr1Fixed = evTax + evMaint;

        const rows = [
          {
            key: 'gas' as const,
            dot: '#f97316',
            label: isCustomEdited ? '가솔린' : `가솔린 (${p.gasName})`,
            init: gasInit,
            perKm: gasPerKm,
            yr1Fixed: gasYr1Fixed,
            tco: gasTco[targetYears],
            winRowCls: 'bg-orange-500/5',
            winTextCls: 'text-orange-600 dark:text-orange-400',
          },
          {
            key: 'hev' as const,
            dot: '#3b82f6',
            label: isCustomEdited ? '하이브리드' : `하이브리드 (${p.hevName})`,
            init: hevInit,
            perKm: hevPerKm,
            yr1Fixed: hevYr1Fixed,
            tco: hevTco[targetYears],
            winRowCls: 'bg-blue-500/5',
            winTextCls: 'text-blue-600 dark:text-blue-400',
          },
          {
            key: 'ev' as const,
            dot: '#10b981',
            label: isCustomEdited
              ? '전기차'
              : `전기차 (${isModelYActive ? MODEL_Y_SPEC.evName : p.evName})`,
            init: evInit,
            perKm: evPerKm,
            yr1Fixed: evYr1Fixed,
            tco: evTco[targetYears],
            winRowCls: 'bg-emerald-500/5',
            winTextCls: 'text-emerald-600 dark:text-emerald-400',
          },
        ];

        tbody.innerHTML = rows
          .map((r) => {
            const isWin = r.key === first.key;
            return `
              <tr class="${isWin ? r.winRowCls : ''}">
                <td class="px-3 py-2.5 font-semibold text-foreground">
                  <span class="inline-block h-2 w-2 rounded-full mr-1.5" style="background:${r.dot};"></span>${r.label}
                  ${isWin ? `<span class="ml-1 rounded bg-foreground/10 px-1.5 py-0.5 text-[10px] font-bold text-foreground">최저</span>` : ''}
                </td>
                <td class="px-3 py-2.5 text-right text-foreground">${fmtManwon(r.init)}</td>
                <td class="px-3 py-2.5 text-right text-muted-foreground">${r.perKm.toLocaleString()}원/km</td>
                <td class="px-3 py-2.5 text-right text-muted-foreground">${fmtManwon(r.yr1Fixed)}</td>
                <td class="px-3 py-2.5 text-right ${isWin ? `font-extrabold ${r.winTextCls}` : 'font-bold text-foreground'}">${fmtManwon(r.tco)}</td>
              </tr>
            `;
          })
          .join('');
      }

      function clearHover() {
        hoveredYear = null;
        svgHoverLine.classList.add('hidden');
      }

      // Event bindings
      segBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const seg = (btn.dataset.segment as SegmentKey) || 'midsize-suv';
          currentSegment = seg;
          isModelYActive = false;
          clearHover();
          loadPresetInputs(currentSegment, false);
          render();
        });
      });

      modelYBtn.addEventListener('click', () => {
        isModelYActive = !isModelYActive;
        clearHover();
        loadPresetInputs(currentSegment, isModelYActive);
        render();
      });

      resetCustomBtn.addEventListener('click', () => {
        clearHover();
        loadPresetInputs(currentSegment, isModelYActive);
        render();
      });

      [kmRange, yearsRange, homeRange, fuelRange].forEach((el) => {
        el.addEventListener('input', () => {
          clearHover();
          render();
        });
      });

      [winterChk, convChk].forEach((el) => {
        el.addEventListener('change', () => {
          clearHover();
          render();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.ev-km-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          clearHover();
          kmRange.value = chip.dataset.km || '15000';
          render();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.ev-years-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          clearHover();
          yearsRange.value = chip.dataset.years || '5';
          render();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.ev-home-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          clearHover();
          homeRange.value = chip.dataset.home || '80';
          render();
        });
      });

      root.querySelectorAll<HTMLButtonElement>('.ev-fuel-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          clearHover();
          fuelRange.value = chip.dataset.fuel || '1800';
          render();
        });
      });

      [
        inGasPrice,
        inGasEff,
        inGasCc,
        inGasMaint,
        inHevPrice,
        inHevEff,
        inHevCc,
        inHevMaint,
        inEvPrice,
        inEvSub,
        inEvEff,
        inEvMaint,
      ].forEach((inp) => {
        inp.addEventListener('input', () => {
          isCustomEdited = true;
          render();
        });
      });

      const svgEl = root.querySelector<SVGSVGElement>('.ev-svg-chart')!;
      svgEl.addEventListener('mouseleave', () => {
        hoveredYear = null;
        svgHoverLine.classList.add('hidden');
        const targetYears = Math.max(1, Math.min(10, parseInt(yearsRange.value, 10) || 5));
        const annualKm = Math.max(1000, parseInt(kmRange.value, 10) || 15000);
        svgPoints.querySelectorAll<SVGCircleElement>('circle').forEach((c, idx) => {
          const ptYr = Math.floor(idx / 3);
          c.setAttribute('r', ptYr === targetYears ? '5' : '3');
        });
        updateCaptionForYear(targetYears, annualKm);
      });

      loadPresetInputs(currentSegment, false);
      render();
    });
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initEvCalculators)
    : initEvCalculators();
</script>
