---
interface Props {
  type?: 'info' | 'tip' | 'success' | 'warning' | 'danger';
  title?: string;
}
const { type = 'info', title } = Astro.props;

const config = {
  info: {
    container: 'bg-sky-50 dark:bg-sky-950/30 border-sky-200 dark:border-sky-800 text-sky-900 dark:text-sky-100',
    iconClass: 'text-sky-500 dark:text-sky-400',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>`,
  },
  tip: {
    container: 'bg-indigo-50 dark:bg-indigo-950/30 border-indigo-200 dark:border-indigo-800 text-indigo-900 dark:text-indigo-100',
    iconClass: 'text-indigo-500 dark:text-indigo-400',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6M10 22h4"/></svg>`,
  },
  success: {
    container: 'bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-100',
    iconClass: 'text-emerald-500 dark:text-emerald-400',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>`,
  },
  warning: {
    container: 'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800 text-amber-900 dark:text-amber-100',
    iconClass: 'text-amber-500 dark:text-amber-400',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4M12 17h.01"/></svg>`,
  },
  danger: {
    container: 'bg-red-50 dark:bg-red-950/30 border-red-200 dark:border-red-800 text-red-900 dark:text-red-100',
    iconClass: 'text-red-500 dark:text-red-400',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>`,
  },
} as const;

const { container, icon, iconClass } = config[type];
---

<div class:list={['not-prose my-6 rounded-lg border p-4 text-sm leading-relaxed', container]}>
  <div class="flex items-start gap-3">
    <span class:list={['mt-0.5 shrink-0', iconClass]}>
      <Fragment set:html={icon} />
    </span>
    <div class="min-w-0 flex-1">
      {title && <p class="font-semibold mb-1.5">{title}</p>}
      <div class="[&>p]:mb-2 [&>p:last-child]:mb-0 [&_a]:underline [&_a]:underline-offset-4 [&_a]:font-semibold [&_a]:decoration-2 hover:[&_a]:opacity-75">
        <slot />
      </div>
    </div>
  </div>
</div>
