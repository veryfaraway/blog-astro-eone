---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'danger' | 'tip';
  title?: string;
}
const { type = 'info', title } = Astro.props;

const style = {
  info:    'bg-blue-50  dark:bg-blue-950/30  border-blue-300  dark:border-blue-700  text-blue-900  dark:text-blue-100',
  warning: 'bg-amber-50 dark:bg-amber-950/30 border-amber-300 dark:border-amber-700 text-amber-900 dark:text-amber-100',
  success: 'bg-green-50 dark:bg-green-950/30 border-green-300 dark:border-green-700 text-green-900 dark:text-green-100',
  danger:  'bg-red-50   dark:bg-red-950/30   border-red-300   dark:border-red-700   text-red-900   dark:text-red-100',
  tip:     'bg-violet-50 dark:bg-violet-950/30 border-violet-300 dark:border-violet-700 text-violet-900 dark:text-violet-100',
}[type];

const icon = { info: '💡', warning: '⚠️', success: '✅', danger: '🚨', tip: '💡' }[type];
---

<div class:list={['not-prose my-6 rounded-lg border p-4 text-sm leading-relaxed', style]}>
  {title && <p class="font-semibold mb-2">{icon} {title}</p>}
  <div class="[&>p]:mb-2 [&>p:last-child]:mb-0">
    <slot />
  </div>
</div>
