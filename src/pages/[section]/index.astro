---
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import PostCard from '../../components/PostCard.astro';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';

export async function getStaticPaths() {
  const sections: Section[] = ['life', 'money', 'culture', 'tools', 'dev'];
  return sections.map(section => ({ params: { section } }));
}

const { section } = Astro.params as { section: Section };

const sectionMeta: Record<Section, { label: string; description: string }> = {
  life:    { label: 'Life',    description: '일상 · 종교 · 육아 · 자동차 · 아쿠아리움' },
  money:   { label: 'Money',   description: '경제 · 투자 · 절약 · 제품 리뷰' },
  culture: { label: 'Culture', description: '영화 · 영어 · 여행' },
  tools:   { label: 'Tools',   description: 'macOS · 터미널 · 개발 환경 도구' },
  dev:     { label: 'Dev',     description: '개발 · AI · Backend · Frontend · DevOps' },
};

const allPosts = await getCollection(section, (entry) =>
  entry.id.startsWith('ko/') && !entry.data.draft
);

const posts = allPosts.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);

// glob loader는 id에서 확장자를 제거함 (ko/post-slug)
const toSlug = (id: string) => id.replace(/^ko\//, '').replace(/\.(md|mdx)$/, '');

const categories = ['전체', ...new Set(posts.map(p => p.data.category))];
const { label, description } = sectionMeta[section];
---

<SectionLayout
  title={`${label} — eone blog`}
  description={description}
  section={section}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14">

    <!-- Section header (newmixcoffee style) -->
    <div class="py-12 border-b border-border">
      <h1 class="text-3xl font-bold tracking-tight text-foreground mb-2">{label}</h1>
      <p class="text-sm text-muted-foreground">{description}</p>
    </div>

    <!-- Category tabs -->
    <div class="border-b border-border">
      <div class="flex gap-0 overflow-x-auto scrollbar-none">
        {categories.map((cat, i) => (
          <a
            href={i === 0 ? `/${section}` : `/${section}?category=${encodeURIComponent(cat)}`}
            class="relative shrink-0 px-4 py-3 text-base font-medium transition-colors text-muted-foreground hover:text-foreground"
          >
            {cat}
          </a>
        ))}
      </div>
    </div>

    <!-- Post grid -->
    <div class="py-10">
      {posts.length === 0 ? (
        <p class="text-sm text-muted-foreground py-12 text-center">아직 글이 없습니다.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => {
            const slug = toSlug(post.id);
            return (
              <div data-section={section}>
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  slug={slug}
                  section={section}
                  tags={post.data.tags}
                  thumbnail={post.data.thumbnail}
                />
              </div>
            );
          })}
        </div>
      )}
    </div>

  </div>
</SectionLayout>
