---
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import SectionTabs from '../../components/SectionTabs';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';

export async function getStaticPaths() {
  const sections: Section[] = ['life', 'money', 'culture', 'tools', 'dev'];
  return sections.map(section => ({ params: { section } }));
}

const { section } = Astro.params as { section: Section };

const sectionMeta: Record<Section, { label: string; description: string }> = {
  life:    { label: 'Life',    description: '일상 · 종교 · 육아 · 자동차 · 아쿠아리움' },
  money:   { label: 'Money',   description: '경제 · 투자 · 절약 · 제품 리뷰' },
  culture: { label: 'Culture', description: '영화 · 영어 · 여행' },
  tools:   { label: 'Tools',   description: 'macOS · 터미널 · 개발 환경 도구' },
  dev:     { label: 'Dev',     description: '개발 · AI · Backend · Frontend · DevOps' },
};

const allPosts = await getCollection(section, (entry) =>
  entry.id.startsWith('ko/') && !entry.data.draft
);

const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    slug: post.id.replace(/^ko\//, '').replace(/\.(md|mdx)$/, ''),
    section,
    tags: post.data.tags,
    thumbnail: post.data.thumbnail,
    category: post.data.category,
  }));

const { label, description } = sectionMeta[section];
---

<SectionLayout
  title={`${label} — eone blog`}
  description={description}
  section={section}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14">

    <!-- Section header -->
    <div class="py-12 border-b border-border">
      <h1 class="text-3xl font-bold tracking-tight text-foreground mb-2">{label}</h1>
      <p class="text-sm text-muted-foreground">{description}</p>
    </div>

    <!-- SectionTabs: 카테고리 필터 + 클라이언트 페이지네이션 -->
    <SectionTabs client:load posts={posts} section={section} />

  </div>
</SectionLayout>
