---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';

export async function getStaticPaths() {
  const sections: Section[] = ['life', 'money', 'culture', 'tools', 'dev'];
  const paths = await Promise.all(
    sections.map(async (section) => {
      const posts = await getCollection(section, (entry) =>
        entry.id.startsWith('ko/') && !entry.data.draft
      );
      return posts.map(post => ({
        params: {
          section,
          slug: post.id.replace(/^ko\//, '').replace(/\.(md|mdx)$/, ''),
        },
        props: { post, section },
      }));
    })
  );
  return paths.flat();
}

const { post, section } = Astro.props as {
  post: Awaited<ReturnType<typeof getCollection>>[number];
  section: Section;
};

const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  section={section}
  category={post.data.category}
  tags={post.data.tags}
  thumbnail={post.data.thumbnail}
  lang="ko"
>
  <Content />
</PostLayout>
