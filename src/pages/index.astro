---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';
const SECTIONS: Section[] = ['life', 'money', 'culture', 'tools', 'dev'];

const allPosts = (await Promise.all(
  SECTIONS.map(async (section) => {
    const posts = await getCollection(section, e => e.id.startsWith('ko/') && !e.data.draft);
    return posts.map(post => ({
      title: post.data.title,
      description: post.data.description,
      date: post.data.date,
      slug: post.id.replace(/\.(md|mdx)$/, '').split('/').pop()!,
      section,
      tags: post.data.tags,
      thumbnail: post.data.thumbnail,
    }));
  })
)).flat().sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const latestPosts = allPosts.slice(0, 9);

const sectionButtons: { section: Section; label: string; color: string }[] = [
  { section: 'life',    label: 'Life',    color: 'oklch(0.72 0.18 145)' },
  { section: 'money',  label: 'Money',   color: 'oklch(0.80 0.18 86)' },
  { section: 'culture',label: 'Culture', color: 'oklch(0.63 0.27 303)' },
  { section: 'tools',  label: 'Tools',   color: 'oklch(0.56 0.024 265)' },
  { section: 'dev',    label: 'Dev',     color: 'oklch(0.72 0.14 215)' },
];
---

<BaseLayout title="일취월장" description="일상, 경제, 문화, 개발, 도구에 관한 이야기">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14">

    <!-- Hero -->
    <div class="py-12">
      <h1 class="font-heading text-6xl font-bold tracking-tight text-foreground mb-2">일취월장</h1>
      <p class="text-sm text-muted-foreground mb-6">
        일과 취미에 월등한 장인 블로그입니다.
      </p>

      <!-- Section badge buttons -->
      <div class="flex flex-wrap gap-2">
        {sectionButtons.map(({ section, label, color }) => (
          <a
            href={`/${section}`}
            style={`color: ${color}; border-color: ${color};`}
            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border bg-transparent hover:opacity-80 transition-opacity"
          >
            {label}
          </a>
        ))}
      </div>
    </div>

    <div class="border-b border-border" />

    <!-- Latest posts grid -->
    <div class="py-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map(post => (
          <div data-section={post.section}>
            <PostCard
              title={post.title}
              description={post.description}
              date={post.date}
              slug={post.slug}
              section={post.section}
              tags={post.tags}
              thumbnail={post.thumbnail}
            />
          </div>
        ))}
      </div>

      <!-- 더보기 버튼 -->
      <div class="mt-12 flex justify-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-md border border-border text-sm font-medium text-muted-foreground hover:text-foreground hover:border-foreground/30 transition-colors"
        >
          모든 글 보기
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
