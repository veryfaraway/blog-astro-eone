---
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { readingTime } from '../../../lib/utils';
import { getLocalizedPath } from '../../../lib/i18n';
import { getRelatedPosts, toRelatedCandidate, type RelatedCandidate } from '../../../lib/related';
import { SECTIONS, getSectionPosts, getPostSlug, type Section, type PostEntry } from '../../../lib/content';

export async function getStaticPaths() {
  const bySection = await Promise.all(
    SECTIONS.map(async (section) => {
      const enPosts = await getSectionPosts(section, { lang: 'en' });
      const koPosts = await getSectionPosts(section, { lang: 'ko' });
      return { section, enPosts, koPosts };
    })
  );

  // English candidates only — a related link must not drop the reader into a
  // language they were not reading.
  const pool = bySection.flatMap(({ section, enPosts }) =>
    enPosts.map((post) => toRelatedCandidate(post, section))
  );

  return bySection.flatMap(({ section, enPosts, koPosts }) => {
    const koSlugs = new Set(koPosts.map((p) => getPostSlug(p.id)));

    return enPosts.map((post, index) => {
      const slug = getPostSlug(post.id);
      const alternateUrl = koSlugs.has(slug) ? getLocalizedPath('ko', `${section}/${slug}`) : undefined;
      return {
        params: { section, slug },
        props: {
          post,
          section,
          alternateUrl,
          prevPost: enPosts[index + 1] ?? null,
          nextPost: enPosts[index - 1] ?? null,
          relatedPosts: getRelatedPosts(toRelatedCandidate(post, section), pool),
        },
      };
    });
  });
}

const { post, section, alternateUrl, prevPost, nextPost, relatedPosts } = Astro.props as {
  post: PostEntry;
  section: Section;
  alternateUrl?: string;
  prevPost: PostEntry | null;
  nextPost: PostEntry | null;
  relatedPosts: RelatedCandidate[];
};

const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  section={section}
  category={post.data.category}
  tags={post.data.tags}
  thumbnail={post.data.thumbnail}
  affiliate={post.data.affiliate}
  lang="en"
  alternateUrl={alternateUrl}
  readingTime={minutes}
  headings={headings}
  relatedPosts={relatedPosts}
  draft={post.data.draft}
  prevPost={prevPost ? { title: prevPost.data.title, slug: getPostSlug(prevPost.id), section } : undefined}
  nextPost={nextPost ? { title: nextPost.data.title, slug: getPostSlug(nextPost.id), section } : undefined}
>
  <Content />
</PostLayout>
