---
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

type Section = 'life' | 'money' | 'culture' | 'tools' | 'dev';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const SECTIONS: Section[] = ['life', 'money', 'culture', 'tools', 'dev'];
  const allPosts = (await Promise.all(
    SECTIONS.map(async (section) => {
      const posts = await getCollection(section, e => e.id.startsWith('ko/') && !e.data.draft);
      return posts.map(post => ({
        title: post.data.title,
        description: post.data.description,
        date: post.data.date,
        slug: post.id.replace(/^ko\//, '').replace(/\.(md|mdx)$/, ''),
        section: section as Section,
        tags: post.data.tags,
        thumbnail: post.data.thumbnail,
      }));
    })
  )).flat().sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

  return paginate(allPosts, { pageSize: 12 });
}

const { page } = Astro.props;
const posts = page.data;

// 페이지네이션 UI 계산
const totalPages = page.lastPage;
const currentPage = page.currentPage;

function getPageUrl(n: number) {
  return n === 1 ? '/blog' : `/blog/${n}`;
}

// 표시할 페이지 번호 범위: 현재 ±2
const pageNumbers: (number | '...')[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
} else {
  const left = Math.max(1, currentPage - 2);
  const right = Math.min(totalPages, currentPage + 2);
  if (left > 1) { pageNumbers.push(1); if (left > 2) pageNumbers.push('...'); }
  for (let i = left; i <= right; i++) pageNumbers.push(i);
  if (right < totalPages) { if (right < totalPages - 1) pageNumbers.push('...'); pageNumbers.push(totalPages); }
}
---

<BaseLayout title="블로그 — eone blog" description="전체 포스트 모음">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14">

    <!-- Page header -->
    <div class="py-12 border-b border-border">
      <h1 class="text-3xl font-bold tracking-tight text-foreground mb-2">블로그</h1>
      <p class="text-sm text-muted-foreground">
        전체 {page.total}개의 글
        {totalPages > 1 && <span class="ml-1">· {currentPage} / {totalPages} 페이지</span>}
      </p>
    </div>

    <!-- Post grid -->
    <div class="py-10">
      {posts.length === 0 ? (
        <p class="text-sm text-muted-foreground py-12 text-center">아직 글이 없습니다.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <div data-section={post.section}>
              <PostCard
                title={post.title}
                description={post.description}
                date={post.date}
                slug={post.slug}
                section={post.section}
                tags={post.tags}
                thumbnail={post.thumbnail}
              />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="flex items-center justify-center gap-1 pb-16" aria-label="페이지네이션">
        <!-- 이전 -->
        {page.url.prev ? (
          <a
            href={page.url.prev}
            class="px-3 py-1.5 rounded-md text-sm text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
          >
            ← 이전
          </a>
        ) : (
          <span class="px-3 py-1.5 rounded-md text-sm text-muted-foreground/40 cursor-not-allowed">
            ← 이전
          </span>
        )}

        <!-- 페이지 번호 -->
        {pageNumbers.map((n) =>
          n === '...' ? (
            <span class="px-2 py-1.5 text-sm text-muted-foreground/60">…</span>
          ) : (
            <a
              href={getPageUrl(n as number)}
              class:list={[
                'px-3 py-1.5 rounded-md text-sm transition-colors',
                n === currentPage
                  ? 'bg-foreground text-background font-semibold'
                  : 'text-muted-foreground hover:text-foreground hover:bg-muted/60',
              ]}
              aria-current={n === currentPage ? 'page' : undefined}
            >
              {n}
            </a>
          )
        )}

        <!-- 다음 -->
        {page.url.next ? (
          <a
            href={page.url.next}
            class="px-3 py-1.5 rounded-md text-sm text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
          >
            다음 →
          </a>
        ) : (
          <span class="px-3 py-1.5 rounded-md text-sm text-muted-foreground/40 cursor-not-allowed">
            다음 →
          </span>
        )}
      </nav>
    )}

  </div>
</BaseLayout>
