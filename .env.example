# Site
PUBLIC_SITE_URL=https://blog.eone.one

# Google Analytics
PUBLIC_GA_ID=G-XXXXXXXXXX

# Giscus (댓글 시스템)
PUBLIC_GISCUS_REPO=username/repo-name
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=

# Google Search Console 인증
PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 인증
PUBLIC_NAVER_SITE_VERIFICATION=

# AdSense
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX
# 광고 슬롯 ID (AdSense 대시보드에서 슬롯별로 발급)
PUBLIC_ADSENSE_SLOT_INARTICLE=
PUBLIC_ADSENSE_SLOT_DISPLAY=

# FMP API (GitHub Actions에서만 사용 - 로컬 .env에 넣지 말 것)
FMP_API_KEY=
