# Site
PUBLIC_SITE_URL=https://blog.eone.one

# Google Analytics
PUBLIC_GA_ID=G-XXXXXXXXXX

# Giscus (댓글 시스템)
PUBLIC_GISCUS_REPO=username/repo-name
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=

# Google Search Console 인증
PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 인증
PUBLIC_NAVER_SITE_VERIFICATION=

# AdSense
# 셋 다 비어 있으면 광고 마크업 자체가 렌더링되지 않는다.
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX
# 광고 슬롯 ID (AdSense 대시보드에서 슬롯별로 발급)
# INARTICLE: 본문 중간(rehype 자동 삽입) + 댓글 위. "기사 내 광고" 유형으로 생성.
PUBLIC_ADSENSE_SLOT_INARTICLE=
# DISPLAY: 본문 시작 전. "디스플레이 광고" 유형으로 생성.
PUBLIC_ADSENSE_SLOT_DISPLAY=

# OMDb API (MovieCard 컴포넌트 — 영화 정보 fetch)
# 발급: https://www.omdbapi.com/apikey.aspx (무료 플랜: 1,000 req/day)
# 빌드 타임에만 사용되므로 Netlify 빌드 환경변수에도 등록 필요
PUBLIC_OMDB_API_KEY=

# TMDb API (PersonCard 컴포넌트 — 인물 프로필 사진 fetch)
# 발급: https://www.themoviedb.org/settings/api (무료)
# imdbId 기반으로 빌드 타임에 프로필 사진 자동 fetch. Netlify 빌드 환경변수에도 등록 필요.
TMDB_API_KEY=

# 카카오 책 검색 REST API Key (BookCard 컴포넌트 — 국내 도서 표지·저자·가격 자동 조회)
# 발급: https://developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키 (심사 없이 즉시 발급, 일 30,000건 무료)
# 미설정 시에도 Google Books 무인증 폴백 및 수동 Props로 안전하게 동작함. Netlify 빌드 환경변수에도 등록 권장.
KAKAO_REST_API_KEY=

# GitHub Personal Access Token (선택 — GitHubRepoCard 빌드 타임 API 호출 한도 확장: 60 -> 5,000 req/hr)
# 별도 권한(scope) 없는 Fine-grained / Classic public read 토큰이면 충분하며, 미설정 시에도 소량 조회 가능
GITHUB_TOKEN=

# 쿠팡파트너스 Open API (CoupangProductCard 컴포넌트 — 상품 정보 fetch)
# 발급: 쿠팡파트너스(partners.coupang.com) 로그인 > Open API 메뉴에서 Access Key/Secret Key 발급
# 주의: 누적 판매액이 일정 금액을 넘어야 API가 활성화됨 (파트너스 정책 참고)
# HMAC-SHA256 서명 인증이라 Secret Key는 절대 노출되면 안 됨 — PUBLIC_ 접두사 사용 금지
# 빌드 타임에만 사용되므로 Netlify 빌드 환경변수에도 등록 필요
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Cloudinary (CloudinaryImage 컴포넌트 — 반응형 이미지)
# Cloudinary 대시보드 > Settings > Account > Cloud name
PUBLIC_CLOUDINARY_CLOUD_NAME=

# FMP API (GitHub Actions에서만 사용 - 로컬 .env에 넣지 말 것)
FMP_API_KEY=
