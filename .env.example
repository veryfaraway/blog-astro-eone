# Site
PUBLIC_SITE_URL=https://blog.eone.one

# Google Analytics
PUBLIC_GA_ID=G-XXXXXXXXXX

# Giscus (댓글 시스템)
PUBLIC_GISCUS_REPO=username/repo-name
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=

# Google Search Console 인증
PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 인증
PUBLIC_NAVER_SITE_VERIFICATION=

# AdSense
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX
# 광고 슬롯 ID (AdSense 대시보드에서 슬롯별로 발급)
PUBLIC_ADSENSE_SLOT_INARTICLE=
PUBLIC_ADSENSE_SLOT_DISPLAY=

# OMDb API (MovieCard 컴포넌트 — 영화 정보 fetch)
# 발급: https://www.omdbapi.com/apikey.aspx (무료 플랜: 1,000 req/day)
# 빌드 타임에만 사용되므로 Netlify 빌드 환경변수에도 등록 필요
PUBLIC_OMDB_API_KEY=

# TMDb API (PersonCard 컴포넌트 — 인물 프로필 사진 fetch)
# 발급: https://www.themoviedb.org/settings/api (무료)
# imdbId 기반으로 빌드 타임에 프로필 사진 자동 fetch. Netlify 빌드 환경변수에도 등록 필요.
TMDB_API_KEY=

# Cloudinary (CloudinaryImage 컴포넌트 — 반응형 이미지)
# Cloudinary 대시보드 > Settings > Account > Cloud name
PUBLIC_CLOUDINARY_CLOUD_NAME=

# FMP API (GitHub Actions에서만 사용 - 로컬 .env에 넣지 말 것)
FMP_API_KEY=
